@import "../../styles/admin.wxss";
.organization-page { padding-top: 24rpx; }.organization-head { min-height: 142rpx; display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 25rpx; border-bottom: 1rpx solid #d6e2e5; }.organization-head text,.organization-head strong,.organization-head small { display: block; }.organization-head view:first-child > text { color: #0f7a6a; font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }.organization-head view:first-child > strong { margin-top: 7rpx; color: #173d4d; font-size: 42rpx; }.organization-head small { margin-top: 8rpx; color: #748791; font-size: 19rpx; }.org-total { width: 92rpx; height: 84rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #116f63; background: #e2f1ee; border-radius: 16rpx; }.org-total strong { font: 900 31rpx/1 "DIN Alternate",monospace; }.org-total text { margin-top: 8rpx; font-size: 16rpx; }
.organization-list { display: flex; flex-direction: column; gap: 15rpx; }.organization-card { min-height: 142rpx; padding: 22rpx; display: grid; grid-template-columns: 68rpx minmax(0,1fr) 20rpx; gap: 17rpx; align-items: center; }.organization-symbol { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #116f63; border-radius: 18rpx; font-size: 24rpx; font-weight: 900; }.organization-main { min-width: 0; }.organization-main > view { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.organization-main strong { overflow: hidden; color: #1d4554; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }.organization-main > text,.organization-main small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.organization-main > text { margin-top: 8rpx; color: #667b86; font-size: 18rpx; }.organization-main small { margin-top: 9rpx; color: #8d9ba1; font-size: 16rpx; }.organization-arrow { color: #92a4aa; font-size: 34rpx; }.retry { width: 210rpx; min-height: 70rpx; margin: 20rpx auto 0; font-size: 21rpx; }
