<view class="page-shell profile-page {{isAdmin ? 'profile-page--admin' : ''}}">
  <view class="profile-hero"><view class="profile-grid"></view><view class="avatar">{{initial}}</view><view class="profile-main"><view class="profile-name">{{session.user.displayName}}</view><view class="profile-account">@{{session.user.username}}</view><view class="role-tag">{{roleName}}</view></view><view class="online-mark"><view class="online-dot"></view>在线</view></view>

  <block wx:if="{{isAdmin}}">
    <view class="org-panel admin-identity card"><view class="org-symbol">中</view><view class="org-copy"><text>当前身份域</text><strong>供应链中台</strong><code>INTERNAL CONTROL</code></view><view class="org-lock">✓</view></view>
    <view class="safe-banner admin-safe"><view class="safe-banner__icon">✓</view><view><view class="safe-banner__title">中台权限实时校验</view><view class="safe-banner__copy">可跨组织监管和审批，但不能代替伙伴接单、反馈进度或提交交付结果。</view></view></view>
    <view class="scope-panel card"><view class="scope-head"><view><text class="eyebrow">MOBILE SCOPE</text><strong>移动端能力边界</strong></view><text>4 项</text></view><view wx:for="{{adminCapabilities}}" wx:key="key" class="scope-row admin-capability"><view class="scope-dot {{item.enabled ? 'is-enabled' : 'is-disabled'}}"></view><view><strong>{{item.label}}</strong><text>{{item.note}}</text></view><text>{{item.enabled ? '已开放' : '未开放'}}</text></view></view>
    <view class="menu-group card"><view class="menu-item" data-key="organizations" data-title="伙伴组织" bindtap="menuTap"><view class="menu-icon">组</view><view><text>伙伴组织</text><small>查看组织与成员状态</small></view><text class="menu-arrow">›</text></view><view class="menu-item" data-key="security" data-title="会话安全" bindtap="menuTap"><view class="menu-icon">盾</view><view><text>会话安全</text><small>短时令牌、权限复核与操作留痕</small></view><text class="menu-arrow">›</text></view></view>
  </block>

  <block wx:else>
    <view class="org-panel card"><view class="org-symbol">{{profile.symbol}}</view><view class="org-copy"><text>{{profile.name}}</text><strong>{{session.organization.name}}</strong><code>{{session.organization.code}}</code></view><view class="org-lock">✓</view></view>
    <view class="safe-banner"><view class="safe-banner__icon">✓</view><view><view class="safe-banner__title">数据边界已锁定</view><view class="safe-banner__copy">{{profile.boundaryCopy}} 所有操作均留痕。</view></view></view>
    <view class="scope-panel card"><view class="scope-head"><view><text class="eyebrow">ACCESS SCOPE</text><strong>已授权业务范围</strong></view><text>{{resources.length}} 项</text></view><view wx:for="{{resources}}" wx:key="ref" class="scope-row"><view class="scope-dot"></view><view><strong>{{item.name}}</strong><text>{{item.ref}}</text></view><text>{{item.permissions.length}} 项能力</text></view></view>
    <view class="menu-group card"><view class="menu-item" data-key="organization" data-title="我的组织" bindtap="menuTap"><view class="menu-icon">组</view><view><text>我的组织</text><small>查看组织与授权范围</small></view><text class="menu-arrow">›</text></view><view wx:if="{{session.membership.role === 'organization_admin'}}" class="menu-item" data-key="members" data-title="成员管理" bindtap="menuTap"><view class="menu-icon">员</view><view><text>成员管理</text><small>账号、岗位与成员状态</small></view><text class="menu-arrow">›</text></view><view class="menu-item" data-key="security" data-title="账号与安全" bindtap="menuTap"><view class="menu-icon">盾</view><view><text>账号与安全</text><small>密码与登录设备</small></view><text class="menu-arrow">›</text></view></view>
  </block>

  <button class="secondary-button switch-mode-button" bindtap="switchMode">{{isAdmin ? '切换到伙伴登录' : '切换到中台登录'}}</button>
  <view class="menu-group card"><view class="menu-item" data-key="help" data-title="使用帮助" bindtap="menuTap"><view class="menu-icon">?</view><view><text>使用帮助</text><small>作业流程与常见问题</small></view><text class="menu-arrow">›</text></view><view class="menu-item" data-key="feedback" data-title="意见反馈" bindtap="menuTap"><view class="menu-icon">言</view><view><text>意见反馈</text><small>告诉我们你的建议</small></view><text class="menu-arrow">›</text></view></view>
  <button class="danger-button logout-button" bindtap="logout">退出登录</button>
  <view class="version">同舟协同小程序 · {{demoMode ? 'DEMO' : 'PRODUCTION'}}</view>
  <tz-tab-bar active="profile" mode="{{mode}}" unread="{{unread}}" />
</view>
