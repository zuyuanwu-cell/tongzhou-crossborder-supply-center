<view class="profile-page hd-page {{isAdmin ? 'profile-page--admin' : ''}}">
  <view class="hd-bg"><view class="hd-blob hd-blob--blue pf-blob-blue"></view><view class="hd-blob hd-blob--orange pf-blob-orange"></view><view class="hd-blob hd-blob--cyan pf-blob-cyan"></view></view>

  <view class="hd-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="hd-nav__bar hd-nav__bar--center" style="height: {{navHeight}}px"><text class="hd-nav__center">我的</text></view>
  </view>

  <scroll-view class="pf-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="pf-content" style="padding-top: {{statusBarHeight + navHeight + 14}}px">
      <view class="pf-identity">
        <view class="pf-avatar" bindtap="chooseAvatar"><view class="pf-avatar__ring"></view><view class="pf-avatar__face"><image wx:if="{{avatarUrl}}" class="pf-avatar__image" src="{{avatarUrl}}" mode="aspectFill" binderror="resetAvatar"/><text wx:else class="pf-avatar__letter">{{initial}}</text></view><view class="pf-avatar__badge"><view class="pf-camera"><view class="pf-camera__lens"></view></view></view></view>
        <view class="pf-identity__main">
          <text class="pf-identity__name">{{session.user.displayName}}</text>
          <text class="hd-mono pf-identity__handle">@{{session.user.username}}</text>
          <view class="pf-role-row"><text class="pf-role">{{roleName}}</text><text wx:if="{{avatarUrl}}" class="pf-avatar-reset" catchtap="resetAvatar">恢复默认头像</text></view>
        </view>
        <view class="pf-online"><text class="hd-dot"></text>在线</view>
      </view>

      <view class="hd-glass pf-org">
        <view class="pf-org__tile">{{isAdmin ? '中' : profile.symbol}}</view>
        <view class="pf-org__main">
          <text class="pf-org__kicker">{{isAdmin ? '供应链中台 · 当前身份域' : (profile.name || '协同组织') + ' · 当前组织'}}</text>
          <text class="pf-org__name">{{isAdmin ? '同舟供应链中心' : session.organization.name}}</text>
          <text class="hd-mono pf-org__code">{{isAdmin ? 'INTERNAL CONTROL' : session.organization.code}}</text>
        </view>
        <view class="pf-verified">✓ 已验证</view>
      </view>

      <view wx:if="{{!isAdmin}}" class="pf-card pf-card--hermes">
        <view class="pf-hermes-head"><view class="hd-orb-mini pf-orb"><view class="hd-orb-mini__core"><view class="hd-bot-mini"><view class="hd-bot-mini__visor"><view class="hd-bot-mini__eye"></view><view class="hd-bot-mini__eye"></view></view></view></view></view><view class="pf-hermes-head__copy"><text class="pf-card__title">同舟小助理偏好</text><text class="pf-card__sub">只读写本组织授权范围内的数据</text></view></view>
        <view class="pf-pref pf-pref--first">
          <view class="pf-pref__copy"><text class="pf-pref__title">语音优先输入</text><text class="pf-pref__sub">快捷汇报默认突出“语音”入口</text></view>
          <view class="pf-toggle {{assistantPreferences.voiceFirst ? 'is-on' : ''}}" data-key="voiceFirst" bindtap="togglePreference"><view class="pf-toggle__knob"></view></view>
        </view>
        <view class="pf-pref">
          <view class="pf-pref__copy"><text class="pf-pref__title">交期到期提醒</text><text class="pf-pref__sub">首页优先展示临期和逾期订单</text></view>
          <view class="pf-toggle {{assistantPreferences.dueReminder ? 'is-on' : ''}}" data-key="dueReminder" bindtap="togglePreference"><view class="pf-toggle__knob"></view></view>
        </view>
      </view>

      <view class="pf-card">
        <view class="pf-scope-head">
          <view class="pf-scope-head__copy"><text class="hd-mono hd-kicker hd-kicker--orange">{{isAdmin ? 'MOBILE SCOPE' : 'ACCESS SCOPE'}}</text><text class="pf-card__title">{{isAdmin ? '移动端能力边界' : '已授权业务范围'}}</text></view>
          <text class="pf-lock">🔒 数据边界已锁定</text>
        </view>
        <block wx:if="{{isAdmin}}">
          <view wx:for="{{adminCapabilities}}" wx:key="key" class="pf-scope-row"><text class="pf-scope-dot {{item.enabled ? 'pf-scope-dot--green' : 'pf-scope-dot--off'}}"></text><view class="pf-scope-row__copy"><text class="pf-scope-row__label">{{item.label}}</text><text class="pf-scope-row__note">{{item.note}}</text></view><text class="hd-mono pf-scope-row__meta">{{item.enabled ? '已开放' : '未开放'}}</text></view>
        </block>
        <block wx:else>
          <view wx:for="{{accessScopes}}" wx:key="capability" class="pf-scope-row"><text class="pf-scope-dot pf-scope-dot--{{item.tone}}"></text><view class="pf-scope-row__copy"><text class="pf-scope-row__label">{{item.label}}</text><text class="pf-scope-row__note">{{item.note}}</text></view><text class="hd-mono pf-scope-row__meta">{{item.count ? item.count + ' 项能力 ›' : '已授权'}}</text></view>
          <view wx:if="{{!accessScopes.length}}" class="pf-scope-empty">当前账号仅保留基础查看权限</view>
        </block>
        <text class="pf-scope-foot">{{isAdmin ? '移动端只开放查看与审批，代伙伴操作在第一版中明确关闭。' : '仅展示本组织获授权的业务，小助理代填、修改与提交均留痕。'}}</text>
      </view>

      <view class="pf-card pf-menu">
        <view wx:if="{{!isAdmin}}" class="pf-menu-row" data-key="organization" data-title="我的组织" bindtap="menuTap"><text class="pf-menu-icon">组</text><view class="pf-menu-row__copy"><text class="pf-menu-row__title">我的组织</text><text class="pf-menu-row__sub">组织信息与授权范围</text></view><text class="pf-chevron">›</text></view>
        <view wx:if="{{!isAdmin && session.membership.role === 'organization_admin'}}" class="pf-menu-row" data-key="members" data-title="成员管理" bindtap="menuTap"><text class="pf-menu-icon">员</text><view class="pf-menu-row__copy"><text class="pf-menu-row__title">成员管理</text><text class="pf-menu-row__sub">邀请成员、分配可填报业务</text></view><text class="pf-chevron">›</text></view>
        <view wx:if="{{isAdmin}}" class="pf-menu-row" data-key="organizations" data-title="伙伴组织" bindtap="menuTap"><text class="pf-menu-icon">组</text><view class="pf-menu-row__copy"><text class="pf-menu-row__title">伙伴组织</text><text class="pf-menu-row__sub">查看组织与成员状态</text></view><text class="pf-chevron">›</text></view>
        <view class="pf-menu-row" data-key="audit" data-title="操作留痕" bindtap="menuTap"><text class="pf-menu-icon">痕</text><view class="pf-menu-row__copy"><text class="pf-menu-row__title">操作留痕</text><text class="pf-menu-row__sub">含小助理代填记录</text></view><text class="pf-chevron">›</text></view>
        <view class="pf-menu-row" data-key="security" data-title="账号与安全" bindtap="menuTap"><text class="pf-menu-icon">盾</text><view class="pf-menu-row__copy"><text class="pf-menu-row__title">账号与安全</text><text class="pf-menu-row__sub">密码、登录设备与会话保护</text></view><text class="pf-chevron">›</text></view>
        <view class="pf-menu-row" data-key="help" data-title="帮助与反馈" bindtap="menuTap"><text class="pf-menu-icon">?</text><view class="pf-menu-row__copy"><text class="pf-menu-row__title">帮助与反馈</text></view><text class="pf-chevron">›</text></view>
      </view>

      <view class="pf-logout" bindtap="logout">退出登录</view>
      <view class="pf-switch" bindtap="switchMode">{{isAdmin ? '切换到伙伴登录' : '切换到中台登录'}} ›</view>
      <text class="hd-mono pf-version">同舟协同 · 小助理 V2 · {{demoMode ? 'DEMO' : 'PRODUCTION'}}</text>
    </view>
  </scroll-view>
  <tz-tab-bar active="profile" mode="{{mode}}" unread="{{unread}}" theme="glass" />
</view>
