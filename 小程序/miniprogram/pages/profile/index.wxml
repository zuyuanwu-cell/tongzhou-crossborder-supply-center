<view class="page-shell profile-page {{isAdmin ? 'profile-page--admin' : ''}}">
  <view class="profile-hero">
    <view class="profile-grid"></view>
    <view class="profile-eyebrow">{{isAdmin ? 'INTERNAL PROFILE' : 'PARTNER PROFILE'}}</view>
    <view class="profile-identity">
      <view class="avatar"><view class="avatar-aura"></view><text>{{initial}}</text><view class="avatar-online"></view></view>
      <view class="profile-main"><view class="profile-name">{{session.user.displayName}}</view><view class="profile-account">@{{session.user.username}}</view><view class="role-tag">{{roleName}}</view></view>
      <view class="online-mark"><view class="online-dot"></view>在线</view>
    </view>
  </view>

  <block wx:if="{{isAdmin}}">
    <view class="org-panel admin-identity card"><view class="org-symbol">中</view><view class="org-copy"><text>当前身份域</text><strong>供应链中台</strong><code>INTERNAL CONTROL</code></view><view class="org-lock">✓</view></view>
    <view class="scope-panel card"><view class="scope-head"><view><text class="eyebrow">MOBILE SCOPE</text><strong>移动端能力边界</strong></view><text>4 项</text></view><view wx:for="{{adminCapabilities}}" wx:key="key" class="scope-row admin-capability"><view class="scope-dot {{item.enabled ? 'is-enabled' : 'is-disabled'}}"></view><view><strong>{{item.label}}</strong><text>{{item.note}}</text></view><text>{{item.enabled ? '已开放' : '未开放'}}</text></view></view>
    <view class="menu-group card"><view class="menu-item" data-key="organizations" data-title="伙伴组织" bindtap="menuTap"><view class="menu-icon">组</view><view><text>伙伴组织</text><small>查看组织与成员状态</small></view><text class="menu-arrow">›</text></view><view class="menu-item" data-key="security" data-title="会话安全" bindtap="menuTap"><view class="menu-icon">盾</view><view><text>会话安全</text><small>短时令牌、权限复核与操作留痕</small></view><text class="menu-arrow">›</text></view></view>
  </block>

  <block wx:else>
    <view class="org-panel card">
      <view class="org-symbol">{{profile.symbol}}</view><view class="org-copy"><text>当前组织</text><strong>{{session.organization.name}}</strong><code>{{session.organization.code}}</code></view><view class="org-state"><text>边界已锁定</text><view>✓</view></view>
    </view>

    <view class="preference-panel card">
      <view class="panel-heading"><view><text class="eyebrow">HERMES ASSISTANT</text><strong>助手偏好</strong></view><view class="hermes-mini-mark">H</view></view>
      <view class="preference-row"><view class="preference-icon">声</view><view><strong>语音优先</strong><text>进入快捷汇报时突出显示语音入口</text></view><switch color="#28bddb" checked="{{assistantPreferences.voiceFirst}}" data-key="voiceFirst" bindchange="togglePreference" /></view>
      <view class="preference-row"><view class="preference-icon preference-icon--orange">期</view><view><strong>交期提醒</strong><text>在首页优先展示临期与逾期订单</text></view><switch color="#28bddb" checked="{{assistantPreferences.dueReminder}}" data-key="dueReminder" bindchange="togglePreference" /></view>
    </view>

    <view class="scope-panel card">
      <view class="scope-head"><view><text class="eyebrow">AUTHORIZED SCOPE</text><strong>我能处理的业务</strong></view><text>{{accessScopes.length}} 项</text></view>
      <view wx:if="{{accessScopes.length}}"><view wx:for="{{accessScopes}}" wx:key="capability" class="scope-row"><view class="scope-dot"></view><view><strong>{{item.label}}</strong><text>{{item.note}}</text></view><text>已授权</text></view></view>
      <view wx:else class="scope-empty">当前账号仅保留基础查看权限</view>
    </view>

    <view class="menu-group card">
      <view class="menu-item" data-key="organization" data-title="我的组织" bindtap="menuTap"><view class="menu-icon">组</view><view><text>组织与数据边界</text><small>查看当前组织和授权资源</small></view><text class="menu-arrow">›</text></view>
      <view wx:if="{{session.membership.role === 'organization_admin'}}" class="menu-item" data-key="members" data-title="成员管理" bindtap="menuTap"><view class="menu-icon">员</view><view><text>成员管理</text><small>账号、岗位与成员状态</small></view><text class="menu-arrow">›</text></view>
      <view class="menu-item" data-key="audit" data-title="操作留痕" bindtap="menuTap"><view class="menu-icon">迹</view><view><text>操作留痕</text><small>Hermes 代填与人工确认均可追溯</small></view><text class="menu-arrow">›</text></view>
      <view class="menu-item" data-key="security" data-title="账号与安全" bindtap="menuTap"><view class="menu-icon">盾</view><view><text>账号与安全</text><small>密码与登录设备</small></view><text class="menu-arrow">›</text></view>
    </view>
  </block>

  <button class="secondary-button switch-mode-button" bindtap="switchMode">{{isAdmin ? '切换到伙伴登录' : '切换到中台登录'}}</button>
  <button class="danger-button logout-button" bindtap="logout">退出登录</button>
  <view class="version">同舟协同小程序 · {{demoMode ? 'DEMO' : 'PRODUCTION'}} · HERMES</view>
  <tz-tab-bar active="profile" mode="{{mode}}" unread="{{unread}}" theme="dark" />
</view>
