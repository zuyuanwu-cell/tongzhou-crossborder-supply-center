.profile-page { padding-top: 0; }
.profile-hero { position: relative; overflow: hidden; margin: 0 -28rpx; min-height: 272rpx; padding: 48rpx 36rpx; display: flex; align-items: center; gap: 24rpx; color: #fff; background: linear-gradient(145deg, #0b2851, #173d7a); }
.profile-grid { position: absolute; inset: 0; opacity: .11; background-image: linear-gradient(rgba(255,255,255,.12) 1rpx, transparent 1rpx), linear-gradient(90deg,rgba(255,255,255,.12) 1rpx,transparent 1rpx); background-size: 50rpx 50rpx; }
.avatar { position: relative; z-index: 1; flex: 0 0 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; color: #f45b0b; background: #fff; border-radius: 32rpx; box-shadow: 0 16rpx 34rpx rgba(3,18,42,.28); font-size: 46rpx; font-weight: 900; }
.profile-main { position: relative; z-index: 1; flex: 1; }.profile-name { font-size: 38rpx; font-weight: 900; }.profile-account { margin-top: 7rpx; color: #a8bdd6; font: 20rpx/1.2 monospace; }.role-tag { width: max-content; margin-top: 17rpx; padding: 9rpx 15rpx; color: #ffb27f; background: rgba(244,91,11,.15); border: 1rpx solid rgba(255,157,95,.26); border-radius: 999rpx; font-size: 18rpx; font-weight: 700; }
.online-mark { position: relative; z-index: 1; display: flex; align-items: center; gap: 8rpx; color: #bdd0e4; font-size: 19rpx; }.online-dot { width: 13rpx; height: 13rpx; background: #4fc180; border-radius: 50%; box-shadow: 0 0 0 6rpx rgba(79,193,128,.13); }
.org-panel { margin-top: -18rpx; position: relative; z-index: 2; min-height: 142rpx; padding: 24rpx; display: flex; align-items: center; gap: 18rpx; }.org-symbol { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #f45b0b; border-radius: 18rpx; font-size: 27rpx; font-weight: 900; }.org-copy { flex: 1; }.org-copy text,.org-copy strong,.org-copy code { display: block; }.org-copy text { color: #7b899b; font-size: 18rpx; }.org-copy strong { margin-top: 5rpx; color: #173d7a; font-size: 27rpx; }.org-copy code { margin-top: 5rpx; color: #7f8da0; font-size: 17rpx; }.org-lock { color: #18734c; font-size: 29rpx; font-weight: 900; }
.scope-panel { margin-top: 26rpx; padding: 24rpx; }.scope-head { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx solid #e5ebf2; }.scope-head strong,.scope-head text { display: block; }.scope-head strong { margin-top: 7rpx; color: #173d7a; font-size: 27rpx; }.scope-head > text { color: #7b899b; font-size: 19rpx; }.scope-row { min-height: 92rpx; display: grid; grid-template-columns: 20rpx 1fr auto; align-items: center; gap: 14rpx; border-top: 1rpx solid #edf1f5; }.scope-row:first-of-type { border-top: 0; }.scope-dot { width: 12rpx; height: 12rpx; background: #f45b0b; border-radius: 50%; box-shadow: 0 0 0 6rpx #fff0e8; }.scope-row strong,.scope-row view text { display: block; }.scope-row strong { color: #264666; font-size: 22rpx; }.scope-row view text { margin-top: 5rpx; color: #8a97a7; font: 16rpx/1.2 monospace; }.scope-row > text { color: #67768a; font-size: 18rpx; }
.menu-group { overflow: hidden; margin-top: 26rpx; padding: 0 24rpx; }.menu-item { min-height: 118rpx; display: grid; grid-template-columns: 62rpx 1fr 24rpx; align-items: center; gap: 18rpx; border-top: 1rpx solid #e5ebf2; }.menu-item:first-child { border-top: 0; }.menu-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; color: #2451a4; background: #eaf2fb; border-radius: 16rpx; font-size: 22rpx; font-weight: 900; }.menu-item > view:nth-child(2) text,.menu-item > view:nth-child(2) small { display: block; }.menu-item > view:nth-child(2) text { color: #173d7a; font-size: 25rpx; font-weight: 800; }.menu-item > view:nth-child(2) small { margin-top: 7rpx; color: #7b899b; font-size: 19rpx; }.menu-arrow { color: #9aa8b9; font-size: 36rpx; }
.logout-button { margin-top: 30rpx; width: 100%; }.version { margin: 28rpx 0; color: #98a4b3; font: 17rpx/1.3 monospace; text-align: center; letter-spacing: 1rpx; }
.switch-mode-button { width: 100%; margin-top: 28rpx; color: #116f63; border-color: #b9d8d2; background: #f2faf8; }
.profile-page--admin { background: #f2f6f7; }.profile-page--admin .profile-hero { background: radial-gradient(circle at 90% 0,rgba(85,213,188,.18),transparent 250rpx),linear-gradient(145deg,#071d2d,#115b62); }.profile-page--admin .avatar { color: #116f63; }.profile-page--admin .role-tag { color: #8ce0d0; background: rgba(55,189,164,.14); border-color: rgba(113,222,201,.25); }.profile-page--admin .org-symbol { background: #116f63; }.profile-page--admin .eyebrow { color: #0f7a6a; }.admin-safe { background: #e5f3f0; border-color: #c6e3dd; }.admin-safe .safe-banner__icon { background: #116f63; }.admin-identity { border-color: #c9e1dd; }.admin-capability .scope-dot.is-enabled { background: #116f63; box-shadow: 0 0 0 6rpx #e1f2ee; }.admin-capability .scope-dot.is-disabled { background: #9aa7ad; box-shadow: 0 0 0 6rpx #edf1f3; }.admin-capability > text { font-weight: 800; }
