@import "../../styles/hermes-design.wxss";

/* 个人中心 — values follow the 750rpx Hermes v2 design frame. */
page { background: #070B1A; color: #EEF2FF; }
.pf-blob-blue { width: 615rpx; height: 615rpx; top: -192rpx; left: -115rpx; opacity: .5; }
.pf-blob-orange { width: 423rpx; height: 423rpx; top: 77rpx; bottom: auto; left: auto; right: -154rpx; filter: blur(173rpx); opacity: .3; }
.pf-blob-cyan { width: 500rpx; height: 500rpx; top: auto; right: auto; bottom: 154rpx; left: -115rpx; filter: blur(192rpx); opacity: .22; }
.pf-scroll { position: relative; z-index: 1; height: 100vh; }
.pf-content { padding-left: 31rpx; padding-right: 31rpx; padding-bottom: calc(212rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 27rpx; box-sizing: border-box; }

.pf-identity { display: flex; align-items: center; gap: 27rpx; padding: 8rpx 8rpx 15rpx; }
.pf-avatar { position: relative; flex-shrink: 0; width: 131rpx; height: 131rpx; }
.pf-avatar__ring { position: absolute; left: -6rpx; top: -6rpx; right: -6rpx; bottom: -6rpx; border-radius: 42rpx; background: conic-gradient(#5CE1FF, #3B5BFF, #FF7A3D, #5CE1FF); opacity: .9; }
.pf-avatar__face { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; border-radius: 38rpx; background: linear-gradient(160deg, #1A2350, #0B1230); }
.pf-avatar__letter { font-size: 54rpx; font-weight: 800; color: #FF9A66; background: linear-gradient(135deg, #FF7A3D, #FFC08A); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.profile-page--admin .pf-avatar__letter { color: #5CF0C8; background: linear-gradient(135deg, #3DF0C0, #8FFFE0); -webkit-background-clip: text; background-clip: text; }
.pf-identity__main { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 10rpx; }
.pf-identity__name { font-size: 42rpx; font-weight: 700; color: #fff; }
.pf-identity__handle { font-size: 23rpx; color: rgba(214,222,255,.62); }
.pf-role { padding: 4rpx 15rpx; border-radius: 19rpx; background: rgba(255,122,61,.16); border: 1px solid rgba(255,140,90,.4); font-size: 19rpx; font-weight: 600; color: #FFB08A; }
.pf-online { align-self: flex-start; margin-top: 12rpx; display: flex; align-items: center; gap: 10rpx; padding: 8rpx 17rpx; border-radius: 23rpx; background: rgba(61,220,151,.12); border: 1px solid rgba(61,220,151,.3); font-size: 21rpx; color: #7FF0BE; }

.pf-org { padding: 27rpx; display: flex; align-items: center; gap: 23rpx; }
.pf-org__tile { flex-shrink: 0; width: 81rpx; height: 81rpx; display: flex; align-items: center; justify-content: center; border-radius: 23rpx; background: linear-gradient(135deg, #FF6A2A, #FF9F5C); box-shadow: 0 12rpx 31rpx -8rpx rgba(255,106,42,.8); font-size: 35rpx; font-weight: 800; color: #fff; }
.profile-page--admin .pf-org__tile { background: linear-gradient(135deg, #12B48E, #3DF0C0); box-shadow: 0 12rpx 31rpx -8rpx rgba(20,200,160,.7); }
.pf-org__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.pf-org__kicker { font-size: 21rpx; color: rgba(214,222,255,.6); }
.pf-org__name { font-size: 33rpx; font-weight: 700; color: #fff; }
.pf-org__code { font-size: 21rpx; color: rgba(214,222,255,.55); }
.pf-verified { flex-shrink: 0; padding: 12rpx 21rpx; border-radius: 27rpx; border: 1px solid rgba(61,220,151,.3); background: rgba(61,220,151,.1); font-size: 23rpx; color: #7FF0BE; }

.pf-card { padding: 27rpx; display: flex; flex-direction: column; gap: 8rpx; border-radius: 42rpx; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(46rpx); -webkit-backdrop-filter: blur(46rpx); }
.pf-card--hermes { gap: 23rpx; background: linear-gradient(160deg, rgba(92,225,255,.12), rgba(255,255,255,.03)); border-color: rgba(92,225,255,.25); }
.pf-card__title { font-size: 29rpx; font-weight: 700; color: #fff; }
.pf-card__sub { font-size: 21rpx; color: rgba(214,222,255,.62); }
.pf-hermes-head { display: flex; align-items: center; gap: 19rpx; }
.pf-orb { width: 65rpx; height: 65rpx; }
.pf-hermes-head__copy { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.pf-pref { display: flex; align-items: center; justify-content: space-between; gap: 23rpx; padding: 4rpx 0; }
.pf-pref--first { padding-top: 19rpx; border-top: 1px solid rgba(255,255,255,.08); }
.pf-pref__copy { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.pf-pref__title { font-size: 27rpx; color: #EEF2FF; }
.pf-pref__sub { font-size: 21rpx; color: rgba(214,222,255,.55); }
.pf-toggle { position: relative; flex-shrink: 0; width: 92rpx; height: 54rpx; border-radius: 27rpx; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); box-sizing: border-box; transition: background .3s; }
.pf-toggle.is-on { background: linear-gradient(135deg, #3B5BFF, #22A6FF); }
.pf-toggle__knob { position: absolute; top: 6rpx; left: 6rpx; width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.4); transition: left .3s cubic-bezier(.2,.8,.2,1); }
.pf-toggle.is-on .pf-toggle__knob { left: 44rpx; }

.pf-scope-head { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin-bottom: 12rpx; }
.pf-scope-head__copy { display: flex; flex-direction: column; gap: 4rpx; }
.pf-lock { flex-shrink: 0; font-size: 21rpx; color: #8FEAFF; }
.pf-scope-row { display: flex; align-items: center; gap: 19rpx; padding: 19rpx 0; border-top: 1px solid rgba(255,255,255,.08); }
.pf-scope-dot { flex-shrink: 0; width: 13rpx; height: 13rpx; border-radius: 50%; }
.pf-scope-dot--orange { background: #FF7A3D; box-shadow: 0 0 15rpx #FF7A3D; }
.pf-scope-dot--green { background: #3DDC97; box-shadow: 0 0 15rpx #3DDC97; }
.pf-scope-dot--cyan { background: #5CE1FF; box-shadow: 0 0 15rpx #5CE1FF; }
.pf-scope-dot--violet { background: #B26BFF; box-shadow: 0 0 15rpx #B26BFF; }
.pf-scope-dot--off { background: rgba(214,222,255,.3); }
.pf-scope-row__copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.pf-scope-row__label { font-size: 27rpx; color: #EEF2FF; }
.pf-scope-row__note { font-size: 21rpx; color: rgba(214,222,255,.5); }
.pf-scope-row__meta { flex-shrink: 0; font-size: 21rpx; color: rgba(214,222,255,.58); }
.pf-scope-empty { padding: 19rpx 0; border-top: 1px solid rgba(255,255,255,.08); font-size: 23rpx; color: rgba(214,222,255,.6); }
.pf-scope-foot { padding-top: 8rpx; font-size: 21rpx; line-height: 1.5; color: rgba(214,222,255,.55); }

.pf-menu { padding: 0; gap: 0; overflow: hidden; }
.pf-menu-row { display: flex; align-items: center; gap: 23rpx; padding: 27rpx; border-top: 1px solid rgba(255,255,255,.07); }
.pf-menu-row:first-child { border-top: 0; }
.pf-menu-row:active { background: rgba(255,255,255,.05); }
.pf-menu-icon { flex-shrink: 0; width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: rgba(92,225,255,.12); border: 1px solid rgba(92,225,255,.25); font-size: 25rpx; font-weight: 700; color: #8FEAFF; }
.pf-menu-row__copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.pf-menu-row__title { font-size: 27rpx; color: #EEF2FF; }
.pf-menu-row__sub { font-size: 21rpx; color: rgba(214,222,255,.52); }
.pf-chevron { color: rgba(214,222,255,.4); }

.pf-logout { height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 46rpx; border: 1px solid rgba(255,92,108,.4); background: rgba(255,92,108,.08); font-size: 27rpx; font-weight: 600; color: #FF8A96; }
.pf-logout:active { background: rgba(255,92,108,.16); }
.pf-switch { align-self: center; padding: 8rpx 19rpx; font-size: 23rpx; color: rgba(214,222,255,.62); }
.pf-version { align-self: center; font-size: 19rpx; letter-spacing: 1px; color: rgba(214,222,255,.35); }

/* Avatar change (2026-10-28 design update): tap avatar or the camera badge. */
.pf-avatar__face { overflow: hidden; }
.pf-avatar__image { width: 131rpx; height: 131rpx; border-radius: 38rpx; }
.pf-avatar__badge { position: absolute; right: -12rpx; bottom: -12rpx; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #070B1A; border-radius: 50%; background: linear-gradient(135deg, #3B5BFF, #22A6FF); box-shadow: 0 8rpx 19rpx -4rpx rgba(59,91,255,.8); box-sizing: border-box; }
.pf-camera { position: relative; width: 23rpx; height: 17rpx; border: 1.5px solid #fff; border-radius: 4rpx; box-sizing: border-box; }
.pf-camera__lens { position: absolute; left: 50%; top: 50%; width: 8rpx; height: 8rpx; margin: -4rpx 0 0 -4rpx; border: 1px solid #fff; border-radius: 50%; box-sizing: border-box; }
.pf-role-row { display: flex; align-items: center; gap: 15rpx; }
.pf-avatar-reset { font-size: 21rpx; color: #8FEAFF; }

/* WeChat quick login row (2026-10-29). */
.pf-menu-icon--wechat { background: rgba(7,193,96,.14); border-color: rgba(7,193,96,.4); color: #7FF0BE; }
.pf-wechat-state { flex-shrink: 0; padding: 6rpx 17rpx; border-radius: 21rpx; background: rgba(255,122,61,.16); border: 1px solid rgba(255,140,90,.4); font-size: 21rpx; color: #FFB08A; }
.pf-wechat-state.is-on { background: rgba(61,220,151,.12); border-color: rgba(61,220,151,.3); color: #7FF0BE; }
