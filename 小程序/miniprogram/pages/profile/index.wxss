.profile-page { padding-top: 0; background: #071a36; }
.profile-hero { position: relative; overflow: hidden; margin: 0 -28rpx; min-height: 300rpx; padding: 38rpx 34rpx 48rpx; color: #fff; background: radial-gradient(circle at 92% 8%,rgba(44,199,227,.2),transparent 260rpx),linear-gradient(155deg,#061831,#0b2d5c); }
.profile-grid { position: absolute; inset: 0; opacity: .1; background-image: linear-gradient(rgba(255,255,255,.12) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(255,255,255,.12) 1rpx,transparent 1rpx); background-size: 54rpx 54rpx; }
.profile-eyebrow { position: relative; z-index: 1; color: #55cbe4; font-size: 16rpx; font-weight: 800; letter-spacing: 3rpx; }.profile-identity { position: relative; z-index: 1; margin-top: 31rpx; display: flex; align-items: center; gap: 23rpx; }
.avatar { position: relative; flex: 0 0 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#2dc3df,#5967df 62%,#f45b0b); border: 2rpx solid rgba(255,255,255,.26); border-radius: 34rpx; box-shadow: 0 0 42rpx rgba(47,195,223,.2); font-size: 43rpx; font-weight: 900; }.avatar text { position: relative; z-index: 2; }.avatar-aura { position: absolute; inset: -12rpx; border: 1rpx solid rgba(76,203,228,.24); border-radius: 42rpx; animation: aura 2.8s ease-in-out infinite; }.avatar-online { position: absolute; z-index: 3; right: -4rpx; top: -4rpx; width: 20rpx; height: 20rpx; background: #43d493; border: 5rpx solid #082249; border-radius: 50%; }
@keyframes aura { 0%,100% { opacity: .45; transform: scale(.95); } 50% { opacity: 1; transform: scale(1.03); } }
.profile-main { flex: 1; min-width: 0; }.profile-name { font-size: 38rpx; font-weight: 900; }.profile-account { margin-top: 6rpx; color: #91a9c4; font: 19rpx/1.2 monospace; }.role-tag { width: max-content; margin-top: 14rpx; padding: 8rpx 14rpx; color: #66d9b0; background: rgba(67,212,147,.1); border: 1rpx solid rgba(67,212,147,.22); border-radius: 999rpx; font-size: 17rpx; font-weight: 800; }
.online-mark { display: flex; align-items: center; gap: 8rpx; color: #91a9c4; font-size: 18rpx; }.online-dot { width: 10rpx; height: 10rpx; background: #43d493; border-radius: 50%; box-shadow: 0 0 0 6rpx rgba(67,212,147,.1); }
.card { background: #f8fbff; border-color: rgba(126,170,216,.24); box-shadow: 0 18rpx 46rpx rgba(0,10,28,.22); }
.org-panel { margin-top: -20rpx; position: relative; z-index: 3; min-height: 145rpx; padding: 23rpx; display: flex; align-items: center; gap: 17rpx; }.org-symbol { width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#1faeca,#556be1); border-radius: 20rpx; font-size: 27rpx; font-weight: 900; }.org-copy { flex: 1; min-width: 0; }.org-copy text,.org-copy strong,.org-copy code { display: block; }.org-copy text { color: #8190a4; font-size: 17rpx; }.org-copy strong { margin-top: 5rpx; overflow: hidden; color: #17375f; font-size: 25rpx; text-overflow: ellipsis; white-space: nowrap; }.org-copy code { margin-top: 5rpx; color: #8796a9; font-size: 16rpx; }.org-state { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }.org-state text { color: #718198; font-size: 16rpx; }.org-state view,.org-lock { width: 37rpx; height: 37rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #299e70; border-radius: 50%; font-size: 18rpx; font-weight: 900; }
.preference-panel,.scope-panel { margin-top: 24rpx; padding: 23rpx; }.panel-heading,.scope-head { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx solid #e0e8f1; }.panel-heading strong,.scope-head strong,.scope-head text { display: block; }.panel-heading strong,.scope-head strong { margin-top: 7rpx; color: #17375f; font-size: 27rpx; }.panel-heading .eyebrow,.scope-head .eyebrow { color: #2975ad; }.scope-head > text { color: #7c8da2; font-size: 18rpx; }.hermes-mini-mark { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg,#29bfdc,#5b69e0); border-radius: 17rpx; font-size: 22rpx; font-weight: 900; }
.preference-row { min-height: 116rpx; display: grid; grid-template-columns: 58rpx minmax(0,1fr) auto; align-items: center; gap: 15rpx; border-top: 1rpx solid #e6edf4; }.preference-row:first-of-type { border-top: 0; }.preference-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: #13728a; background: #dff4f8; border-radius: 16rpx; font-size: 18rpx; font-weight: 900; }.preference-icon--orange { color: #a95819; background: #ffede0; }.preference-row strong,.preference-row text { display: block; }.preference-row strong { color: #254667; font-size: 22rpx; }.preference-row text { margin-top: 6rpx; color: #8190a3; font-size: 17rpx; line-height: 1.45; }
.scope-row { min-height: 98rpx; display: grid; grid-template-columns: 18rpx minmax(0,1fr) auto; align-items: center; gap: 14rpx; border-top: 1rpx solid #e5ecf3; }.scope-row:first-child { border-top: 0; }.scope-dot { width: 10rpx; height: 10rpx; background: #27bad6; border-radius: 50%; box-shadow: 0 0 0 6rpx #e1f5f8; }.scope-row strong,.scope-row view text { display: block; }.scope-row strong { color: #294968; font-size: 21rpx; }.scope-row view text { margin-top: 5rpx; color: #8795a7; font-size: 16rpx; }.scope-row > text { color: #28755a; font-size: 16rpx; font-weight: 800; }.scope-empty { padding: 34rpx 10rpx 15rpx; color: #7e8c9f; font-size: 20rpx; text-align: center; }
.menu-group { overflow: hidden; margin-top: 24rpx; padding: 0 23rpx; }.menu-item { min-height: 106rpx; display: grid; grid-template-columns: 58rpx minmax(0,1fr) 22rpx; align-items: center; gap: 16rpx; border-top: 1rpx solid #e4ebf3; }.menu-item:first-child { border-top: 0; }.menu-icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: #2772a9; background: #e6f1f8; border-radius: 16rpx; font-size: 18rpx; font-weight: 900; }.menu-item > view:nth-child(2) text,.menu-item > view:nth-child(2) small { display: block; }.menu-item > view:nth-child(2) text { color: #244464; font-size: 22rpx; font-weight: 800; }.menu-item > view:nth-child(2) small { margin-top: 5rpx; color: #8391a2; font-size: 17rpx; }.menu-arrow { color: #9aabba; font-size: 32rpx; }
.switch-mode-button { width: 100%; margin-top: 25rpx; color: #9dc4e9; background: rgba(255,255,255,.06); border-color: rgba(137,177,218,.2); }.logout-button { width: 100%; margin-top: 16rpx; color: #ff9e92; background: rgba(219,75,63,.08); border-color: rgba(239,117,106,.2); }.version { margin: 27rpx 0; color: #536e8d; font: 16rpx/1.3 monospace; text-align: center; letter-spacing: 1rpx; }
.profile-page--admin { background: #0a222e; }.profile-page--admin .profile-hero { background: radial-gradient(circle at 90% 0,rgba(85,213,188,.18),transparent 250rpx),linear-gradient(145deg,#071d2d,#115b62); }.profile-page--admin .avatar { background: linear-gradient(145deg,#38bfa5,#176c73); }.profile-page--admin .org-symbol { background: #116f63; }.profile-page--admin .eyebrow { color: #0f7a6a; }.admin-capability .scope-dot.is-enabled { background: #116f63; box-shadow: 0 0 0 6rpx #e1f2ee; }.admin-capability .scope-dot.is-disabled { background: #9aa7ad; box-shadow: 0 0 0 6rpx #edf1f3; }
