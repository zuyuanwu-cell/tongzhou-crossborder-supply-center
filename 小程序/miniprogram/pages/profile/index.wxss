page{background:#050b19;color:#f4f9fd;font-family:"PingFang SC","Microsoft YaHei",sans-serif}.profile-page{position:relative;min-height:100vh;overflow:hidden;background:radial-gradient(circle at 88% 8%,rgba(24,118,173,.24),transparent 36%),radial-gradient(circle at 4% 65%,rgba(91,44,151,.17),transparent 38%),linear-gradient(160deg,#071328,#050a16 60%,#0b1021)}.profile-grid{position:fixed;inset:0;opacity:.12;background-image:linear-gradient(rgba(119,171,218,.12) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(119,171,218,.12) 1rpx,transparent 1rpx);background-size:53rpx 53rpx}.profile-aurora{position:fixed;right:-230rpx;top:-210rpx;width:500rpx;height:500rpx;background:#1a98c4;border-radius:50%;filter:blur(100rpx);opacity:.18}.profile-header{position:relative;z-index:10;min-height:92rpx;padding-left:24rpx;padding-right:28rpx;display:grid;grid-template-columns:58rpx 1fr auto;align-items:center;gap:12rpx;background:rgba(5,12,26,.76);border-bottom:1rpx solid rgba(139,181,218,.13);backdrop-filter:blur(28rpx)}.back-button{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;color:#91abc4;background:rgba(255,255,255,.04);border:1rpx solid rgba(139,180,215,.13);border-radius:16rpx;font-size:36rpx}.profile-header strong,.profile-header text{display:block}.profile-header strong{font-size:25rpx}.profile-header text{margin-top:3rpx;color:#718aa5;font-size:14rpx}.online-pill{padding:8rpx 12rpx;display:flex;align-items:center;gap:7rpx;color:#62dbae;background:rgba(64,208,154,.07);border:1rpx solid rgba(64,208,154,.14);border-radius:999rpx;font-size:14rpx}.online-pill i{width:7rpx;height:7rpx;background:#51dda5;border-radius:50%;box-shadow:0 0 10rpx #51dda5}.profile-scroll{position:relative;z-index:2;height:calc(100vh - 112rpx - env(safe-area-inset-bottom))}.profile-content{padding:28rpx 27rpx 150rpx}.glass-card{background:linear-gradient(145deg,rgba(20,39,68,.88),rgba(10,23,44,.84));border:1rpx solid rgba(141,181,218,.17);border-radius:23rpx;box-shadow:0 23rpx 65rpx rgba(0,3,12,.26);backdrop-filter:blur(28rpx)}.identity-card{padding:24rpx;display:flex;align-items:center;gap:17rpx}.avatar{position:relative;width:92rpx;height:92rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#22c3da,#5b62db 58%,#f47a29);border-radius:28rpx;font-size:35rpx;font-weight:900;box-shadow:0 0 35rpx rgba(39,190,218,.2)}.avatar view{position:absolute;right:-3rpx;top:-3rpx;width:15rpx;height:15rpx;background:#4bdca2;border:4rpx solid #0b1930;border-radius:50%}.identity-main{flex:1;min-width:0}.identity-main strong,.identity-main text,.identity-main small{display:block}.identity-main strong{font-size:29rpx}.identity-main text{margin-top:5rpx;color:#7892ac;font:16rpx/1.3 monospace}.identity-main small{width:max-content;margin-top:9rpx;padding:5rpx 10rpx;color:#70dfb6;background:rgba(64,208,154,.08);border-radius:999rpx;font-size:14rpx}.identity-state{color:#5fd9aa;font-size:15rpx}.org-card{margin-top:16rpx;padding:19rpx 21rpx;display:grid;grid-template-columns:61rpx 1fr auto;align-items:center;gap:15rpx}.org-mark{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#20b9d1,#4f65d5);border-radius:18rpx;font-size:22rpx;font-weight:900}.org-card text,.org-card strong,.org-card small{display:block}.org-card text{color:#6f89a2;font-size:14rpx}.org-card strong{margin-top:4rpx;font-size:21rpx}.org-card small{margin-top:4rpx;color:#536f8b;font:13rpx/1.2 monospace}.lock-mark{width:35rpx;height:35rpx;display:flex;align-items:center;justify-content:center;color:#071a20;background:#4cd6a1;border-radius:50%;font-size:16rpx;font-weight:900}.section-title{margin:31rpx 3rpx 13rpx;display:flex;align-items:flex-end;gap:10rpx}.section-title text,.section-title strong{display:block}.section-title text{color:#3fc8de;font-size:13rpx;font-weight:900;letter-spacing:2rpx}.section-title strong{font-size:23rpx}.section-title small{margin-left:auto;color:#6b85a0;font-size:15rpx}.list-card{overflow:hidden}.preference-row,.scope-row,.menu-row{min-height:98rpx;padding:13rpx 19rpx;display:grid;grid-template-columns:52rpx minmax(0,1fr) auto;align-items:center;gap:14rpx;border-top:1rpx solid rgba(139,178,214,.11)}.preference-row:first-child,.scope-row:first-child,.menu-row:first-child{border-top:0}.preference-icon,.scope-icon,.menu-icon{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;color:#50d2e4;background:rgba(48,190,213,.08);border:1rpx solid rgba(48,190,213,.13);border-radius:15rpx;font-size:15rpx;font-weight:900}.preference-icon--orange{color:#ffa061;background:rgba(243,111,38,.08);border-color:rgba(243,111,38,.14)}.scope-icon{color:#7790aa;background:rgba(255,255,255,.03);border-color:rgba(139,178,214,.12)}.scope-icon.is-enabled{color:#071b20;background:#4bd5a0;border-color:#4bd5a0}.preference-row strong,.preference-row text,.scope-row strong,.scope-row view text,.menu-row strong,.menu-row text{display:block}.preference-row strong,.scope-row strong,.menu-row strong{font-size:19rpx}.preference-row text,.scope-row view text,.menu-row text{margin-top:5rpx;color:#6e88a2;font-size:15rpx;line-height:1.45}.scope-row>small{color:#59d5a6;font-size:14rpx}.menu-row>small{color:#6c87a1;font-size:28rpx}.scope-empty{padding:38rpx;color:#6f89a3;font-size:17rpx;text-align:center}.switch-button,.logout-button{height:76rpx;margin-top:20rpx;color:#86a3be;background:rgba(255,255,255,.035);border:1rpx solid rgba(140,179,216,.13);border-radius:17rpx;font-size:19rpx}.logout-button{margin-top:11rpx;color:#ff9383;background:rgba(191,60,48,.07);border-color:rgba(220,83,70,.16)}.version{margin-top:25rpx;color:#405e7c;font:13rpx/1.4 monospace;text-align:center;letter-spacing:1rpx}.profile-page--admin{background:radial-gradient(circle at 88% 8%,rgba(29,151,128,.22),transparent 37%),linear-gradient(160deg,#061724,#050b15 60%,#071b20)}.profile-page--admin .org-mark{background:linear-gradient(145deg,#149