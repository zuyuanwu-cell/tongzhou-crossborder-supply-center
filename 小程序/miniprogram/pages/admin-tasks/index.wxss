@import "../../styles/admin.wxss";
.admin-list-page { padding-top: 24rpx; }.admin-list-head { min-height: 142rpx; display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 25rpx; border-bottom: 1rpx solid #d6e2e5; }.admin-list-head text,.admin-list-head strong,.admin-list-head small { display: block; }.admin-list-head view:first-child > text { color: #0f7a6a; font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }.admin-list-head view:first-child > strong { margin-top: 7rpx; color: #173d4d; font-size: 42rpx; }.admin-list-head small { margin-top: 8rpx; color: #748791; font-size: 19rpx; }.admin-count { width: 92rpx; height: 84rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #e2f1ee; border-radius: 16rpx; }.admin-count strong { color: #116f63; font: 900 31rpx/1 "DIN Alternate", monospace; }.admin-count text { margin-top: 8rpx; color: #668079; font-size: 16rpx; }
.organization-picker { height: 78rpx; margin-top: 16rpx; padding: 0 20rpx; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14rpx; }.organization-picker > text { color: #768991; font-size: 18rpx; }.organization-picker strong { color: #1c4857; font-size: 21rpx; }.organization-picker > text:last-child { color: #116f63; font-size: 25rpx; }.retry { width: 210rpx; min-height: 70rpx; margin: 20rpx auto 0; font-size: 21rpx; }
