.operation-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }.operation-hero { padding: 38rpx 30rpx 44rpx; color: #fff; background: radial-gradient(circle at 100% 0,rgba(82,170,220,.22),transparent 300rpx),linear-gradient(145deg,#0a274f,#173d7a); }.operation-eyebrow { color: #7fd5f6; }.operation-title { margin-top: 14rpx; font-size: 42rpx; font-weight: 900; }.operation-copy { margin-top: 10rpx; color: #afc2d9; font-size: 22rpx; }.step-line { margin-top: 36rpx; display: grid; grid-template-columns: repeat(3,1fr); }.step-line > view { position: relative; display: flex; align-items: center; gap: 10rpx; color: #849fbd; }.step-line > view::before { content: ""; position: absolute; left: -50%; right: 50%; top: 19rpx; height: 2rpx; background: #42658d; }.step-line > view:first-child::before { display: none; }.step-line text { position: relative; z-index: 1; width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; background: #345980; border-radius: 50%; font: 800 18rpx/1 monospace; }.step-line small { font-size: 18rpx; }.step-line .is-active { color: #fff; }.step-line .is-active text,.step-line .is-active::before { background: #f45b0b; }
.operation-body { padding: 24rpx 28rpx 50rpx; }.type-switch { padding: 8rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; }.type-switch view { height: 70rpx; display: flex; align-items: center; justify-content: center; color: #63738b; border-radius: 12rpx; font-size: 23rpx; font-weight: 700; }.type-switch .is-active { color: #fff; background: #173d7a; box-shadow: inset 0 -5rpx #f45b0b; }
.form-section { margin-top: 22rpx; padding: 26rpx; }.form-title { margin-bottom: 28rpx; display: flex; align-items: center; gap: 16rpx; }.form-title > text { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #f45b0b; border-radius: 14rpx; font: 800 19rpx/1 monospace; }.form-title strong,.form-title small { display: block; }.form-title strong { color: #173d7a; font-size: 27rpx; }.form-title small { margin-top: 5rpx; color: #8491a2; font-size: 18rpx; }.operation-loading { padding: 34rpx; color: #718096; background: #f5f8fb; text-align: center; font-size: 22rpx; }
.product-picker-row { display: flex; gap: 12rpx; }.product-picker { flex: 1; min-width: 0; }.product-picker > view { height: 82rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: space-between; color: #173d7a; background: #f7f9fc; border: 1rpx solid #d7e0ea; border-radius: 13rpx; font-size: 21rpx; }.add-line { flex: 0 0 138rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #2451a4; border-radius: 13rpx; font-size: 21rpx; font-weight: 700; }
.selected-lines { margin-top: 22rpx; }.selected-line { margin-top: 16rpx; overflow: hidden; border: 1rpx solid #dfe6ef; border-radius: 15rpx; }.line-summary { padding: 18rpx; display: grid; grid-template-columns: 62rpx 1fr 42rpx; align-items: center; gap: 13rpx; background: #f6f9fc; }.line-image { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; color: #2451a4; background: #e3edf8; border-radius: 14rpx; font-size: 25rpx; font-weight: 900; }.line-summary strong,.line-summary text,.line-summary small { display: block; }.line-summary strong { color: #173d7a; font-size: 22rpx; }.line-summary text { margin-top: 4rpx; color: #718096; font-size: 16rpx; }.line-summary small { margin-top: 6rpx; color: #7c8999; font-size: 16rpx; }.remove-line { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; color: #a84437; background: #ffebe7; border-radius: 50%; font-size: 28rpx; }
.operation-fields { padding: 18rpx; display: grid; grid-template-columns: repeat(2,1fr); gap: 15rpx; }.operation-fields label > text { display: block; margin-bottom: 7rpx; color: #68788c; font-size: 17rpx; }.operation-fields input,.date-picker { height: 66rpx; padding: 0 13rpx; display: flex; align-items: center; color: #173d7a; background: #fff; border: 1rpx solid #d9e1eb; border-radius: 9rpx; font-size: 20rpx; }.barcode-field { grid-column: 1 / -1; }.barcode-field > view { display: flex; }.barcode-field input { flex: 1; border-radius: 9rpx 0 0 9rpx; }.barcode-field view > text { flex: 0 0 84rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #2451a4; border-radius: 0 9rpx 9rpx 0; font-size: 18rpx; }
.approval-banner { margin-top: 24rpx; padding: 24rpx; display: flex; gap: 17rpx; color: #684f1f; background: #fff4dd; border-left: 6rpx solid #e69a26; border-radius: 12rpx; }.approval-banner > view:first-child { flex: 0 0 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #d98b18; border-radius: 14rpx; font-weight: 900; }.approval-banner strong,.approval-banner text { display: block; }.approval-banner strong { font-size: 23rpx; }.approval-banner text { margin-top: 6rpx; font-size: 19rpx; line-height: 1.55; }
