@import "../../styles/admin.wxss";
.detail-page { padding-top: 0; }
.detail-heading { margin: 0 -28rpx 24rpx; padding: 31rpx 34rpx 36rpx; color: #fff; background: radial-gradient(circle at 92% 0,rgba(110,224,204,.2),transparent 270rpx),linear-gradient(145deg,#071d2d,#145866); }
.detail-heading text,.detail-heading strong,.detail-heading small { display: block; }.detail-heading text { color: #78dec9; font-size: 17rpx; font-weight: 900; letter-spacing: 3rpx; }.detail-heading strong { margin-top: 10rpx; font-size: 38rpx; }.detail-heading small { margin-top: 10rpx; color: #a9c6c9; font-size: 18rpx; }
.detail-identity { padding: 22rpx; display: flex; align-items: center; gap: 17rpx; }.detail-identity__visual { width: 104rpx; height: 104rpx; flex: 0 0 104rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; color: #0f6f64; background: #e7f3f0; border-radius: 19rpx; font-size: 25rpx; font-weight: 900; }.detail-identity__visual image { width: 100%; height: 100%; background: #fff; }.detail-identity__copy { flex: 1; min-width: 0; }.detail-identity__copy strong,.detail-identity__copy text { display: block; }.detail-identity__copy strong { color: #173d4d; font-size: 27rpx; line-height: 1.35; }.detail-identity__copy text { margin-top: 8rpx; color: #71858e; font-size: 18rpx; line-height: 1.5; }
.detail-metrics { margin-top: 16rpx; display: grid; grid-template-columns: repeat(2,1fr); gap: 12rpx; }.detail-metric { min-height: 106rpx; padding: 19rpx; background: #fff; border: 1rpx solid #d8e4e6; border-radius: 17rpx; }.detail-metric text,.detail-metric strong { display: block; }.detail-metric text { color: #73868f; font-size: 18rpx; }.detail-metric strong { margin-top: 11rpx; color: #123e4d; font-size: 27rpx; font-weight: 900; }
.detail-section,.detail-copy { margin-top: 16rpx; overflow: hidden; }.detail-section__head { padding: 18rpx 22rpx; color: #0f7167; background: #eef6f5; border-bottom: 1rpx solid #dce8e7; font-size: 20rpx; font-weight: 900; letter-spacing: 1rpx; }.detail-field { min-height: 73rpx; padding: 15rpx 22rpx; display: grid; grid-template-columns: 170rpx minmax(0,1fr); gap: 18rpx; align-items: center; border-top: 1rpx solid #e7edef; }.detail-field:first-of-type { border-top: 0; }.detail-field text { color: #758790; font-size: 19rpx; }.detail-field strong { color: #254958; font-size: 20rpx; text-align: right; word-break: break-all; }.detail-field strong.is-accent { color: #c34a13; }
.detail-copy { padding: 22rpx; }.detail-copy strong,.detail-copy text { display: block; }.detail-copy strong { color: #173f4f; font-size: 23rpx; }.detail-copy text { margin-top: 13rpx; color: #617782; font-size: 19rpx; line-height: 1.8; white-space: pre-wrap; }
.attachment-row { min-height: 90rpx; padding: 15rpx 20rpx; display: flex; align-items: center; gap: 14rpx; border-top: 1rpx solid #e6edef; }.attachment-row view { width: 58rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #176f66; border-radius: 10rpx; font-size: 16rpx; font-weight: 800; }.attachment-row text { flex: 1; min-width: 0; color: #365967; font-size: 19rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.attachment-row strong { color: #0f7167; font-size: 18rpx; }
.scene-card { margin-top: 16rpx; padding: 20rpx; overflow: hidden; }.scene-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; }.scene-head view:first-child text,.scene-head view:first-child strong { display: block; }.scene-head view:first-child text { color: #f45b0b; font-size: 15rpx; font-weight: 900; letter-spacing: 2rpx; }.scene-head view:first-child strong { margin-top: 5rpx; color: #173e4e; font-size: 24rpx; }.scene-tabs { display: flex; padding: 4rpx; background: #e9f0f1; border-radius: 10rpx; }.scene-tabs text { padding: 8rpx 13rpx; color: #647982; border-radius: 8rpx; font-size: 17rpx; }.scene-tabs text.is-active { color: #fff; background: #116f63; }
.loading-scene { width: 100%; height: 480rpx; margin-top: 16rpx; border-radius: 14rpx; background: #071d2d; }.scene-note { margin-top: 12rpx; color: #789099; font-size: 17rpx; text-align: center; }.scene-legend { width: calc(100% + 40rpx); margin: 14rpx -20rpx 0; white-space: nowrap; }.scene-legend__row { display: inline-flex; gap: 10rpx; padding: 0 20rpx; }.scene-legend__row > view { min-width: 144rpx; padding: 10rpx 12rpx; display: flex; align-items: center; gap: 9rpx; background: #f3f7f7; border-radius: 11rpx; }.scene-legend__row > view > text { width: 20rpx; height: 42rpx; border-radius: 6rpx; }.scene-legend__row strong,.scene-legend__row small { display: block; }.scene-legend__row strong { color: #234957; font-size: 16rpx; }.scene-legend__row small { margin-top: 3rpx; color: #7a8c94; font-size: 14rpx; }
.container-item { min-height: 90rpx; padding: 15rpx 20rpx; display: flex; align-items: center; gap: 14rpx; border-top: 1rpx solid #e7edef; }.container-item > text { width: 13rpx; height: 52rpx; border-radius: 7rpx; }.container-item view { flex: 1; min-width: 0; }.container-item strong,.container-item small { display: block; }.container-item strong { color: #234957; font-size: 19rpx; }.container-item small { margin-top: 6rpx; color: #7a8c94; font-size: 16rpx; line-height: 1.5; }
.safe-banner strong,.safe-banner text { display: block; }.safe-banner strong { font-size: 23rpx; }.safe-banner text { margin-top: 7rpx; font-size: 19rpx; line-height: 1.6; }.safe-banner__icon { font-size: 18rpx; }
