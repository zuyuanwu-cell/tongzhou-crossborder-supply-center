@import "../../styles/admin.wxss";
.approval-page { padding-top: 24rpx; }.approval-head { min-height: 142rpx; display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 25rpx; border-bottom: 1rpx solid #d6e2e5; }.approval-head text,.approval-head strong,.approval-head small { display: block; }.approval-head view:first-child > text { color: #0f7a6a; font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }.approval-head view:first-child > strong { margin-top: 7rpx; color: #173d4d; font-size: 42rpx; }.approval-head small { margin-top: 8rpx; color: #748791; font-size: 19rpx; }.approval-count { width: 102rpx; height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #a56014; background: #fff0d4; border-radius: 17rpx; }.approval-count strong { font: 900 32rpx/1 "DIN Alternate",monospace; }.approval-count text { margin-top: 8rpx; font-size: 16rpx; }
.approval-rule { margin: 22rpx 0; padding: 20rpx; display: flex; gap: 14rpx; background: #e5f3f0; border: 1rpx solid #c7e3de; border-radius: 16rpx; }.approval-rule > text { flex: 0 0 auto; height: 39rpx; padding: 0 12rpx; display: flex; align-items: center; color: #fff; background: #116f63; border-radius: 999rpx; font-size: 16rpx; font-weight: 800; }.approval-rule view { color: #4f6e72; font-size: 18rpx; line-height: 1.55; }
.approval-list { display: flex; flex-direction: column; gap: 17rpx; }.approval-card { padding: 24rpx; }.approval-card__top { display: flex; justify-content: space-between; gap: 18rpx; }.approval-card__top view text,.approval-card__top view strong { display: block; }.approval-card__top view text { color: #0f7a6a; font-size: 17rpx; font-weight: 800; }.approval-card__top view strong { margin-top: 7rpx; color: #173e4e; font-size: 25rpx; }.approval-card__top > text { height: 42rpx; padding: 0 13rpx; display: flex; align-items: center; color: #a33c2e; background: #fde9e6; border-radius: 999rpx; font-size: 16rpx; font-weight: 800; }.approval-card__body { margin-top: 20rpx; padding: 18rpx; color: #4d6874; background: #f2f7f7; border-radius: 13rpx; font-size: 20rpx; line-height: 1.55; }.approval-card__meta { margin-top: 17rpx; display: flex; justify-content: space-between; color: #89999f; font-size: 16rpx; }.retry { width: 210rpx; min-height: 70rpx; margin: 20rpx auto 0; font-size: 21rpx; }
