<view class="login-page {{loginMode === 'admin' ? 'login-page--admin' : ''}}">
  <view class="login-grid"></view><view class="login-aurora login-aurora--one"></view><view class="login-aurora login-aurora--two"></view>
  <scroll-view class="login-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="login-content" style="padding-top: {{statusBarHeight + 24}}px">
      <view class="brand-row"><image src="/images/brand-avatar-v2.png" mode="aspectFill"/><view><strong>同舟协同</strong><text>TONGZHOU · POWERED BY HERMES</text></view></view>

      <view class="hero-copy"><view class="hero-kicker">{{loginMode === 'admin' ? 'INTERNAL CONTROL' : 'ONE TASK · ONE BOUNDARY'}}</view><view class="hero-title">{{loginMode === 'admin' ? '关键协同，\n一处看清、及时决策。' : '每一次交接，\n都清楚、准确、有回音。'}}</view><view class="hero-subtitle">{{loginMode === 'admin' ? '供应链中台移动监管与审批工作台' : 'Hermes 陪你完成订单、进度与异常反馈'}}</view></view>
      <view class="handoff"><view><i>1</i><text>{{loginMode === 'admin' ? '跨组织总览' : '中台发布'}}</text></view><b></b><view><i>2</i><text>{{loginMode === 'admin' ? '风险聚焦' : '组织执行'}}</text></view><b></b><view><i>3</i><text>{{loginMode === 'admin' ? '审核留痕' : '凭证回传'}}</text></view></view>

      <view class="login-card">
        <view class="mode-switch"><view class="{{loginMode === 'partner' ? 'is-active' : ''}}" data-mode="partner" bindtap="switchMode">伙伴登录</view><view class="{{loginMode === 'admin' ? 'is-active' : ''}}" data-mode="admin" bindtap="switchMode">中台登录</view></view>
        <view class="card-heading"><view><text>{{loginMode === 'admin' ? 'CONTROL ACCESS' : 'PARTNER ACCESS'}}</text><strong>{{loginMode === 'admin' ? '中台登录' : '伙伴登录'}}</strong></view><view class="secure-tag"><i></i>安全连接</view></view>
        <view class="card-copy">{{loginMode === 'admin' ? '使用中台账号进入移动监管工作台' : '使用管理员分配的账号进入组织工作区'}}</view>

        <view wx:if="{{loginMode === 'admin'}}" class="credential-switch"><view class="{{adminCredentialType === 'account_password' ? 'is-active' : ''}}" data-type="account_password" bindtap="switchAdminCredential">账号密码</view><view class="{{adminCredentialType === 'access_code' ? 'is-active' : ''}}" data-type="access_code" bindtap="switchAdminCredential">访问码</view></view>
        <view wx:if="{{demoMode && loginMode === 'partner'}}" class="demo-accounts"><view wx:for="{{demoAccounts}}" wx:key="username" class="{{form.username === item.username ? 'is-active' : ''}}" data-username="{{item.username}}" bindtap="chooseDemo"><text>{{item.symbol}}</text><small>{{item.label}}</small></view></view>

        <label wx:if="{{loginMode !== 'admin' || adminCredentialType === 'account_password'}}" class="login-field"><text>账号</text><view><i>人</i><input data-key="username" value="{{form.username}}" bindinput="updateField" placeholder="请输入登录账号" autocomplete="username"/></view></label>
        <label class="login-field"><text>{{loginMode === 'admin' && adminCredentialType === 'access_code' ? '访问码' : '密码'}}</text><view><i>钥</i><input data-key="password" value="{{form.password}}" bindinput="updateField" password="{{!showPassword}}" placeholder="{{loginMode === 'admin' && adminCredentialType === 'access_code' ? '请输入中台访问码' : '请输入登录密码'}}" autocomplete="current-password"/><view class="password-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</view></view></label>
        <button class="login-button {{loading ? 'is-disabled' : ''}}" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">{{loading ? '正在建立安全会话…' : loginMode === 'admin' ? '进入中台工作台' : '进入协同工作台'}}</button>
        <view class="hermes-note"><view>H</view><text>Hermes 只查找当前账号获授权的订单；任何正式提交都需要你确认。</text></view>
      </view>
      <view class="footer-lock">⌾ 组织级数据隔离 · 登录与操作全程留痕</view>
    </view>
  </scroll-view>
</view>
