<view class="login-page hd-page {{loginMode === 'admin' ? 'login-page--admin' : ''}}">
  <view class="hd-bg"><view class="hd-blob hd-blob--blue lg-blob-blue"></view><view class="hd-blob {{loginMode === 'admin' ? 'hd-blob--teal' : 'hd-blob--orange lg-blob-orange'}}"></view><view class="hd-grid"></view></view>

  <view class="hd-nav hd-nav--clear" style="padding-top: {{statusBarHeight}}px">
    <view class="hd-nav__bar hd-nav__bar--center" style="height: {{navHeight}}px"><text class="hd-nav__center">{{loginMode === 'admin' ? '中台登录' : '伙伴登录'}}</text></view>
  </view>

  <scroll-view class="lg-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="lg-content" style="padding-top: {{statusBarHeight + navHeight}}px">
      <view class="lg-hero">
        <view class="lg-brand-row"><view class="lg-brand-tile">舟</view><view class="lg-brand-copy"><text class="lg-brand-name">同舟协同</text><text class="hd-mono lg-brand-sub">TONGZHOU · AI ASSISTANT</text></view></view>
        <view class="lg-hero-copy">
          <text class="hd-mono lg-hero-kicker">{{loginMode === 'admin' ? 'INTERNAL CONTROL' : 'ONE TASK · ONE BOUNDARY'}}</text>
          <view wx:if="{{loginMode === 'admin'}}" class="lg-hero-title">关键协同，<view></view>一处看清、<text class="lg-hero-accent lg-hero-accent--teal">及时决策。</text></view>
          <view wx:else class="lg-hero-title">每一次交接，<view></view>都清楚、准确、<text class="lg-hero-accent">有回音。</text></view>
          <text class="lg-hero-subtitle">{{loginMode === 'admin' ? '面向供应链中台管理员的移动监管与审批工作台' : '面向仓库、备案、打样、包装与生产伙伴的移动工作区'}}</text>
        </view>
        <view class="lg-handoff"><text class="lg-handoff-step">{{loginMode === 'admin' ? '跨组织总览' : '中台发布'}}</text><view class="lg-handoff-line"></view><text class="lg-handoff-step">{{loginMode === 'admin' ? '风险聚焦' : '组织执行'}}</text><view class="lg-handoff-line"></view><text class="lg-handoff-step">{{loginMode === 'admin' ? '审核留痕' : '凭证回传'}}</text></view>
      </view>

      <view class="login-card lg-card">
        <view class="lg-mode-switch">
          <view class="lg-mode-switch__thumb {{loginMode === 'admin' ? 'is-right' : ''}}"></view>
          <view class="lg-mode-switch__item {{loginMode === 'partner' ? 'is-active' : ''}}" data-mode="partner" bindtap="switchMode"><text class="lg-mode-switch__name">伙伴登录</text><text class="lg-mode-switch__note lg-mode-switch__note--orange">组织工作区</text></view>
          <view class="lg-mode-switch__item {{loginMode === 'admin' ? 'is-active' : ''}}" data-mode="admin" bindtap="switchMode"><text class="lg-mode-switch__name">中台登录</text><text class="lg-mode-switch__note lg-mode-switch__note--teal">监管与审批</text></view>
        </view>

        <view wx:if="{{loginMode === 'admin'}}" class="lg-credential-switch">
          <view class="lg-credential-chip {{adminCredentialType === 'account_password' ? 'is-active' : ''}}" data-type="account_password" bindtap="switchAdminCredential">账号密码</view>
          <view class="lg-credential-chip {{adminCredentialType === 'access_code' ? 'is-active' : ''}}" data-type="access_code" bindtap="switchAdminCredential">中台访问码</view>
          <text class="lg-internal-tag">内部账号</text>
        </view>
        <view wx:if="{{demoMode && loginMode === 'partner'}}" class="lg-demo-accounts"><view wx:for="{{demoAccounts}}" wx:key="username" class="lg-demo-chip {{form.username === item.username ? 'is-active' : ''}}" data-username="{{item.username}}" bindtap="chooseDemo">{{item.label}}</view></view>

        <view wx:if="{{loginMode !== 'admin' || adminCredentialType === 'account_password'}}" class="lg-field">
          <text class="lg-field__label">登录账号</text>
          <view class="lg-field__box"><input data-key="username" value="{{form.username}}" bindinput="updateField" placeholder="{{loginMode === 'admin' ? '请输入中台账号' : '请输入伙伴登录账号'}}" placeholder-class="lg-placeholder" confirm-type="next" autocomplete="username"/></view>
        </view>
        <view class="lg-field">
          <text class="lg-field__label">{{loginMode === 'admin' && adminCredentialType === 'access_code' ? '中台访问码' : '登录密码'}}</text>
          <view class="lg-field__box lg-field__box--secret"><input data-key="password" value="{{form.password}}" bindinput="updateField" password="{{!showPassword}}" confirm-type="done" bindconfirm="submit" placeholder="{{loginMode === 'admin' && adminCredentialType === 'access_code' ? '请输入中台访问码' : '请输入登录密码'}}" placeholder-class="lg-placeholder" autocomplete="current-password"/><view class="lg-password-toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</view></view>
        </view>
        <view wx:if="{{loginMode !== 'admin' || adminCredentialType === 'account_password'}}" class="lg-remember" bindtap="toggleRememberPassword">
          <view class="lg-check {{rememberPassword ? 'is-on' : ''}}"><view class="lg-check__tick"></view></view>
          <text class="lg-remember__label">记住密码</text>
          <text class="lg-remember__note">{{rememberPassword ? '仅保存在这台手机' : '账号会自动记住'}}</text>
        </view>

        <view class="lg-button {{loading ? 'is-loading' : ''}}" bindtap="submit"><view wx:if="{{loading}}" class="lg-spinner"></view><text>{{loading ? '正在建立安全会话…' : loginMode === 'admin' ? '进入中台工作台' : '进入协同工作台'}}</text></view>

        <block wx:if="{{loginMode === 'partner'}}">
          <view class="lg-or"><view class="lg-or__line"></view><text>或</text><view class="lg-or__line"></view></view>
          <view class="lg-wechat {{wechatLoading ? 'is-loading' : ''}}" bindtap="wechatLogin">
            <view wx:if="{{wechatLoading}}" class="lg-spinner lg-spinner--green"></view>
            <view wx:else class="lg-wechat__icon"><view class="lg-wechat__bubble lg-wechat__bubble--big"><view class="lg-wechat__eye"></view><view class="lg-wechat__eye"></view></view><view class="lg-wechat__bubble lg-wechat__bubble--small"><view class="lg-wechat__eye"></view><view class="lg-wechat__eye"></view></view></view>
            <text>{{wechatLoading ? '正在用微信登录…' : '微信一键登录'}}</text>
          </view>
          <text class="lg-wechat-note">第一次请先用账号密码登录，按提示绑定微信后，以后打开就自动登录。</text>
        </block>

        <view class="lg-hermes-note"><view class="hd-orb-mini"><view class="hd-orb-mini__core"><view class="hd-bot-mini"><view class="hd-bot-mini__visor"><view class="hd-bot-mini__eye"></view><view class="hd-bot-mini__eye"></view></view></view></view></view><text class="lg-hermes-note__text">{{loginMode === 'admin' ? '登录后，小助理会汇总跨组织风险与待审批事项，所有决策都会留痕。' : '登录后，小助理会先为你整理今日待填报的订单；任何正式提交都需要你确认。'}}</text></view>
        <view class="lg-footer-lock"><text class="lg-footer-lock__mark"></text>组织级数据隔离 · 登录与操作全程留痕</view>
      </view>
    </view>
  </scroll-view>
</view>
