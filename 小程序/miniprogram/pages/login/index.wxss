page{background:#050b19;color:#f6faff;font-family:"PingFang SC","Microsoft YaHei",sans-serif}.login-page{position:relative;min-height:100vh;overflow:hidden;background:radial-gradient(circle at 90% 9%,rgba(26,113,170,.26),transparent 36%),radial-gradient(circle at 5% 72%,rgba(94,43,154,.2),transparent 38%),linear-gradient(155deg,#07152d,#050a16 62%,#0d1023)}.login-grid{position:fixed;inset:0;opacity:.14;background-image:linear-gradient(rgba(119,171,220,.12) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(119,171,220,.12) 1rpx,transparent 1rpx);background-size:54rpx 54rpx}.login-aurora{position:fixed;width:520rpx;height:520rpx;border-radius:50%;filter:blur(100rpx);opacity:.2}.login-aurora--one{right:-250rpx;top:-230rpx;background:#1598c7}.login-aurora--two{left:-280rpx;bottom:-100rpx;background:#7043b5}.login-page--admin{background:radial-gradient(circle at 90% 10%,rgba(29,145,126,.23),transparent 36%),linear-gradient(155deg,#061724,#050b15 60%,#071b20)}.login-scroll{position:relative;z-index:2;height:100vh}.login-content{padding-left:34rpx;padding-right:34rpx;padding-bottom:55rpx}.brand-row{display:flex;align-items:center;gap:16rpx}.brand-row image{width:68rpx;height:68rpx;background:#fff;border-radius:19rpx;box-shadow:0 13rpx 34rpx rgba(0,4,15,.28)}.brand-row strong,.brand-row text{display:block}.brand-row strong{font-size:29rpx;letter-spacing:4rpx}.brand-row text{margin-top:5rpx;color:#66829e;font-size:14rpx;letter-spacing:2rpx}.hero-copy{margin-top:67rpx}.hero-kicker{color:#42cae2;font-size:15rpx;font-weight:900;letter-spacing:3rpx}.login-page--admin .hero-kicker{color:#60d0b8}.hero-title{margin-top:17rpx;white-space:pre-line;font-size:49rpx;font-weight:900;line-height:1.36;letter-spacing:-1rpx}.hero-subtitle{margin-top:17rpx;color:#91a9c1;font-size:21rpx}.handoff{margin-top:35rpx;display:flex;align-items:center}.handoff>view{display:flex;align-items:center;gap:8rpx;color:#91a7bd;font-size:16rpx;white-space:nowrap}.handoff i{width:29rpx;height:29rpx;display:flex;align-items:center;justify-content:center;color:#f7985e;background:rgba(242,105,36,.12);border:1rpx solid rgba(242,105,36,.2);border-radius:50%;font-style:normal;font-size:13rpx}.handoff b{flex:1;min-width:22rpx;height:1rpx;margin:0 9rpx;background:linear-gradient(90deg,rgba(69,196,220,.45),rgba(121,99,204,.18))}
.login-card{margin-top:43rpx;padding:23rpx;background:linear-gradient(145deg,rgba(20,39,68,.88),rgba(9,22,42,.87));border:1rpx solid rgba(142,181,219,.18);border-radius:27rpx;box-shadow:0 28rpx 80rpx rgba(0,3,12,.34),inset 0 1rpx rgba(255,255,255,.04);backdrop-filter:blur(30rpx);animation:rise .55s ease both}.mode-switch{height:72rpx;padding:5rpx;display:grid;grid-template-columns:1fr 1fr;gap:5rpx;background:rgba(255,255,255,.035);border:1rpx solid rgba(137,176,211,.11);border-radius:17rpx}.mode-switch view{display:flex;align-items:center;justify-content:center;color:#6d87a1;border-radius:13rpx;font-size:19rpx;font-weight:800}.mode-switch .is-active{color:#fff;background:linear-gradient(135deg,rgba(39,104,158,.62),rgba(55,65,139,.62));box-shadow:inset 0 0 0 1rpx rgba(90,191,220,.14)}.card-heading{margin-top:27rpx;display:flex;align-items:flex-end;justify-content:space-between}.card-heading text,.card-heading strong{display:block}.card-heading text{color:#f17e43;font-size:13rpx;font-weight:900;letter-spacing:2rpx}.card-heading strong{margin-top:6rpx;font-size:30rpx}.secure-tag{padding:7rpx 10rpx;display:flex;align-items:center;gap:7rpx;color:#57d5a5;background:rgba(62,205,151,.07);border:1rpx solid rgba(62,205,151,.15);border-radius:999rpx;font-size:14rpx}.secure-tag i{width:7rpx;height:7rpx;background:#57d5a5;border-radius:50%}.card-copy{margin-top:9rpx;color:#708aa4;font-size:17rpx}.credential-switch{height:62rpx;margin-top:19rpx;padding:4rpx;display:grid;grid-template-columns:1fr 1fr;gap:4rpx;background:rgba(255,255,255,.03);border-radius:13rpx}.credential-switch view{display:flex;align-items:center;justify-content:center;color:#69839d;border-radius:10rpx;font-size:17rpx}.credential-switch .is-active{color:#fff;background:rgba(37,112,147,.4)}.demo-accounts{margin-top:17rpx;display:grid;grid-template-columns:repeat(6,1fr);gap:6rpx}.demo-accounts view{padding:9rpx 2rpx;display:flex;flex-direction:column;align-items:center;gap:5rpx;color:#69819b;background:rgba(255,255,255,.025);border:1rpx solid rgba(137,174,210,.1);border-radius:10rpx}.demo-accounts view.is-active{color:#fff;border-color:rgba(54,195,219,.3);background:rgba(38,155,184,.13)}.demo-accounts text{font-size:19rpx;font-weight:900}.demo-accounts small{font-size:12rpx}
.login-field{display:block;margin-top:21rpx}.login-field>text{display:block;margin-bottom:8rpx;color:#7f99b2;font-size:16rpx}.login-field>view{height:78rpx;padding:0 14rpx;display:flex;align-items:center;gap:12rpx;background:rgba(255,255,255,.035);border:1rpx solid rgba(139,178,214,.15);border-radius:15rpx}.login-field i{width:34rpx;height:34rpx;display:flex;align-items:center;justify-content:center;color:#42c5db;background:rgba(50,189,212,.08);border-radius:10rpx;font-style:normal;font-size:13rpx}.login-field input{flex:1;height:70rpx;color:#f0f6fc;font-size:20rpx}.password-toggle{color:#5bc9dd;font-size:16rpx}.login-button{height:82rpx;margin-top:24rpx;color:#fff;background:linear-gradient(110deg,#f15e1c,#ff8d3c);border-radius:17rpx;box-shadow:0 14rpx 30rpx rgba(238,89,24,.25);font-size:22rpx;font-weight:900}.login-page--admin .login-button{background:linear-gradient(110deg,#138b78,#23b392);box-shadow:0 14rpx 30rpx rgba(31,167,139,.2)}.is-disabled{opacity:.5}.hermes-note{margin-top:20rpx;padding:16rpx;display:flex;align-items:center;gap:12rpx;color:#7f99b2;background:rgba(45,185,210,.045);border:1rpx solid rgba(52,188,211,.11);border-radius:14rpx;font-size:15rpx;line-height:1.55}.hermes-note view{flex:0 0 38rpx;height:38rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#28bed7,#5c62dc);border-radius:12rpx;font-size:14rpx;font-weight:900}.footer-lock{margin-top:25rpx;color:#4e6b87;font-size:14rpx;text-align:center;letter-spacing:.5rpx}@keyframes rise{from{opacity:0;transform:translateY(14rpx);filter:blur(5rpx)}to{opacity:1;transform:translateY(0);filter:blur(0)}}
