@import "../../styles/hermes-design.wxss";

/* 登录 — values follow the 750rpx Hermes v2 design frame. */
page { background: #070B1A; color: #EEF2FF; }
.hd-nav--clear { background: linear-gradient(180deg, rgba(7,11,26,.7), rgba(7,11,26,.2)); border-bottom: 0; }
.lg-blob-blue { width: 654rpx; height: 654rpx; top: -173rpx; left: auto; right: -231rpx; }
.lg-blob-orange { width: 538rpx; height: 538rpx; top: 346rpx; bottom: auto; left: -231rpx; opacity: .38; }
.lg-scroll { position: relative; z-index: 1; height: 100vh; }
.lg-content { padding-bottom: calc(62rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.lg-hero { padding: 15rpx 42rpx 50rpx; display: flex; flex-direction: column; gap: 35rpx; }
.lg-brand-row { display: flex; align-items: center; gap: 23rpx; }
.lg-brand-tile { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 27rpx; background: linear-gradient(160deg, rgba(255,255,255,.22), rgba(255,255,255,.06)); border: 1px solid rgba(255,255,255,.25); box-shadow: inset 0 1px 0 rgba(255,255,255,.3); color: #FF9A66; font-size: 42rpx; font-weight: 800; }
.login-page--admin .lg-brand-tile { color: #5CF0C8; }
.lg-brand-copy { display: flex; flex-direction: column; gap: 4rpx; }
.lg-brand-name { font-size: 37rpx; font-weight: 700; letter-spacing: 4rpx; color: #fff; }
.lg-brand-sub { font-size: 19rpx; letter-spacing: 1.5px; color: rgba(214,222,255,.62); }
.lg-hero-copy { display: flex; flex-direction: column; gap: 19rpx; }
.lg-hero-kicker { font-size: 21rpx; letter-spacing: 4rpx; color: #5CE1FF; }
.login-page--admin .lg-hero-kicker { color: #5CF0C8; }
.lg-hero-title { font-size: 54rpx; font-weight: 800; line-height: 1.35; color: #fff; }
.lg-hero-accent { color: #FF9A66; background: linear-gradient(90deg, #FF7A3D, #FFC08A); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.lg-hero-accent--teal { color: #5CF0C8; background: linear-gradient(90deg, #3DF0C0, #8FFFE0); -webkit-background-clip: text; background-clip: text; }
.lg-hero-subtitle { font-size: 25rpx; line-height: 1.55; color: rgba(214,222,255,.74); }
.lg-handoff { display: flex; align-items: center; gap: 15rpx; }
.lg-handoff-step { flex-shrink: 0; padding: 8rpx 19rpx; border-radius: 23rpx; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); font-size: 23rpx; color: rgba(214,222,255,.8); }
.lg-handoff-line { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(92,225,255,.1), #5CE1FF, rgba(92,225,255,.1)); }

.login-page .lg-card { margin: 0 23rpx; padding: 31rpx 31rpx 38rpx; display: flex; flex-direction: column; gap: 31rpx; border-radius: 54rpx; background: linear-gradient(160deg, rgba(255,255,255,.13), rgba(255,255,255,.04)); border: 1px solid rgba(255,255,255,.16); box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 58rpx 115rpx -38rpx rgba(0,0,0,.7); backdrop-filter: blur(54rpx) saturate(160%); -webkit-backdrop-filter: blur(54rpx) saturate(160%); animation: none; }
.lg-mode-switch { position: relative; height: 100rpx; display: flex; border-radius: 31rpx; background: rgba(0,0,0,.25); border: 1px solid rgba(255,255,255,.08); }
.lg-mode-switch__thumb { position: absolute; top: 8rpx; bottom: 8rpx; left: 8rpx; width: calc(50% - 8rpx); border-radius: 23rpx; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.2); box-shadow: inset 0 1px 0 rgba(255,255,255,.2); transition: left .35s cubic-bezier(.2,.8,.2,1); box-sizing: border-box; }
.lg-mode-switch__thumb.is-right { left: 50%; }
.lg-mode-switch__item { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; opacity: .55; transition: opacity .3s; }
.lg-mode-switch__item.is-active { opacity: 1; }
.lg-mode-switch__name { font-size: 27rpx; font-weight: 700; color: #fff; }
.lg-mode-switch__note { font-size: 19rpx; }
.lg-mode-switch__note--orange { color: #FF9A66; }
.lg-mode-switch__note--teal { color: #5CF0C8; }
.lg-credential-switch { display: flex; align-items: center; gap: 12rpx; }
.lg-credential-chip { padding: 12rpx 23rpx; border-radius: 27rpx; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); font-size: 23rpx; color: rgba(214,222,255,.75); }
.lg-credential-chip.is-active { background: rgba(61,240,192,.16); border-color: rgba(61,240,192,.35); color: #fff; }
.lg-internal-tag { margin-left: auto; padding: 10rpx 17rpx; border-radius: 23rpx; background: rgba(61,240,192,.14); border: 1px solid rgba(61,240,192,.3); font-size: 19rpx; color: #8FFFE0; }
.lg-demo-accounts { display: flex; flex-wrap: wrap; gap: 12rpx; }
.lg-demo-chip { padding: 10rpx 19rpx; border-radius: 23rpx; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); font-size: 21rpx; color: rgba(214,222,255,.7); }
.lg-demo-chip.is-active { border-color: rgba(92,225,255,.5); background: rgba(92,225,255,.14); color: #fff; }
.lg-field { display: flex; flex-direction: column; gap: 15rpx; }
.lg-field__label { font-size: 23rpx; color: rgba(214,222,255,.7); }
.lg-field__box { height: 96rpx; display: flex; align-items: center; gap: 15rpx; padding: 0 27rpx; border-radius: 31rpx; background: rgba(0,0,0,.25); border: 1px solid rgba(255,255,255,.12); box-sizing: border-box; }
.lg-field__box--secret { padding-right: 12rpx; }
.lg-field__box input { flex: 1; min-width: 0; height: 92rpx; color: #EEF2FF; font-size: 27rpx; }
.lg-placeholder { color: rgba(214,222,255,.45); }
.lg-password-toggle { flex-shrink: 0; padding: 15rpx 19rpx; border-radius: 19rpx; background: rgba(92,225,255,.08); font-size: 23rpx; color: #5CE1FF; }
.lg-button { height: 100rpx; display: flex; align-items: center; justify-content: center; gap: 15rpx; border-radius: 50rpx; background: linear-gradient(135deg, #FF6A2A, #FF9F5C); box-shadow: 0 27rpx 58rpx -19rpx rgba(255,106,42,.85); color: #fff; font-size: 29rpx; font-weight: 700; letter-spacing: 1px; }
.login-page--admin .lg-button { background: linear-gradient(135deg, #12B48E, #3DF0C0); box-shadow: 0 27rpx 58rpx -19rpx rgba(20,200,160,.75); }
.lg-button:active { transform: scale(.97); }
.lg-button.is-loading { opacity: .85; }
.lg-spinner { width: 31rpx; height: 31rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,.35); border-top-color: #fff; animation: lg-spin .7s linear infinite; box-sizing: border-box; }
.lg-hermes-note { display: flex; align-items: center; gap: 19rpx; padding: 23rpx; border-radius: 31rpx; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); }
.lg-hermes-note__text { font-size: 23rpx; line-height: 1.55; color: rgba(214,222,255,.78); }
.lg-footer-lock { display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 21rpx; color: rgba(214,222,255,.55); }
.lg-footer-lock__mark { width: 12rpx; height: 12rpx; border-radius: 50%; background: #3DDC97; box-shadow: 0 0 12rpx #3DDC97; }

@keyframes lg-spin { to { transform: rotate(360deg); } }

/* Remember password + WeChat quick login (2026-10-29). */
.lg-remember { display: flex; align-items: center; gap: 15rpx; margin-top: -8rpx; padding: 4rpx 4rpx; }
.lg-check { position: relative; flex-shrink: 0; width: 35rpx; height: 35rpx; border-radius: 12rpx; border: 1.5px solid rgba(214,222,255,.45); background: rgba(0,0,0,.2); box-sizing: border-box; }
.lg-check.is-on { border-color: transparent; background: linear-gradient(135deg, #FF6A2A, #FF9F5C); }
.login-page--admin .lg-check.is-on { background: linear-gradient(135deg, #12B48E, #3DF0C0); }
.lg-check__tick { display: none; position: absolute; left: 10rpx; top: 4rpx; width: 10rpx; height: 17rpx; border-right: 4rpx solid #fff; border-bottom: 4rpx solid #fff; transform: rotate(45deg); }
.lg-check.is-on .lg-check__tick { display: block; }
.lg-remember__label { font-size: 25rpx; color: #EEF2FF; }
.lg-remember__note { margin-left: auto; font-size: 21rpx; color: rgba(214,222,255,.5); }
.lg-or { display: flex; align-items: center; gap: 19rpx; margin: -8rpx 0; font-size: 21rpx; color: rgba(214,222,255,.45); }
.lg-or__line { flex: 1; height: 1px; background: rgba(255,255,255,.1); }
.lg-wechat { height: 96rpx; display: flex; align-items: center; justify-content: center; gap: 19rpx; border-radius: 48rpx; background: rgba(7,193,96,.14); border: 1px solid rgba(7,193,96,.45); color: #7FF0BE; font-size: 29rpx; font-weight: 600; }
.lg-wechat:active { transform: scale(.97); background: rgba(7,193,96,.22); }
.lg-wechat.is-loading { opacity: .85; }
.lg-wechat__icon { position: relative; width: 50rpx; height: 38rpx; }
.lg-wechat__bubble { position: absolute; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #07C160; }
.lg-wechat__bubble--big { left: 0; top: 0; width: 33rpx; height: 27rpx; gap: 8rpx; }
.lg-wechat__bubble--small { right: 0; bottom: 0; width: 25rpx; height: 21rpx; gap: 6rpx; border: 1.5px solid #13203a; background: #07C160; }
.lg-wechat__eye { width: 5rpx; height: 5rpx; border-radius: 50%; background: #0B1230; }
.lg-spinner--green { border-color: rgba(127,240,190,.35); border-top-color: #7FF0BE; }
.lg-wechat-note { margin-top: -12rpx; font-size: 21rpx; line-height: 1.5; text-align: center; color: rgba(214,222,255,.5); }
