<view class="page-shell home-page">
  <view class="assistant-shell">
    <view class="assistant-grid"></view>
    <view class="assistant-nav">
      <view class="assistant-brand">
        <view class="assistant-orb"><text>H</text><view class="assistant-online"></view></view>
        <view><strong>Hermes</strong><text>同舟供应链伙伴助手</text></view>
      </view>
      <view class="assistant-clock"><text>{{clockText}}</text><view>在线</view></view>
    </view>

    <view class="assistant-welcome">
      <view class="home-date">{{today}} · {{session.organization.name || '协同组织'}}</view>
      <view class="home-greeting">{{greeting}}，{{session.user.displayName || '伙伴'}}</view>
      <view class="home-guide">说一句、或拍张照，Hermes 帮你整理成反馈并提交。</view>
    </view>

    <view wx:if="{{isProduction && partnerAi && partnerAi.quickReportEnabled}}" class="hermes-command" bindtap="openHermesProgress">
      <view class="hermes-command__pulse"><view class="hermes-command__mic">●</view></view>
      <view class="hermes-command__copy"><strong>现在想汇报什么？</strong><text>长按说话或输入产品名称</text></view>
      <view class="hermes-command__arrow">›</view>
    </view>
    <view wx:else class="hermes-command hermes-command--readonly" bindtap="openTasks">
      <view class="hermes-command__pulse"><view class="hermes-command__mic">H</view></view>
      <view class="hermes-command__copy"><strong>{{profile.name}}</strong><text>查看本组织今天需要处理的协同任务</text></view>
      <view class="hermes-command__arrow">›</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="home-loading">
    <view class="skeleton skeleton-heading"></view>
    <view class="skeleton skeleton-panel"></view>
  </view>
  <view wx:elif="{{error}}" class="error-state card">
    <view class="state-symbol">!</view><view class="state-title">暂时无法读取工作台</view><view class="state-copy">{{error}}</view><button class="secondary-button button-small retry-button" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <view class="section-heading">
      <view><view class="section-kicker">TODAY</view><view class="section-title">今日待填报</view></view>
      <view class="section-count">{{hermesHome.activeCount || 0}} 项进行中</view>
    </view>

    <view class="today-panel card">
      <view wx:if="{{todayReportTasks.length}}">
        <view wx:for="{{todayReportTasks}}" wx:key="id" class="today-task" data-id="{{item.id}}" bindtap="openTodayTask">
          <view class="today-task__rail today-task__rail--{{item.tone}}"></view>
          <view class="today-task__body">
            <view class="today-task__meta"><view class="task-kind task-kind--{{item.tone}}">{{item.badge}}</view><text class="task-deadline task-deadline--{{item.deadlineTone}}">{{item.deadlineLabel}}</text></view>
            <view class="today-task__title">{{item.productName}}</view>
            <view class="today-task__reference"><text>{{item.referenceNo}}</text><text wx:if="{{item.quantityText}}">{{item.quantityText}}</text></view>
            <view class="today-task__progress"><view class="progress-track"><view style="width: {{item.progress || 0}}%;"></view></view><text>{{item.progressText}}</text></view>
          </view>
          <view class="today-task__action">{{item.actionLabel}}<text>›</text></view>
        </view>
      </view>
      <view wx:else class="today-empty"><view>✓</view><strong>今天没有待处理事项</strong><text>新任务到达后会出现在这里</text></view>
      <view class="today-panel__footer" bindtap="openTasks"><text>查看全部订单与任务</text><text>›</text></view>
    </view>

    <view class="metric-strip">
      <view wx:for="{{homeMetrics}}" wx:key="key" class="compact-metric compact-metric--{{item.tone}}">
        <view class="compact-metric__dot"></view><strong>{{item.value}}</strong><text>{{item.label}}</text>
      </view>
    </view>

    <block wx:if="{{isDeliveryMode && deliveryOverview}}">
      <view class="section-heading section-heading--compact">
        <view><view class="section-kicker">TIMELINE</view><view class="section-title">未来 14 天交期</view></view>
        <view class="section-count">{{deliveryOverview.alerts[1].value}} 项临期</view>
      </view>
      <scroll-view class="mini-timeline card" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="mini-timeline__row">
          <view wx:for="{{deliveryOverview.days}}" wx:key="key" class="mini-day {{deliveryOverview.focus === item.focus ? 'is-active' : ''}}" data-focus="{{item.focus}}" bindtap="selectDeliveryFocus">
            <small>{{item.weekday}}</small><strong>{{item.day}}</strong><view class="mini-day__signal {{item.count ? 'has-task' : ''}}"></view><text>{{item.count ? item.count + '单' : '—'}}</text>
          </view>
        </view>
      </scroll-view>
    </block>

    <view wx:if="{{hermesSuggestions.length}}" class="section-heading section-heading--compact">
      <view><view class="section-kicker">ASK HERMES</view><view class="section-title">一句话快捷处理</view></view>
    </view>
    <scroll-view wx:if="{{hermesSuggestions.length}}" class="suggestion-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="suggestion-row">
        <view wx:for="{{hermesSuggestions}}" wx:key="label" class="suggestion-chip" data-index="{{index}}" bindtap="runHermesSuggestion"><text>+</text>{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="section-heading section-heading--compact">
      <view><view class="section-kicker">WORKSPACE</view><view class="section-title">业务入口</view></view>
      <view class="section-count">{{profile.name}}</view>
    </view>
    <view class="workspace-grid">
      <view wx:for="{{quickActions}}" wx:key="label" class="workspace-action {{item.highlight ? 'is-primary' : ''}}" data-index="{{index}}" bindtap="openShortcut">
        <view class="workspace-action__icon">{{item.icon}}</view><view><strong>{{item.label}}</strong><text>{{item.highlight ? '优先处理' : '进入查看'}}</text></view><view class="workspace-action__arrow">›</view>
      </view>
    </view>

    <view class="boundary-note"><view>盾</view><text>当前只展示“{{session.organization.name}}”被授权的订单、任务和资料，所有操作均留痕。</text></view>
  </block>
  <tz-tab-bar active="index" unread="{{unread}}" theme="dark" />
</view>
