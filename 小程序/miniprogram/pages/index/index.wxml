<view class="hermes-page hd-page">
  <view class="hd-bg"><view class="hd-blob hd-blob--blue"></view><view class="hd-blob hd-blob--cyan"></view><view class="hd-blob hd-blob--orange"></view><view class="hd-grid"></view></view>

  <view class="hd-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="hd-nav__bar" style="height: {{navHeight}}px; padding-right: {{capsuleSpace}}px">
      <view class="hd-nav__brand"><text class="hd-nav__title">同舟小助理</text><text class="hd-nav__status {{hermes.ready ? '' : 'is-off'}}"><text class="hd-dot"></text>{{hermes.statusText}}</text></view>
      <view class="hd-icon-button {{loading ? 'is-busy' : ''}}" bindtap="refresh">↺</view>
    </view>
  </view>

  <scroll-view class="hd-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{statusBarHeight + navHeight}}px">
    <view class="hd-content">
      <view class="hd-hello">
        <view class="hd-orb"><view class="hd-orb__ring"></view><view class="hd-orb__glass"></view><view class="hd-orb__bot"><view class="hd-bot"><view class="hd-bot__antenna"><view class="hd-bot__bulb"></view></view><view class="hd-bot__visor"><view class="hd-bot__eyes"><view class="hd-bot__eye"></view><view class="hd-bot__eye"></view></view></view><view class="hd-bot__cheek hd-bot__cheek--l"></view><view class="hd-bot__cheek hd-bot__cheek--r"></view></view></view></view>
        <view class="hd-hello__copy">
          <view class="hd-hello__title">{{greeting}}，{{session.user.displayName || '伙伴'}}</view>
          <view class="hd-hello__text">{{hermes.ready ? '说一句、或拍张照，小助理帮你整理成反馈，你确认后才会提交。' : hermes.welcomeCopy}}</view>
        </view>
      </view>

      <view wx:if="{{loading && !todayReportTasks.length}}" class="hd-glass hd-state"><view class="hd-typing"><text></text><text></text><text></text></view><text>正在整理今天的任务…</text></view>
      <view wx:elif="{{error}}" class="hd-glass hd-state hd-state--error"><text class="hd-state__title">暂时无法读取工作台</text><text>{{error}}</text><view class="hd-pill-button" bindtap="load">重新加载</view></view>

      <block wx:else>
        <view class="hd-glass hd-today">
          <view class="hd-today__head" bindtap="openTasks">
            <view class="hd-today__title"><text class="hd-mono hd-kicker">TODAY</text><text class="hd-today__name">{{isWarehouse ? '今日待处理' : '今日待填报'}}</text><text class="hd-count">{{todayReportTasks.length}}</text></view>
            <text class="hd-link">全部 ›</text>
          </view>
          <view wx:if="{{todayReportTasks.length}}">
            <view wx:for="{{todayReportTasks}}" wx:key="id" class="hd-task" data-index="{{index}}" bindtap="openTodayTask">
              <view class="hd-tile hd-tile--{{item.tileTone}}">{{item.tileIcon}}</view>
              <view class="hd-task__main">
                <view class="hd-task__line"><text class="hd-badge hd-badge--{{item.deadlineTone}}">{{item.deadlineLabel}}</text><text class="hd-task__name">{{item.productName}}</text></view>
                <text class="hd-mono hd-task__ref">{{item.referenceNo}} · {{item.statusNote}}</text>
              </view>
              <view class="hd-task__action {{index === 0 ? 'is-primary' : ''}}">{{homeActionLabel}}</view>
            </view>
          </view>
          <view wx:else class="hd-empty"><text class="hd-empty__mark">✓</text><text class="hd-empty__title">今天没有待办事项</text><text>新任务到达后会在这里提醒你</text></view>
        </view>

        <view class="hd-metrics">
          <view wx:for="{{homeMetrics}}" wx:key="key" class="hd-metric hd-metric--{{item.tone}}"><text class="hd-mono hd-metric__value">{{item.value}}</text><text class="hd-metric__label">{{item.label}}</text></view>
        </view>

        <view wx:if="{{hermes.needsActivation}}" class="hd-glass hd-notice">
          <view class="hd-notice__icon">!</view>
          <view class="hd-notice__body"><text class="hd-notice__title">小助理快捷填报还没开通</text><text>{{hermes.cardText}}</text></view>
          <view class="hd-pill-button" bindtap="openTasks">去填写</view>
        </view>

        <block wx:if="{{!hermes.ready && !hermes.needsActivation && quickActions.length}}">
          <view class="hd-label"><text class="hd-dot hd-dot--cyan"></text>常用功能</view>
          <view class="hd-shortcuts">
            <view wx:for="{{quickActions}}" wx:key="label" class="hd-shortcut {{item.highlight ? 'is-highlight' : ''}}" data-index="{{index}}" bindtap="openShortcut">
              <view class="hd-shortcut__icon">{{item.icon}}</view><text>{{item.label}}</text>
            </view>
          </view>
        </block>

        <block wx:if="{{hermesSuggestions.length}}">
          <view class="hd-label"><text class="hd-dot hd-dot--cyan"></text>{{hermes.ready ? '试试这样说' : '快捷入口'}}</view>
          <view class="hd-chips">
            <view wx:for="{{hermesSuggestions}}" wx:key="label" class="hd-chip" data-index="{{index}}" bindtap="runHermesSuggestion">{{item.action === 'quick_report' ? '“' + item.label + '”' : item.label}}</view>
          </view>
        </block>
      </block>
    </view>
  </scroll-view>

  <view class="hd-dock {{hermes.ready ? '' : 'is-off'}}">
    <view class="composer">
      <view class="composer-plus" bindtap="choosePhoto">＋</view>
      <input value="{{composerText}}" disabled="{{!hermes.ready}}" bindinput="updateComposer" confirm-type="send" bindconfirm="sendComposer" placeholder="{{hermes.placeholder}}" placeholder-class="composer-placeholder" />
      <view wx:if="{{composerText}}" class="composer-voice" bindtap="sendComposer">发送</view>
      <view wx:else class="composer-voice" bindtap="startVoiceReport">语音</view>
      <view wx:if="{{!hermes.ready}}" class="composer-mask" bindtap="tapComposer"></view>
    </view>
  </view>
  <tz-tab-bar active="index" unread="{{unread}}" theme="glass" />
</view>
