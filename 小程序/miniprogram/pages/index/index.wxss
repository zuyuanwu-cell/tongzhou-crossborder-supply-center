page {
  background: #04060d;
  color: #eef2ff;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

.hermes-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at -10% 4%, rgba(47, 77, 255, .55), transparent 42%),
    radial-gradient(circle at 112% 52%, rgba(0, 184, 255, .34), transparent 38%),
    radial-gradient(circle at 32% 106%, rgba(255, 106, 42, .25), transparent 38%),
    #070b1a;
}

.grid-noise {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .2;
  background-image: linear-gradient(rgba(255, 255, 255, .035) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(255, 255, 255, .035) 1rpx, transparent 1rpx);
  background-size: 56rpx 56rpx;
  mask-image: linear-gradient(to bottom, #000, transparent 58%);
}

.aurora {
  position: fixed;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  filter: blur(180rpx);
  opacity: .22;
  pointer-events: none;
  animation: drift 14s ease-in-out infinite;
}

.aurora--one { top: -260rpx; left: -220rpx; background: #2f4dff; }
.aurora--two { right: -300rpx; top: 560rpx; background: #00b8ff; animation-direction: reverse; animation-duration: 16s; }

.hermes-header {
  position: relative;
  z-index: 5;
  min-height: 100rpx;
  padding-left: 32rpx;
  padding-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(255, 255, 255, .08);
  background: linear-gradient(180deg, rgba(7, 11, 26, .84), rgba(7, 11, 26, .42));
  backdrop-filter: blur(44rpx);
}

.hermes-brand strong,
.hermes-brand text { display: block; }
.hermes-brand strong { font-size: 32rpx; letter-spacing: 1rpx; }
.hermes-brand text { margin-top: 4rpx; display: flex; align-items: center; gap: 10rpx; color: rgba(214, 222, 255, .65); font-size: 20rpx; }
.hermes-brand i { width: 12rpx; height: 12rpx; background: #3ddc97; border-radius: 50%; box-shadow: 0 0 12rpx #3ddc97; animation: status-dot 2s infinite; }
.header-actions { display: flex; align-items: center; gap: 16rpx; }
.reset-button { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: #eef2ff; background: rgba(255, 255, 255, .06); border: 1rpx solid rgba(255, 255, 255, .18); border-radius: 50%; font-size: 30rpx; }
.menu-button { height: 64rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; gap: 18rpx; color: #eef2ff; background: rgba(255, 255, 255, .06); border: 1rpx solid rgba(255, 255, 255, .18); border-radius: 32rpx; letter-spacing: 3rpx; }
.menu-button b { width: 1rpx; height: 32rpx; background: rgba(255, 255, 255, .2); }

.home-scroll { position: relative; z-index: 2; height: calc(100vh - 336rpx - env(safe-area-inset-bottom)); }
.home-content { padding: 24rpx 32rpx 50rpx; }
.welcome-block { display: flex; align-items: center; gap: 28rpx; padding: 8rpx 8rpx 16rpx; animation: rise-in .6s cubic-bezier(.2, .8, .2, 1) both; }
.welcome-orb { position: relative; flex: 0 0 120rpx; width: 120rpx; height: 120rpx; border-radius: 50%; animation: breathe 4s ease-in-out infinite; }
.welcome-orb__ring { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, #5ce1ff, #3b5bff, #b26bff, #ff7a3d, #5ce1ff); animation: spin 6s linear infinite; }
.welcome-orb__core { position: absolute; inset: 6rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, .55), rgba(10, 16, 40, .35) 45%, rgba(7, 11, 26, .9) 100%); border-radius: 50%; font-size: 44rpx; font-weight: 900; }
.welcome-orb__pulse { position: absolute; inset: -2rpx; border: 2rpx solid rgba(92, 225, 255, .24); border-radius: 50%; animation: ring 2.4s ease-out infinite; }
.welcome-copybox { min-width: 0; }
.welcome-date { color: rgba(214, 222, 255, .52); font: 18rpx/1.3 "DIN Alternate", monospace; letter-spacing: 1rpx; }
.welcome-title { margin-top: 8rpx; font-size: 46rpx; font-weight: 800; letter-spacing: -1rpx; }
.welcome-copy { margin-top: 8rpx; color: rgba(214, 222, 255, .68); font-size: 25rpx; line-height: 1.55; }

.glass-card { background: linear-gradient(160deg, rgba(255, 255, 255, .12), rgba(255, 255, 255, .04)); border: 1rpx solid rgba(255, 255, 255, .14); border-radius: 44rpx; box-shadow: inset 0 1rpx rgba(255, 255, 255, .18), 0 20rpx 60rpx -20rpx rgba(0, 0, 0, .5); backdrop-filter: blur(48rpx); }
.loading-card { margin-top: 20rpx; padding: 56rpx 24rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; color: rgba(214, 222, 255, .62); }
.thinking-dots { display: flex; gap: 9rpx; }
.thinking-dots i { width: 10rpx; height: 10rpx; background: #5ce1ff; border-radius: 50%; animation: bounce 1s infinite; }
.thinking-dots i:nth-child(2) { animation-delay: .14s; }
.thinking-dots i:nth-child(3) { animation-delay: .28s; }
.error-card { margin-top: 20rpx; padding: 28rpx; }
.error-card strong, .error-card text { display: block; }
.error-card strong { color: #ff9a66; }
.error-card text { margin-top: 10rpx; color: rgba(214, 222, 255, .66); font-size: 20rpx; }
.error-card button { margin-top: 18rpx; color: #fff; background: linear-gradient(135deg, #3b5bff, #22a6ff); border-radius: 28rpx; font-size: 21rpx; }

.today-card { margin-top: 8rpx; padding: 22rpx 28rpx 8rpx; overflow: hidden; animation: rise-in .6s .1s cubic-bezier(.2, .8, .2, 1) both; }
.today-head { min-height: 48rpx; display: flex; align-items: center; justify-content: space-between; }
.today-head > view:first-child { display: flex; align-items: center; gap: 14rpx; }
.today-head text { color: #5ce1ff; font: 20rpx/1.2 "DIN Alternate", monospace; letter-spacing: 4rpx; }
.today-head strong { font-size: 28rpx; }
.today-head small { padding: 2rpx 14rpx; color: #ff9a66; background: rgba(255, 122, 61, .18); border-radius: 16rpx; font: 20rpx/1.5 monospace; }
.today-head > view:last-child { color: rgba(214, 222, 255, .6); font-size: 22rpx; }
.task-row { min-height: 112rpx; padding: 20rpx 0; display: grid; grid-template-columns: 68rpx minmax(0, 1fr) auto; align-items: center; gap: 18rpx; border-top: 1rpx solid rgba(255, 255, 255, .08); }
.task-symbol { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; color: #7ff0be; background: linear-gradient(135deg, rgba(61, 220, 151, .3), rgba(61, 220, 151, .06)); border: 1rpx solid rgba(61, 220, 151, .4); border-radius: 20rpx; font-size: 21rpx; font-weight: 900; }
.task-symbol--orange { color: #ffb08a; background: linear-gradient(135deg, rgba(255, 122, 61, .35), rgba(255, 122, 61, .08)); border-color: rgba(255, 140, 90, .4); }
.task-symbol--violet { color: #c1adff; background: linear-gradient(135deg, rgba(178, 107, 255, .3), rgba(178, 107, 255, .06)); border-color: rgba(178, 107, 255, .35); }
.task-main { min-width: 0; }
.task-top { display: flex; align-items: center; gap: 12rpx; }
.task-kind { color: rgba(214, 222, 255, .5); font-size: 17rpx; }
.deadline { padding: 3rpx 11rpx; color: rgba(214, 222, 255, .72); background: rgba(255, 255, 255, .1); border-radius: 10rpx; font-size: 16rpx; }
.deadline--danger { color: #ff8a96; background: rgba(255, 92, 108, .18); }
.deadline--warning { color: #ffb08a; background: rgba(255, 122, 61, .18); }
.task-main strong { display: block; margin-top: 7rpx; overflow: hidden; color: #eef2ff; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-reference { margin-top: 7rpx; display: flex; flex-wrap: wrap; gap: 10rpx; color: rgba(214, 222, 255, .55); font: 18rpx/1.3 "DIN Alternate", monospace; }
.task-action { height: 60rpx; padding: 0 26rpx; display: flex; align-items: center; color: #eef2ff; background: rgba(255, 255, 255, .06); border: 1rpx solid rgba(255, 255, 255, .22); border-radius: 30rpx; font-size: 21rpx; white-space: nowrap; }
.task-action.is-primary { color: #fff; background: linear-gradient(135deg, #3b5bff, #22a6ff); border-color: transparent; box-shadow: 0 8rpx 28rpx -8rpx rgba(59, 91, 255, .8); }
.empty-today { padding: 54rpx 20rpx; display: flex; flex-direction: column; align-items: center; color: rgba(214, 222, 255, .5); }
.empty-today view { width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; color: #082318; background: #3ddc97; border-radius: 50%; font-size: 28rpx; }
.empty-today strong { margin-top: 18rpx; color: #eef2ff; }
.empty-today text { margin-top: 8rpx; font-size: 18rpx; }

.metric-grid { margin-top: 20rpx; display: grid; grid-template-columns: repeat(4, 1fr); overflow: hidden; padding: 20rpx 0; background: rgba(255, 255, 255, .05); border: 1rpx solid rgba(255, 255, 255, .1); border-radius: 36rpx; backdrop-filter: blur(40rpx); animation: rise-in .6s .2s cubic-bezier(.2, .8, .2, 1) both; }
.metric-cell { position: relative; padding: 4rpx 8rpx; text-align: center; border-left: 1rpx solid rgba(255, 255, 255, .08); }
.metric-cell:first-child { border-left: 0; }
.metric-cell strong, .metric-cell text { display: block; }
.metric-cell strong { font: 600 39rpx/1.2 "DIN Alternate", monospace; }
.metric-cell text { margin-top: 4rpx; color: rgba(214, 222, 255, .58); font-size: 20rpx; }
.metric-cell i { display: none; }
.metric-cell--orange strong, .metric-cell--red strong { color: #ff9a66; }
.metric-cell--blue strong, .metric-cell--violet strong { color: #5ce1ff; }

.section-label { margin: 28rpx 3rpx 14rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.section-label text { display: block; color: rgba(214, 222, 255, .55); font-size: 20rpx; }
.section-label--quick i { display: inline-block; width: 10rpx; height: 10rpx; margin-right: 12rpx; background: #5ce1ff; border-radius: 50%; animation: status-dot 1.6s infinite; }
.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; animation: rise-in .6s .3s cubic-bezier(.2, .8, .2, 1) both; }
.quick-chip { min-height: 66rpx; padding: 0 26rpx; display: flex; align-items: center; color: #eef2ff; background: rgba(255, 255, 255, .07); border: 1rpx solid rgba(255, 255, 255, .14); border-radius: 36rpx; font-size: 23rpx; box-shadow: inset 0 1rpx rgba(255, 255, 255, .06); }
.boundary-line { margin: 28rpx 5rpx 0; display: flex; align-items: flex-start; gap: 12rpx; color: rgba(214, 222, 255, .45); font-size: 18rpx; line-height: 1.65; }
.boundary-line view { flex: 0 0 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; color: #7ff0be; border: 1rpx solid rgba(61, 220, 151, .3); border-radius: 50%; }

.composer { position: fixed; z-index: 110; left: 24rpx; right: 24rpx; bottom: calc(160rpx + env(safe-area-inset-bottom)); min-height: 112rpx; padding: 0 12rpx; display: flex; align-items: center; gap: 16rpx; background: rgba(255, 255, 255, .09); border: 1rpx solid rgba(255, 255, 255, .16); border-radius: 56rpx; box-shadow: inset 0 1rpx rgba(255, 255, 255, .15), 0 24rpx 60rpx -20rpx rgba(0, 0, 0, .6); backdrop-filter: blur(48rpx); }
.composer-plus { flex: 0 0 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; color: #eef2ff; background: rgba(255, 255, 255, .07); border-radius: 50%; font-size: 42rpx; }
.composer input { flex: 1; height: 88rpx; color: #eef2ff; font-size: 25rpx; }
.composer input::placeholder { color: rgba(214, 222, 255, .45); }
.composer-voice, .composer-send { flex: 0 0 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg, #ff6a2a, #ff9f5c); border-radius: 50%; box-shadow: 0 12rpx 36rpx -8rpx rgba(255, 106, 42, .9); font-size: 20rpx; font-weight: 800; }
.composer-send { flex-basis: 108rpx; border-radius: 44rpx; background: linear-gradient(135deg, #3b5bff, #22a6ff); box-shadow: 0 12rpx 36rpx -8rpx rgba(59, 91, 255, .8); }

@keyframes rise-in { from { opacity: 0; transform: translateY(28rpx) scale(.98); filter: blur(8rpx); } to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); } }
@keyframes bounce { 0%, 60%, 100% { transform: translateY(0); opacity: .45; } 30% { transform: translateY(-8rpx); opacity: 1; } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes breathe { 0%, 100% { box-shadow: 0 0 48rpx 4rpx rgba(92, 225, 255, .35); } 50% { box-shadow: 0 0 88rpx 20rpx rgba(255, 122, 61, .35); } }
@keyframes ring { 0% { transform: scale(1); opacity: .7; } 100% { transform: scale(1.45); opacity: 0; } }
@keyframes status-dot { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
@keyframes drift { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(60rpx, 80rpx); } }
