@import "../../styles/hermes-design.wxss";

/* Hermes 首页 v2 — values follow the 750rpx design frame. */
page { background: #070B1A; }
.hd-scroll { position: relative; z-index: 1; height: 100vh; box-sizing: border-box; }
.hd-content { padding: 27rpx 31rpx calc(338rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 27rpx; }

.hd-hello { display: flex; align-items: center; gap: 27rpx; }
.hd-orb { position: relative; flex-shrink: 0; width: 115rpx; height: 115rpx; border-radius: 50%; box-shadow: 0 0 46rpx 4rpx rgba(92,225,255,.35); }
.hd-orb__ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 50%; background: conic-gradient(#5CE1FF, #3B5BFF, #B26BFF, #FF7A3D, #5CE1FF); animation: hd-spin 6s linear infinite; }
.hd-orb__glass { position: absolute; left: 6rpx; top: 6rpx; right: 6rpx; bottom: 6rpx; border-radius: 50%; background: radial-gradient(circle at 32% 28%, rgba(255,255,255,.55), rgba(10,16,40,.35) 45%, rgba(7,11,26,.85) 100%); }
.hd-orb__bot { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; padding-top: 8rpx; box-sizing: border-box; }
.hd-hello__copy { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.hd-hello__title { font-size: 46rpx; font-weight: 700; letter-spacing: .2px; color: #fff; }
.hd-hello__text { font-size: 25rpx; line-height: 1.55; color: rgba(214,222,255,.72); }

.hd-state { padding: 35rpx 31rpx; display: flex; flex-direction: column; align-items: flex-start; gap: 15rpx; font-size: 25rpx; color: rgba(214,222,255,.72); }
.hd-state__title { font-size: 29rpx; font-weight: 700; color: #fff; }
.hd-state--error { border-color: rgba(255,140,90,.32); }
.hd-typing { display: flex; gap: 8rpx; }
.hd-typing text { width: 10rpx; height: 10rpx; border-radius: 50%; background: #5CE1FF; animation: hd-blink 1s infinite; }
.hd-typing text:nth-child(2) { animation-delay: .15s; }
.hd-typing text:nth-child(3) { animation-delay: .3s; }

.hd-today { padding: 27rpx 27rpx 8rpx; }
.hd-today__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.hd-today__title { display: flex; align-items: center; gap: 15rpx; }
.hd-today__name { font-size: 29rpx; font-weight: 700; color: #fff; }
.hd-task { display: flex; align-items: center; gap: 19rpx; padding: 21rpx 0; border-bottom: 1px solid rgba(255,255,255,.08); }
.hd-task:last-child { border-bottom: 0; }
.hd-tile { flex-shrink: 0; width: 65rpx; height: 65rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; font-size: 27rpx; font-weight: 700; }
.hd-tile--orange { color: #FFB08A; background: linear-gradient(135deg, rgba(255,122,61,.35), rgba(255,122,61,.08)); border: 1px solid rgba(255,140,90,.4); }
.hd-tile--green { color: #7FF0BE; background: linear-gradient(135deg, rgba(61,220,151,.3), rgba(61,220,151,.06)); border: 1px solid rgba(61,220,151,.4); }
.hd-tile--violet { color: #C9B6FF; background: linear-gradient(135deg, rgba(178,107,255,.32), rgba(178,107,255,.06)); border: 1px solid rgba(178,107,255,.4); }
.hd-tile--cyan { color: #8FEAFF; background: linear-gradient(135deg, rgba(92,225,255,.3), rgba(92,225,255,.06)); border: 1px solid rgba(92,225,255,.4); }
.hd-task__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.hd-task__line { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.hd-badge { flex-shrink: 0; padding: 1px 12rpx; border-radius: 10rpx; font-size: 19rpx; font-weight: 600; white-space: nowrap; }
.hd-badge--danger { background: rgba(255,92,108,.18); color: #FF8A96; }
.hd-badge--warning { background: rgba(255,122,61,.18); color: #FF9A66; }
.hd-badge--neutral { background: rgba(255,255,255,.1); color: rgba(214,222,255,.78); }
.hd-task__name { min-width: 0; overflow: hidden; font-size: 27rpx; font-weight: 600; color: #fff; white-space: nowrap; text-overflow: ellipsis; }
.hd-task__ref { overflow: hidden; font-size: 21rpx; color: rgba(214,222,255,.58); white-space: nowrap; text-overflow: ellipsis; }
.hd-task__action { flex-shrink: 0; height: 58rpx; padding: 0 25rpx; display: flex; align-items: center; border: 1px solid rgba(255,255,255,.22); border-radius: 29rpx; background: rgba(255,255,255,.06); color: #EEF2FF; font-size: 23rpx; }
.hd-task__action.is-primary { border-color: transparent; background: linear-gradient(135deg, #3B5BFF, #22A6FF); color: #fff; font-weight: 600; box-shadow: 0 8rpx 27rpx -8rpx rgba(59,91,255,.8); }
.hd-empty { padding: 31rpx 0 27rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: 23rpx; color: rgba(214,222,255,.6); }
.hd-empty__mark { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(61,220,151,.18); color: #7FF0BE; font-weight: 800; }
.hd-empty__title { font-size: 27rpx; font-weight: 600; color: #fff; }

.hd-metrics { display: flex; padding: 23rpx 0; border-radius: 35rpx; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); backdrop-filter: blur(38rpx); -webkit-backdrop-filter: blur(38rpx); }
.hd-metric { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; border-left: 1px solid rgba(255,255,255,.08); }
.hd-metric:first-child { border-left: 0; }
.hd-metric__value { font-size: 38rpx; font-weight: 600; color: #fff; }
.hd-metric__label { font-size: 21rpx; color: rgba(214,222,255,.62); white-space: nowrap; }
.hd-metric--orange .hd-metric__value { color: #FF9A66; }
.hd-metric--red .hd-metric__value { color: #5CE1FF; }

.hd-notice { padding: 25rpx 27rpx; display: flex; align-items: center; gap: 19rpx; background: linear-gradient(160deg, rgba(255,122,61,.16), rgba(255,255,255,.04)); border-color: rgba(255,140,90,.32); }
.hd-notice__icon { flex-shrink: 0; width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,122,61,.22); color: #FFB08A; font-weight: 800; }
.hd-notice__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; font-size: 23rpx; line-height: 1.5; color: rgba(255,214,196,.82); }
.hd-notice__title { font-size: 27rpx; font-weight: 700; color: #FFB08A; }

.hd-label { display: flex; align-items: center; gap: 12rpx; font-size: 23rpx; color: rgba(214,222,255,.6); }
.hd-chips { display: flex; flex-wrap: wrap; gap: 15rpx; }
.hd-chip { padding: 15rpx 25rpx; border-radius: 35rpx; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); font-size: 25rpx; color: #EEF2FF; }
.hd-chip:active { background: rgba(92,225,255,.14); border-color: rgba(92,225,255,.5); }
.hd-shortcuts { display: flex; flex-wrap: wrap; gap: 15rpx; }
.hd-shortcut { width: calc((100% - 46rpx) / 4); padding: 23rpx 0 19rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; border-radius: 31rpx; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); font-size: 23rpx; color: rgba(226,235,250,.85); white-space: nowrap; }
.hd-shortcut.is-highlight { border-color: rgba(92,225,255,.4); background: rgba(92,225,255,.1); }
.hd-shortcut__icon { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: rgba(92,225,255,.12); border: 1px solid rgba(92,225,255,.25); color: #8FEAFF; font-size: 25rpx; font-weight: 700; }

/* Bottom dock: composer above the floating tab bar. */
.hd-dock { position: fixed; z-index: 99; left: 23rpx; right: 23rpx; bottom: calc(177rpx + env(safe-area-inset-bottom)); }
.hd-dock::before { content: ""; position: absolute; left: -23rpx; right: -23rpx; top: -46rpx; bottom: -212rpx; background: linear-gradient(180deg, rgba(7,11,26,0), rgba(7,11,26,.85) 40%); pointer-events: none; }
.hd-dock .composer { position: relative; left: auto; right: auto; bottom: auto; height: 108rpx; min-height: 0; padding: 0 12rpx; display: flex; align-items: center; gap: 15rpx; overflow: hidden; border-radius: 54rpx; background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.16); box-shadow: inset 0 1px 0 rgba(255,255,255,.15), 0 23rpx 58rpx -19rpx rgba(0,0,0,.6); backdrop-filter: blur(46rpx) saturate(160%); -webkit-backdrop-filter: blur(46rpx) saturate(160%); }
.hd-dock .composer-plus { flex: 0 0 85rpx; width: 85rpx; height: 85rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.07); color: #EEF2FF; font-size: 42rpx; }
.hd-dock .composer input { flex: 1; min-width: 0; height: 85rpx; color: #EEF2FF; font-size: 27rpx; }
.hd-dock .composer-placeholder { color: rgba(214,222,255,.48); }
.hd-dock .composer-voice { flex: 0 0 85rpx; width: 85rpx; height: 85rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg, #FF6A2A, #FF9F5C); color: #fff; font-size: 25rpx; font-weight: 700; box-shadow: 0 12rpx 35rpx -8rpx rgba(255,106,42,.9); }
.hd-dock.is-off .composer { background: rgba(255,255,255,.05); }
.hd-dock.is-off .composer-plus,
.hd-dock.is-off .composer-voice { opacity: .4; box-shadow: none; }
.hd-dock .composer-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 2; }

@keyframes hd-spin { to { transform: rotate(360deg); } }
@keyframes hd-blink { 0%, 80%, 100% { opacity: .25; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-6rpx); } }
