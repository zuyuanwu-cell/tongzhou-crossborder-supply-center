page { background: #050b19; color: #f7fbff; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.hermes-page { position: relative; min-height: 100vh; overflow: hidden; background: radial-gradient(circle at 8% 14%,rgba(24,98,163,.24),transparent 38%),radial-gradient(circle at 90% 72%,rgba(74,35,143,.2),transparent 36%),linear-gradient(160deg,#071329 0%,#050a16 58%,#0b1022 100%); }
.grid-noise { position: fixed; inset: 0; pointer-events:none; opacity:.14; background-image:linear-gradient(rgba(118,175,225,.11) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(118,175,225,.11) 1rpx,transparent 1rpx); background-size:52rpx 52rpx; mask-image:linear-gradient(to bottom,#000,transparent 88%); }
.aurora { position: fixed; width: 520rpx; height: 520rpx; border-radius: 50%; filter: blur(90rpx); opacity: .22; pointer-events:none; }.aurora--one { top:-220rpx; right:-220rpx; background:#158fd0; }.aurora--two { left:-280rpx; bottom:150rpx; background:#6d37bd; }
.hermes-header { position:relative; z-index:5; min-height:92rpx; padding-left:30rpx; padding-right:30rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid rgba(147,190,227,.12); background:rgba(5,12,27,.72); backdrop-filter:blur(28rpx); }
.hermes-brand { display:flex; align-items:center; gap:15rpx; }.hermes-orb { position:relative; width:62rpx; height:62rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:linear-gradient(145deg,#1fd6e7,#5360e0 58%,#f47827); border:1rpx solid rgba(255,255,255,.28); border-radius:20rpx; box-shadow:0 0 34rpx rgba(34,190,225,.23); font-size:25rpx; font-weight:900; }.online-dot { position:absolute; right:-3rpx; top:-3rpx; width:14rpx; height:14rpx; background:#46dfa0; border:4rpx solid #091329; border-radius:50%; }
.hermes-brand strong,.hermes-brand text { display:block; }.hermes-brand strong { font-size:28rpx; letter-spacing:.5rpx; }.hermes-brand text { margin-top:4rpx; color:#7790ad; font-size:16rpx; }.header-actions { display:flex; align-items:center; gap:13rpx; }.live-pill { padding:9rpx 14rpx; display:flex; align-items:center; gap:8rpx; color:#6fe4b4; background:rgba(59,211,149,.08); border:1rpx solid rgba(59,211,149,.18); border-radius:999rpx; font-size:16rpx; }.live-pill i { width:8rpx; height:8rpx; background:#49dda1; border-radius:50%; box-shadow:0 0 12rpx #49dda1; }.menu-button { width:58rpx; height:54rpx; display:flex; align-items:center; justify-content:center; color:#93a9c4; background:rgba(255,255,255,.045); border:1rpx solid rgba(148,183,219,.14); border-radius:17rpx; letter-spacing:3rpx; }
.home-scroll { position:relative; z-index:2; height:calc(100vh - 292rpx - env(safe-area-inset-bottom)); }.home-content { padding:38rpx 28rpx 42rpx; }.welcome-block { animation:rise-in .5s ease both; }.welcome-date { color:#6e8aa8; font-size:17rpx; letter-spacing:1rpx; }.welcome-title { margin-top:14rpx; font-size:43rpx; font-weight:900; letter-spacing:-1rpx; }.welcome-copy { margin-top:11rpx; color:#a9bdd2; font-size:22rpx; line-height:1.7; }
.glass-card { background:linear-gradient(145deg,rgba(21,39,68,.78),rgba(11,23,44,.74)); border:1rpx solid rgba(142,182,220,.17); border-radius:24rpx; box-shadow:0 24rpx 70rpx rgba(0,3,12,.26),inset 0 1rpx rgba(255,255,255,.035); backdrop-filter:blur(28rpx); }
.loading-card { margin-top:34rpx; padding:48rpx 24rpx; display:flex; flex-direction:column; align-items:center; gap:20rpx; color:#90a8c2; }.thinking-dots { display:flex; gap:9rpx; }.thinking-dots i { width:10rpx; height:10rpx; background:#40cae1; border-radius:50%; animation:bounce 1s infinite; }.thinking-dots i:nth-child(2){animation-delay:.14s}.thinking-dots i:nth-child(3){animation-delay:.28s}.error-card { margin-top:30rpx; padding:28rpx; }.error-card strong,.error-card text { display:block; }.error-card strong { color:#ff9b88; }.error-card text { margin-top:10rpx;color:#aebed0;font-size:20rpx;}.error-card button{margin-top:18rpx;color:#fff;background:#f36a21;border-radius:14rpx;font-size:21rpx;}
.section-label { margin:40rpx 3rpx 16rpx; display:flex; align-items:flex-end; justify-content:space-between; }.section-label text,.section-label strong { display:block; }.section-label view>text { color:#38c7df; font-size:15rpx; font-weight:800; letter-spacing:3rpx; }.section-label strong { margin-top:6rpx; font-size:27rpx; }.section-total { display:flex; align-items:center; gap:12rpx; color:#fff; font-size:35rpx; font-weight:900; }.section-total text { color:#6f8ca8; font-size:17rpx; font-weight:500; letter-spacing:0; }
.today-card { overflow:hidden; animation:rise-in .5s .08s ease both; }.task-row { position:relative; min-height:144rpx; padding:22rpx 20rpx; display:grid; grid-template-columns:68rpx minmax(0,1fr) auto; align-items:center; gap:17rpx; border-top:1rpx solid rgba(144,183,218,.12); }.task-row:first-child{border-top:0}.task-row::after{content:"";position:absolute;left:0;top:21rpx;bottom:21rpx;width:3rpx;background:linear-gradient(#34cce1,#5b62df);border-radius:99rpx}.task-symbol { width:64rpx; height:64rpx; display:flex; align-items:center; justify-content:center; color:#6ee5ef; background:rgba(35,196,219,.1); border:1rpx solid rgba(62,202,222,.18); border-radius:19rpx; font-size:19rpx; font-weight:900; }.task-symbol--orange{color:#ffaf6f;background:rgba(245,111,32,.1)}.task-symbol--violet{color:#b9a1ff;background:rgba(124,89,221,.12)}
.task-main{min-width:0}.task-top{display:flex;align-items:center;gap:12rpx}.task-kind{color:#7695b4;font-size:17rpx}.deadline{padding:4rpx 10rpx;border-radius:999rpx;color:#8fa4bb;background:rgba(255,255,255,.05);font-size:15rpx}.deadline--danger{color:#ff8877;background:rgba(225,69,54,.1)}.deadline--warning{color:#ffc56c;background:rgba(244,161,43,.1)}.task-main strong{display:block;margin-top:9rpx;overflow:hidden;color:#f4f8fd;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}.task-reference{margin-top:9rpx;display:flex;gap:12rpx;color:#718aa5;font-size:16rpx}.task-action{padding-left:12rpx;color:#ebf6ff;font-size:18rpx;white-space:nowrap}.task-action text{margin-left:7rpx;color:#43c9df;font-size:28rpx}.empty-today{padding:54rpx 20rpx;display:flex;flex-direction:column;align-items:center;color:#718da8}.empty-today view{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;color:#54d5a0;background:rgba(60,211,149,.1);border-radius:50%;font-size:28rpx}.empty-today strong{margin-top:18rpx;color:#dce9f5}.empty-today text{margin-top:8rpx;font-size:18rpx}
.metric-grid { margin-top:18rpx; display:grid; grid-template-columns:repeat(4,1fr); overflow:hidden; background:rgba(13,27,50,.72); border:1rpx solid rgba(140,180,220,.15); border-radius:22rpx; animation:rise-in .5s .13s ease both; }.metric-cell{position:relative;padding:22rpx 8rpx 19rpx;text-align:center;border-left:1rpx solid rgba(140,180,220,.1)}.metric-cell:first-child{border-left:0}.metric-cell strong,.metric-cell text{display:block}.metric-cell strong{font-size:31rpx}.metric-cell text{margin-top:5rpx;color:#718ba6;font-size:15rpx}.metric-cell i{position:absolute;left:30%;right:30%;bottom:0;height:3rpx;background:#37cadf;border-radius:99rpx}.metric-cell--violet i{background:#8168e7}.metric-cell--orange i{background:#ef8b38}.metric-cell--red i{background:#dd5548}
.section-label--quick{margin-top:35rpx}.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.quick-chip{min-height:92rpx;padding:16rpx 18rpx;display:flex;align-items:center;gap:13rpx;color:#c5d5e5;background:rgba(17,33,58,.68);border:1rpx solid rgba(139,178,216,.14);border-radius:18rpx;font-size:19rpx}.quick-chip view{width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;color:#49d0e6;background:rgba(47,193,219,.09);border-radius:13rpx;font-weight:900}.boundary-line{margin:30rpx 5rpx 0;display:flex;align-items:flex-start;gap:12rpx;color:#5f7c9a;font-size:16rpx;line-height:1.65}.boundary-line view{flex:0 0 32rpx;height:32rpx;display:flex;align-items:center;justify-content:center;color:#47d59d;border:1rpx solid rgba(71,213,157,.2);border-radius:50%}
.composer { position:fixed; z-index:110; left:22rpx; right:22rpx; bottom:calc(112rpx + env(safe-area-inset-bottom)); min-height:88rpx; padding:10rpx; display:flex; align-items:center; gap:10rpx; background:rgba(12,24,44,.94); border:1rpx solid rgba(142,184,222,.2); border-radius:25rpx; box-shadow:0 20rpx 50rpx rgba(0,3,12,.42); backdrop-filter:blur(30rpx); }.composer-plus{flex:0 0 62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;color:#8da7c3;background:rgba(255,255,255,.05);border:1rpx solid rgba(151,185,218,.12);border-radius:19rpx;font-size:31rpx}.composer input{flex:1;height:64rpx;color:#f2f7fc;font-size:20rpx}.composer input::placeholder{color:#5d7690}.composer-voice,.composer-send{flex:0 0 104rpx;height:64rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;color:#fff;background:linear-gradient(110deg,#f45b19,#ff8b38);border-radius:19rpx;box-shadow:0 10rpx 24rpx rgba(240,88,23,.22);font-size:19rpx;font-weight:800}.composer-voice i{width:7rpx;height:23rpx;border-left:3rpx solid #fff;border-right:3rpx solid #fff;border-radius:99rpx}.composer-send{background:linear-gradient(110deg,#1daecb,#5368df)}
@keyframes rise-in{from{opacity:0;transform:translateY(14rpx);filter:blur(5rpx)}to{opacity:1;transform:translateY(0);filter:blur(0)}}@keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.45}30%{transform:translateY(-8rpx);opacity:1}}
