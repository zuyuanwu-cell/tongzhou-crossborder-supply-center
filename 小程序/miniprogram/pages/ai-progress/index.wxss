page{background:#050b19;color:#f5f9fd;font-family:"PingFang SC","Microsoft YaHei",sans-serif}.assistant-page{position:relative;min-height:100vh;overflow:hidden;background:radial-gradient(circle at 90% 8%,rgba(18,118,174,.24),transparent 34%),radial-gradient(circle at 6% 70%,rgba(86,42,152,.19),transparent 36%),linear-gradient(160deg,#071328,#050a16 60%,#0b1021)}.grid-noise{position:fixed;inset:0;pointer-events:none;opacity:.12;background-image:linear-gradient(rgba(116,169,218,.12) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(116,169,218,.12) 1rpx,transparent 1rpx);background-size:52rpx 52rpx}.aurora{position:fixed;width:460rpx;height:460rpx;border-radius:50%;filter:blur(90rpx);opacity:.2}.aurora--a{right:-220rpx;top:-180rpx;background:#178fc3}.aurora--b{left:-230rpx;bottom:180rpx;background:#6e40b8}
.assistant-header{position:relative;z-index:20;min-height:92rpx;padding-left:24rpx;padding-right:24rpx;display:grid;grid-template-columns:60rpx 1fr 60rpx;align-items:center;border-bottom:1rpx solid rgba(142,183,221,.13);background:rgba(5,12,26,.82);backdrop-filter:blur(28rpx)}.back-button,.reset-button{width:54rpx;height:54rpx;display:flex;align-items:center;justify-content:center;color:#90a9c4;background:rgba(255,255,255,.04);border:1rpx solid rgba(144,184,220,.14);border-radius:17rpx;font-size:37rpx}.reset-button{font-size:26rpx}.assistant-id{display:flex;align-items:center;justify-content:center;gap:13rpx}.assistant-orb{position:relative;width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#20c9e0,#5962df 58%,#f37524);border-radius:19rpx;font-size:23rpx;font-weight:900;box-shadow:0 0 28rpx rgba(42,191,220,.2)}.assistant-orb view{position:absolute;right:-2rpx;top:-2rpx;width:12rpx;height:12rpx;background:#44db9d;border:4rpx solid #09142a;border-radius:50%}.assistant-id strong,.assistant-id text{display:block}.assistant-id strong{font-size:26rpx}.assistant-id text{margin-top:3rpx;color:#718ca8;font-size:15rpx}
.chat-scroll{position:relative;z-index:2;height:calc(100vh - 292rpx - env(safe-area-inset-bottom))}.chat-content{padding:30rpx 26rpx 50rpx}.conversation-date{margin-bottom:25rpx;color:#526f8c;font-size:15rpx;text-align:center}.message{margin:17rpx 0;display:flex;align-items:flex-end;gap:11rpx;animation:rise .5s ease both}.message--user{justify-content:flex-end}.mini-orb{flex:0 0 43rpx;height:43rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:linear-gradient(145deg,#23c1d9,#5e5dd6);border-radius:14rpx;font-size:17rpx;font-weight:900}.message-body{max-width:78%;padding:17rpx 20rpx;color:#c8d8e8;background:rgba(20,38,66,.78);border:1rpx solid rgba(140,180,219,.15);border-radius:20rpx 20rpx 20rpx 5rpx;font-size:21rpx;line-height:1.65}.message--user .message-body{color:#fff;background:linear-gradient(135deg,#133e72,#1e558a);border-color:rgba(75,157,215,.24);border-radius:20rpx 20rpx 5rpx 20rpx}.message-photo{display:block;width:320rpx;height:230rpx;margin:-8rpx -10rpx 12rpx;border-radius:14rpx}.thinking-card{position:relative;min-width:310rpx;padding:20rpx;display:flex;align-items:center;gap:16rpx;overflow:hidden;color:#89a3bd;background:rgba(17,34,61,.82);border:1rpx solid rgba(139,180,218,.16);border-radius:20rpx;font-size:18rpx}.thinking-halo{position:absolute;right:-35rpx;top:-45rpx;width:110rpx;height:110rpx;border:1rpx solid rgba(49,202,224,.16);border-radius:50%;animation:spin 3.5s linear infinite}.thinking-dots{display:flex;gap:7rpx}.thinking-dots i{width:8rpx;height:8rpx;background:#42cee3;border-radius:50%;animation:bounce 1s infinite}.thinking-dots i:nth-child(2){animation-delay:.14s}.thinking-dots i:nth-child(3){animation-delay:.28s}
.inline-error,.inline-warning{margin:18rpx 0;padding:21rpx;display:flex;align-items:center;justify-content:space-between;gap:14rpx;border-radius:18rpx}.inline-error{color:#ffaea0;background:rgba(184,55,43,.11);border:1rpx solid rgba(226,91,76,.22)}.inline-warning{color:#ffd292;background:rgba(202,126,33,.1);border:1rpx solid rgba(230,159,70,.2)}.inline-error strong,.inline-error text,.inline-warning strong,.inline-warning text{display:block}.inline-error text,.inline-warning text{margin-top:5rpx;font-size:17rpx;line-height:1.5}.inline-error button,.inline-warning button{flex:0 0 auto;padding:0 16rpx;height:58rpx;color:inherit;background:rgba(255,255,255,.05);border-radius:12rpx;font-size:18rpx}
.assistant-block{margin-top:24rpx}.block-label{margin:0 3rpx 13rpx;display:flex;align-items:flex-end;gap:12rpx}.block-label text,.block-label strong{display:block}.block-label text{color:#3ecbe1;font-size:14rpx;letter-spacing:2rpx}.block-label strong{font-size:23rpx}.block-label small{margin-left:auto;color:#69839e;font-size:16rpx}.order-card{margin-top:11rpx;padding:17rpx;display:grid;grid-template-columns:84rpx minmax(0,1fr) auto;align-items:center;gap:15rpx;background:linear-gradient(145deg,rgba(22,41,70,.88),rgba(11,24,46,.8));border:1rpx solid rgba(139,181,219,.17);border-radius:20rpx}.order-card image{width:84rpx;height:84rpx;background:#fff;border-radius:14rpx}.order-card__main{min-width:0}.order-card__main strong,.order-card__main text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.order-card__main strong{font-size:21rpx}.order-card__main text{margin-top:6rpx;color:#7790aa;font-size:15rpx}.order-card button{height:58rpx;padding:0 16rpx;color:#fff;background:#f36b23;border-radius:13rpx;font-size:18rpx}
.draft-card,.exception-card{overflow:hidden;background:linear-gradient(145deg,rgba(20,39,68,.92),rgba(10,23,44,.9));border:1rpx solid rgba(141,182,220,.19);border-radius:25rpx;box-shadow:0 25rpx 65rpx rgba(0,3,12,.28)}.draft-head{padding:21rpx 22rpx 18rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid rgba(142,181,217,.13)}.draft-head text,.draft-head strong{display:block}.draft-head text{color:#f1874c;font-size:14rpx;font-weight:800;letter-spacing:2rpx}.draft-head strong{margin-top:5rpx;font-size:24rpx}.draft-state{padding:6rpx 12rpx;color:#ffd18c;background:rgba(237,157,52,.1);border:1rpx solid rgba(237,157,52,.2);border-radius:999rpx;font-size:15rpx}.product-strip{padding:18rpx 22rpx;display:flex;align-items:center;gap:15rpx;background:rgba(255,255,255,.018)}.product-strip image{width:78rpx;height:78rpx;background:#fff;border-radius:14rpx}.product-strip strong,.product-strip text{display:block}.product-strip strong{font-size:21rpx}.product-strip text{margin-top:6rpx;color:#758da6;font-size:15rpx}
.process-list{padding:8rpx 22rpx}.process-row{position:relative;min-height:74rpx;display:grid;grid-template-columns:44rpx minmax(0,1fr) auto;align-items:center;gap:12rpx}.process-row:not(:last-child)::after{content:"";position:absolute;left:21rpx;top:57rpx;bottom:-17rpx;width:1rpx;background:rgba(124,162,198,.18)}.process-node{width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;color:#68839e;background:rgba(255,255,255,.04);border:1rpx solid rgba(132,174,211,.16);border-radius:50%;font-size:15rpx;font-weight:900}.process-row.is-done .process-node{color:#071b20;background:#4ed7a1;border-color:#4ed7a1}.process-row.is-current .process-node{color:#fff;background:#f47228;border-color:#f47228;box-shadow:0 0 0 7rpx rgba(244,114,40,.08)}.process-copy strong{display:block;font-size:18rpx}.process-progress{height:5rpx;margin-top:8rpx;overflow:hidden;background:rgba(255,255,255,.06);border-radius:99rpx}.process-progress view{height:100%;background:linear-gradient(90deg,#f06725,#ffad57);border-radius:99rpx;animation:grow .7s ease both}.process-row>text{color:#7891aa;font-size:15rpx}.process-row.is-done>text{color:#56d3a1}.process-row.is-current>text{color:#ffaf72}
.draft-fields{margin:10rpx 22rpx 20rpx;display:grid;grid-template-columns:1fr 1fr;gap:10rpx}.draft-fields>view{padding:15rpx;background:rgba(255,255,255,.025);border:1rpx solid rgba(134,174,211,.11);border-radius:14rpx}.draft-fields text,.draft-fields strong{display:block}.draft-fields text{color:#6f89a3;font-size:14rpx}.draft-fields strong{margin-top:5rpx;font-size:19rpx}.question-callout,.exception-callout{margin:0 22rpx 18rpx;padding:16rpx;display:flex;align-items:center;gap:12rpx;border-radius:15rpx}.question-callout{color:#a7c5db;background:rgba(37,176,207,.07);border:1rpx solid rgba(48,190,215,.14)}.question-callout view{width:36rpx;height:36rpx;display:flex;align-items:center;justify-content:center;color:#fff;background:#2abbd3;border-radius:11rpx;font-size:14rpx;font-weight:900}.question-callout text{font-size:17rpx}.exception-callout{display:block;color:#ffad9e;background:rgba(184,54,43,.1);border:1rpx solid rgba(224,88,73,.2)}.exception-callout strong,.exception-callout text{display:block}.exception-callout text{margin-top:6rpx;font-size:16rpx;line-height:1.5}.exception-callout button{margin-top:12rpx;height:57rpx;color:#fff;background:#b43e31;border-radius:12rpx;font-size:17rpx}
.edit-panel{margin:0 22rpx 18rpx;padding:16rpx;display:grid;grid-template-columns:1fr 1fr;gap:12rpx;background:rgba(4,12,27,.42);border:1rpx solid rgba(129,170,207,.13);border-radius:17rpx}.edit-field text{display:block;margin-bottom:7rpx;color:#718ca6;font-size:14rpx}.edit-field input,.edit-field picker view{height:64rpx;padding:0 13rpx;display:flex;align-items:center;justify-content:space-between;color:#e8f2fa;background:rgba(255,255,255,.04);border:1rpx solid rgba(139,178,216,.14);border-radius:11rpx;font-size:18rpx}.edit-note{grid-column:1/-1}.edit-note textarea{width:100%;min-height:70rpx;padding:13rpx;color:#e8f2fa;background:rgba(255,255,255,.04);border:1rpx solid rgba(139,178,216,.14);border-radius:11rpx;font-size:18rpx}.draft-actions{padding:0 22rpx 22rpx;display:grid;grid-template-columns:.65fr 1.35fr;gap:11rpx}.draft-actions button{height:72rpx;border-radius:15rpx;font-size:20rpx;font-weight:800}.ghost-button{color:#90a9c2;background:rgba(255,255,255,.04);border:1rpx solid rgba(142,181,217,.15)}.submit-button{color:#fff;background:linear-gradient(110deg,#f15d1c,#ff8733);box-shadow:0 12rpx 25rpx rgba(241,91,25,.2)}.is-disabled{opacity:.48}.submitted-line{margin:0 22rpx 22rpx;padding:15rpx;display:flex;align-items:center;gap:10rpx;color:#61d7aa;background:rgba(63,208,151,.07);border:1rpx solid rgba(63,208,151,.14);border-radius:15rpx}.submitted-line view{font-weight:900}.submitted-line text{font-size:17rpx}.submitted-line button{margin-left:auto;color:#8ebbd5;background:transparent;font-size:16rpx}
.exception-card{padding:21rpx}.exception-head{display:flex;align-items:center;justify-content:space-between}.exception-head text,.exception-head strong{display:block}.exception-head text{color:#ff8f76;font-size:14rpx;font-weight:800;letter-spacing:2rpx}.exception-head strong{margin-top:5rpx;font-size:22rpx}.exception-head image{width:82rpx;height:82rpx;border-radius:14rpx}.option-label{margin-top:19rpx;color:#7891aa;font-size:15rpx}.option-row{margin-top:9rpx;display:flex;gap:8rpx}.option-chip{flex:1;padding:13rpx 5rpx;color:#7891aa;background:rgba(255,255,255,.03);border:1rpx solid rgba(135,175,212,.12);border-radius:12rpx;font-size:15rpx;text-align:center}.option-chip.is-active{color:#fff;background:rgba(241,99,40,.17);border-color:rgba(241,112,54,.38)}.exception-summary{margin-top:17rpx;padding:15rpx;display:grid;grid-template-columns:1fr 1fr;background:rgba(255,255,255,.025);border-radius:13rpx}.exception-summary>view+view{padding-left:15rpx;border-left:1rpx solid rgba(140,180,216,.12)}.exception-summary text,.exception-summary strong{display:block}.exception-summary text{color:#6d86a0;font-size:14rpx}.exception-summary strong{margin-top:5rpx;font-size:17rpx}.exception-submit{height:72rpx;margin-top:16rpx;color:#fff;background:linear-gradient(110deg,#c74435,#ef6e3b);border-radius:15rpx;font-size:19rpx;font-weight:800}.manual-entry{margin:27rpx 0 0;color:#5d7895;font-size:16rpx;text-align:center}.manual-entry text{margin-left:7rpx;color:#58bfd4}.chat-spacer{height:30rpx}
.voice-overlay{position:fixed;z-index:115;left:50%;bottom:calc(216rpx + env(safe-area-inset-bottom));transform:translateX(-50%);padding:22rpx 29rpx;display:flex;flex-direction:column;align-items:center;color:#d9e9f5;background:rgba(9,20,38,.94);border:1rpx solid rgba(75,205,224,.23);border-radius:24rpx;box-shadow:0 20rpx 55rpx rgba(0,3,12,.4);backdrop-filter:blur(25rpx)}.voice-ring{width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid rgba(71,208,226,.35);border-radius:50%;animation:pulse 1.25s infinite}.voice-ring view{color:#50d0e3}.wave{height:42rpx;margin-top:13rpx;display:flex;align-items:center;gap:5rpx}.wave i{width:5rpx;height:16rpx;background:#49cde1;border-radius:99rpx;animation:wave .8s infinite alternate}.wave i:nth-child(2),.wave i:nth-child(6){animation-delay:.12s}.wave i:nth-child(3),.wave i:nth-child(5){animation-delay:.25s}.wave i:nth-child(4){animation-delay:.38s}.voice-overlay text{font-size:15rpx;color:#7f9ab4}
.chat-composer{position:fixed;z-index:120;left:22rpx;right:22rpx;bottom:calc(112rpx + env(safe-area-inset-bottom));min-height:88rpx;padding:10rpx;display:flex;align-items:center;gap:10rpx;background:rgba(11,23,43,.95);border:1rpx solid rgba(142,182,220,.2);border-radius:25rpx;box-shadow:0 20rpx 50rpx rgba(0,3,12,.42);backdrop-filter:blur(30rpx)}.composer-plus{flex:0 0 62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;color:#8ca7c2;background:rgba(255,255,255,.05);border:1rpx solid rgba(145,181,216,.13);border-radius:19rpx;font-size:31rpx}.chat-composer input{flex:1;height:64rpx;color:#eef6fd;font-size:19rpx}.voice-control,.send-control{flex:0 0 104rpx;height:64rpx;display:flex;align-items:center;justify-content:center;gap:7rpx;color:#fff;background:linear-gradient(110deg,#f45e1b,#ff8a38);border-radius:19rpx;font-size:18rpx;font-weight:800}.send-control{background:linear-gradient(110deg,#20b7d2,#5267df)}.voice-control i{width:7rpx;height:22rpx;border-left:3rpx solid #fff;border-right:3rpx solid #fff;border-radius:99rpx}.voice-control.is-active{background:#bb3b31}
@keyframes rise{from{opacity:0;transform:translateY(14rpx);filter:blur(5rpx)}to{opacity:1;transform:translateY(0);filter:blur(0)}}@keyframes bounce{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-7rpx);opacity:1}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes grow{from{width:0}}@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(65,204,225,.25)}to{box-shadow:0 0 0 24rpx rgba(65,204,225,0)}}@keyframes wave{from{height:10rpx}to{height:40rpx}}
