.ai-page { padding-top: 0; }
.ai-hero { margin: 0 -28rpx 24rpx; padding: 44rpx 34rpx 48rpx; color: #fff; background: radial-gradient(circle at 100% 0, rgba(36,164,209,.35), transparent 330rpx), linear-gradient(140deg, #0b2b55, #17538a); }
.ai-hero .eyebrow { color: #78d7ef; }.ai-hero__title { margin-top: 16rpx; font-size: 45rpx; font-weight: 900; }.ai-hero__copy { margin-top: 14rpx; color: #c6daed; font-size: 23rpx; line-height: 1.7; }
.loading-card { padding: 50rpx 24rpx; color: #6d7f95; text-align: center; }
.step-track { padding: 20rpx 12rpx; display: grid; grid-template-columns: repeat(5, 1fr); }
.step-item { display: flex; flex-direction: column; align-items: center; gap: 9rpx; color: #9aa7b7; font-size: 17rpx; text-align: center; }
.step-dot { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; background: #edf1f6; border-radius: 50%; font-weight: 800; }
.step-item.is-active { color: #173d7a; font-weight: 800; }.step-item.is-active .step-dot { color: #fff; background: #173d7a; box-shadow: inset 0 -5rpx #f45b0b; }
.error-banner,.warning-banner { margin-top: 18rpx; padding: 22rpx; display: flex; align-items: center; gap: 16rpx; border-radius: 16rpx; }
.error-banner { color: #9f2d22; background: #fff0ed; border: 1rpx solid #efc2bb; }.error-banner > text { font-weight: 900; }
.warning-banner { justify-content: space-between; color: #765014; background: #fff7e6; border: 1rpx solid #efd7a7; }.warning-banner strong,.warning-banner text { display: block; }.warning-banner text { margin-top: 5rpx; font-size: 19rpx; }
.conversation { margin-top: 22rpx; }.bubble { width: max-content; max-width: 88%; margin-top: 14rpx; padding: 18rpx 22rpx; border-radius: 18rpx; font-size: 23rpx; line-height: 1.6; }
.bubble--user { margin-left: auto; color: #fff; background: #173d7a; border-bottom-right-radius: 5rpx; }.bubble--assistant { color: #263d5d; background: #fff; border: 1rpx solid #dfe6ef; border-bottom-left-radius: 5rpx; }
.input-card { margin-top: 22rpx; padding: 25rpx; }.input-card__prompt { color: #173d7a; font-size: 28rpx; font-weight: 800; }
.message-input { width: 100%; min-height: 128rpx; margin-top: 18rpx; padding: 20rpx; background: #f7f9fc; border: 1rpx solid #d7e1ec; border-radius: 15rpx; font-size: 25rpx; }
.input-actions { margin-top: 16rpx; display: flex; gap: 14rpx; }.input-actions button { flex: 1; }.voice-button { min-height: 82rpx; color: #173d7a; background: #edf4fb; border: 1rpx solid #c9d9e8; border-radius: 15rpx; font-size: 23rpx; font-weight: 800; }.voice-button.is-recording { color: #fff; background: #b42318; }.send-button { min-height: 82rpx; font-size: 25rpx; }
.manual-search-button { margin-top: 14rpx; color: #62748b; background: transparent; font-size: 20rpx; }
.candidate-card { margin-bottom: 16rpx; padding: 20rpx; display: grid; grid-template-columns: 100rpx minmax(0,1fr) auto; align-items: center; gap: 18rpx; }.candidate-image { width: 100rpx; height: 100rpx; background: #edf1f5; border-radius: 15rpx; }.candidate-copy { min-width: 0; }.candidate-copy strong,.candidate-copy text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.candidate-copy strong { color: #173d7a; font-size: 25rpx; }.candidate-copy text { margin-top: 7rpx; color: #75859a; font-size: 18rpx; }.candidate-confirm { min-height: 68rpx; padding: 0 17rpx; color: #fff; background: #f45b0b; border-radius: 13rpx; font-size: 21rpx; font-weight: 800; }
.confirmed-order { margin-top: 22rpx; padding: 20rpx; display: flex; align-items: center; gap: 18rpx; border-color: #a9d9c3; background: #f2fbf7; }.confirmed-order image { width: 86rpx; height: 86rpx; border-radius: 13rpx; background: #fff; }.confirmed-order strong,.confirmed-order text { display: block; }.confirmed-order strong { margin-top: 8rpx; color: #154e39; font-size: 25rpx; }.confirmed-order text { margin-top: 6rpx; color: #628071; font-size: 19rpx; }
.progress-card { margin-top: 22rpx; padding: 24rpx; }.progress-card__head { display: flex; justify-content: space-between; gap: 20rpx; }.progress-card__head > text { max-width: 48%; color: #f45b0b; font-size: 19rpx; text-align: right; line-height: 1.5; }
.warning-copy,.exception-copy { margin-top: 20rpx; padding: 20rpx; border-radius: 14rpx; font-size: 21rpx; line-height: 1.6; }.warning-copy { color: #765014; background: #fff7e6; }.exception-copy { color: #922d23; background: #fff0ed; border: 1rpx solid #efc2bb; }.exception-copy strong,.exception-copy text { display: block; }.exception-copy button { margin-top: 14rpx; }
.follow-up-box { margin-top: 20rpx; padding: 20rpx; border: 1rpx solid #cbdbea; border-radius: 16rpx; background: #f4f8fc; }.follow-up-box__title { color: #173d7a; font-size: 23rpx; font-weight: 850; }.follow-up-box .message-input { background: #fff; }
.field-grid { margin-top: 20rpx; display: grid; grid-template-columns: repeat(2,1fr); gap: 16rpx; }.field > text { display: block; margin-bottom: 9rpx; color: #425875; font-size: 20rpx; font-weight: 800; }.field input,.picker-field,.field textarea { width: 100%; min-height: 82rpx; padding: 0 18rpx; background: #f8fafc; border: 1rpx solid #d7e1ec; border-radius: 13rpx; font-size: 24rpx; }.picker-field { display: flex; align-items: center; justify-content: space-between; }.field--note { margin-top: 16rpx; }.field textarea { min-height: 120rpx; padding-top: 17rpx; }
.review-actions { margin-top: 22rpx; display: flex; gap: 15rpx; }.review-actions button { flex: 1; }
.success-card { margin-top: 30rpx; padding: 54rpx 30rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }.success-icon { width: 92rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #178052; border-radius: 50%; font-size: 48rpx; font-weight: 900; }.success-card strong { margin-top: 22rpx; color: #154e39; font-size: 32rpx; }.success-card text { margin-top: 12rpx; color: #6b7e72; font-size: 22rpx; line-height: 1.7; }.success-card button { width: 100%; margin-top: 28rpx; }
