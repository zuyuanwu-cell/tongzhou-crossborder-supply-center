<view class="assistant-page {{recording ? 'is-recording' : ''}}">
  <view class="aurora aurora--a"></view><view class="aurora aurora--b"></view><view class="grid-noise"></view>
  <view class="assistant-header" style="padding-top: {{statusBarHeight}}px">
    <view class="back-button" bindtap="goBack">‹</view>
    <view class="assistant-id"><view class="assistant-orb">H<view></view></view><view><strong>同舟小助理</strong><text>{{busy ? '正在整理…' : recording ? '正在聆听…' : '在线 · 伙伴快捷汇报'}}</text></view></view>
    <view class="reset-button" bindtap="resetConversation">↻</view>
  </view>

  <scroll-view class="chat-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="chat-content">
      <view class="conversation-date">今天 · 安全会话</view>
      <view wx:for="{{messages}}" wx:key="index" class="message message--{{item.role}}">
        <view wx:if="{{item.role === 'assistant'}}" class="mini-orb">H</view>
        <view class="message-body">
          <image wx:if="{{item.imageUrl}}" class="message-photo" src="{{item.imageUrl}}" mode="aspectFill" data-src="{{item.imageUrl}}" bindtap="previewPhoto" />
          <text>{{item.text}}</text>
        </view>
      </view>

      <view wx:if="{{loading || busy}}" class="message message--assistant"><view class="mini-orb">H</view><view class="thinking-card"><view class="thinking-halo"></view><view class="thinking-dots"><i></i><i></i><i></i></view><text>{{loading ? '正在建立安全会话' : '正在识别订单与业务字段'}}</text></view></view>
      <view wx:if="{{error}}" class="inline-error"><strong>没有处理成功</strong><text>{{error}}</text><button bindtap="openManualForm">使用原表单</button></view>
      <view wx:if="{{versionConflict}}" class="inline-warning"><view><strong>订单刚刚有更新</strong><text>已填写内容会保留，请重新确认最新状态。</text></view><button bindtap="reconfirmOrder">重新确认</button></view>

      <view wx:if="{{candidates.length && session.state === 'confirming_order'}}" class="assistant-block rise-block">
        <view class="block-label"><text>MATCHED ORDERS</text><strong>请选择正确订单</strong><small>{{candidates.length}} 个候选</small></view>
        <view wx:for="{{candidates}}" wx:key="id" class="order-card">
          <image src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="order-card__main"><strong>{{item.productName || item.title}}</strong><text>{{item.sku || '暂无 SKU'}} · {{item.orderNo || item.referenceNo}}</text><text>数量 {{item.quantity}} {{item.unit}} · 交期 {{item.dueDate || '未设置'}}</text></view>
          <button data-id="{{item.id}}" bindtap="confirmOrder">确认</button>
        </view>
      </view>

      <view wx:if="{{confirmedOrder}}" class="assistant-block rise-block">
        <view class="draft-card">
          <view class="draft-head"><view><text>产 · 加工单</text><strong>{{submitted ? '生产里程碑 · 已提交' : '生产里程碑 · 草稿'}}</strong></view><view class="draft-state">{{submitted ? '已完成' : '待确认'}}</view></view>
          <view class="product-strip"><image src="{{confirmedOrder.imageUrl}}" mode="aspectFill"/><view><strong>{{confirmedOrder.productName || confirmedOrder.title}}</strong><text>{{confirmedOrder.orderNo || confirmedOrder.referenceNo}} · {{confirmedOrder.quantity || 0}}{{confirmedOrder.unit || '件'}} · 期望{{confirmedOrder.dueDate || '—'}}</text></view></view>

          <view wx:if="{{processSteps.length}}" class="process-list">
            <view wx:for="{{processSteps}}" wx:key="key" class="process-row {{item.done ? 'is-done' : item.current ? 'is-current' : ''}}">
              <view class="process-node">{{item.done ? '✓' : index + 1}}</view><view class="process-copy"><strong>{{item.label}}</strong></view><text>{{item.status}}</text>
            </view>
          </view>

          <view class="draft-fields"><view><text>产前样日期</text><strong>{{form.preproductionSampleDate || (form.preproductionSampleStatus === 'not_required' ? '无需产前样' : '待补充')}}</strong></view><view><text>正式投产日期</text><strong>{{form.productionStartDate || '待补充'}}</strong></view><view><text>预计交货日期</text><strong>{{form.expectedDeliveryDate || '待补充'}}</strong></view><view><text>辅助完成数量</text><strong>{{form.completedQuantity || 0}} {{confirmedOrder.unit || '件'}}</strong></view></view>

          <view wx:if="{{session.state === 'collecting_progress' && !exceptionSuggested}}" class="question-callout"><view>H</view><text>{{session.nextQuestion || '还需要补充一项信息'}}</text></view>
          <view wx:if="{{exceptionSuggested}}" class="exception-callout"><strong>检测到异常情况</strong><text>停产、缺料或质量问题应按异常上报，不会写成普通进度。</text><button bindtap="openManualForm">转为异常上报</button></view>

          <view wx:if="{{editMode}}" class="edit-panel">
            <view class="edit-field"><text>物料与包材</text><picker range="{{materialStatusOptions}}" range-key="label" value="{{materialStatusIndex}}" data-field="materialStatus" data-options="materialStatusOptions" data-index-key="materialStatusIndex" bindchange="chooseMilestoneStatus"><view>{{materialStatusOptions[materialStatusIndex].label}}⌄</view></picker></view>
            <view class="edit-field"><text>产前样状态</text><picker range="{{sampleStatusOptions}}" range-key="label" value="{{sampleStatusIndex}}" data-field="preproductionSampleStatus" data-options="sampleStatusOptions" data-index-key="sampleStatusIndex" bindchange="chooseMilestoneStatus"><view>{{sampleStatusOptions[sampleStatusIndex].label}}⌄</view></picker></view>
            <view wx:if="{{form.preproductionSampleStatus === 'scheduled' || form.preproductionSampleStatus === 'submitted' || form.preproductionSampleStatus === 'approved'}}" class="edit-field"><text>产前样计划/实际日期</text><picker mode="date" value="{{form.preproductionSampleDate}}" data-field="preproductionSampleDate" bindchange="updateField"><view>{{form.preproductionSampleDate || '选择日期'}}⌄</view></picker></view>
            <view class="edit-field"><text>正式投产状态</text><picker range="{{productionStatusOptions}}" range-key="label" value="{{productionStatusIndex}}" data-field="productionStatus" data-options="productionStatusOptions" data-index-key="productionStatusIndex" bindchange="chooseMilestoneStatus"><view>{{productionStatusOptions[productionStatusIndex].label}}⌄</view></picker></view>
            <view wx:if="{{form.productionStatus === 'scheduled' || form.productionStatus === 'started' || form.productionStatus === 'completed'}}" class="edit-field"><text>计划/实际投产日期</text><picker mode="date" value="{{form.productionStartDate}}" data-field="productionStartDate" bindchange="updateField"><view>{{form.productionStartDate || '选择日期'}}⌄</view></picker></view>
            <view class="edit-field"><text>预计交货日期</text><picker mode="date" value="{{form.expectedDeliveryDate}}" data-field="expectedDeliveryDate" bindchange="updateField"><view>{{form.expectedDeliveryDate || '选择日期'}}⌄</view></picker></view>
            <view class="edit-field"><text>辅助完成比例（可选）</text><input type="number" value="{{form.progressPercent}}" data-field="progressPercent" bindinput="updateField" placeholder="0-100"/></view>
            <view class="edit-field"><text>辅助完成数量（可选）</text><input type="digit" value="{{form.completedQuantity}}" data-field="completedQuantity" bindinput="updateField" placeholder="可选"/></view>
            <view class="edit-note"><textarea value="{{form.note}}" data-field="note" bindinput="updateField" auto-height placeholder="补充说明（可选）"/></view>
          </view>

          <view wx:if="{{!submitted}}" class="draft-actions"><button class="ghost-button" bindtap="toggleEdit">{{editMode ? '收起修改' : '修改'}}</button><button class="submit-button {{busy || exceptionSuggested ? 'is-disabled' : ''}}" bindtap="submit">确认提交</button></view>
          <view wx:else class="submitted-line"><view>✓</view><text>已进入协同时间线</text><button bindtap="openManualForm">查看订单</button></view>
        </view>
      </view>

      <view wx:if="{{pendingMedia && confirmedOrder}}" class="assistant-block rise-block">
        <view class="exception-card">
          <view class="exception-head"><view><text>异常上报</text><strong>{{confirmedOrder.orderNo || confirmedOrder.referenceNo}}</strong></view><image src="{{pendingMedia.tempFilePath}}" mode="aspectFill" bindtap="previewPhoto"/></view>
          <view class="option-label">影响数量</view><view class="option-row"><view wx:for="{{affectedOptions}}" wx:key="*this" class="option-chip {{photoException.affected === item ? 'is-active' : ''}}" data-field="affected" data-value="{{item}}" bindtap="chooseExceptionOption">{{item}}</view></view>
          <view class="option-label">是否影响交期</view><view class="option-row"><view wx:for="{{delayOptions}}" wx:key="*this" class="option-chip {{photoException.delay === item ? 'is-active' : ''}}" data-field="delay" data-value="{{item}}" bindtap="chooseExceptionOption">{{item}}</view></view>
          <view class="exception-summary"><view><text>异常类型</text><strong>现场图片异常</strong></view><view><text>交期影响</text><strong>{{photoException.delay || '待确认'}}</strong></view></view>
          <button class="exception-submit" bindtap="openExceptionForm">继续补充并通知采购</button>
        </view>
      </view>

      <view class="manual-entry" bindtap="openManualForm">找不到订单或小助理暂不可用？<text>使用原表单 ›</text></view>
      <view class="chat-spacer"></view>
    </view>
  </scroll-view>

  <view wx:if="{{recording}}" class="voice-overlay"><view class="voice-ring"><view>●</view></view><view class="wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></view><text>正在聆听，点击结束</text></view>
  <view class="chat-composer">
    <view class="composer-plus" bindtap="choosePhoto">＋</view>
    <input value="{{inputText}}" bindinput="updateInput" confirm-type="send" bindconfirm="sendText" placeholder="{{session.nextQuestion || '说说订单进展，或发张照片…'}}" />
    <view wx:if="{{inputText}}" class="send-control" bindtap="sendText">发送</view>
    <view wx:else class="voice-control {{recording ? 'is-active' : ''}}" bindtap="toggleRecording"><i></i>{{voiceBusy ? '转写' : recording ? '结束' : '语音'}}</view>
  </view>
  <tz-tab-bar active="index" theme="glass" />
</view>
