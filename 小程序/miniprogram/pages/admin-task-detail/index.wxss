@import "../../styles/admin.wxss";
.detail-page { padding-top: 20rpx; padding-bottom: 52rpx; }.detail-hero { padding: 28rpx; color: #fff; background: linear-gradient(145deg,#0b2c3b,#115b62); border-radius: 22rpx; box-shadow: 0 14rpx 30rpx rgba(10,63,73,.18); }.detail-hero__top { display: flex; align-items: center; justify-content: space-between; }.detail-type { color: #8be2d1; font-size: 19rpx; font-weight: 800; }.detail-title { margin-top: 26rpx; font-size: 34rpx; font-weight: 900; line-height: 1.45; }.detail-ref { margin-top: 11rpx; color: #aac8cb; font-size: 19rpx; }.detail-flags { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }.detail-flags text { padding: 8rpx 13rpx; color: #d5e7e8; background: rgba(255,255,255,.08); border: 1rpx solid rgba(255,255,255,.14); border-radius: 999rpx; font-size: 16rpx; }.detail-flags .is-danger { color: #ffd4ce; border-color: rgba(255,174,163,.35); }.detail-flags .is-urgent { color: #ffc39c; }
.readonly-note { margin-top: 18rpx; padding: 20rpx; display: flex; gap: 16rpx; background: #e5f3f0; border: 1rpx solid #c8e4de; border-radius: 16rpx; }.readonly-note > text { flex: 0 0 auto; height: 40rpx; padding: 0 12rpx; display: flex; align-items: center; color: #fff; background: #116f63; border-radius: 999rpx; font-size: 16rpx; font-weight: 800; }.readonly-note view { color: #426c6a; font-size: 19rpx; line-height: 1.55; }
.detail-section { padding: 24rpx; }.detail-description { color: #425e6c; font-size: 22rpx; line-height: 1.75; }.fact-grid { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.fact-grid view { min-height: 91rpx; padding: 15rpx; background: #f2f7f7; border-radius: 13rpx; }.fact-grid text,.fact-grid strong { display: block; }.fact-grid text { color: #7b8d94; font-size: 16rpx; }.fact-grid strong { margin-top: 8rpx; color: #244b59; font-size: 20rpx; word-break: break-all; }
.line-list,.record-list { padding-top: 0; padding-bottom: 0; }.line-row,.record-row { min-height: 101rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-top: 1rpx solid #e7edef; }.line-row:first-child,.record-row:first-child { border-top: 0; }.line-row > view,.record-row > view:first-child { min-width: 0; flex: 1; }.line-row strong,.line-row view text,.record-row strong,.record-row view text,.record-row small { display: block; }.line-row strong,.record-row strong { color: #244b59; font-size: 21rpx; }.line-row view text,.record-row view text { margin-top: 6rpx; color: #83939b; font-size: 16rpx; }.line-row > text,.record-row > view:last-child { color: #116f63; font-size: 18rpx; font-weight: 800; text-align: right; }.record-row small { margin-top: 6rpx; color: #94a2a8; font-size: 15rpx; font-weight: 400; }
.timeline { padding: 8rpx 24rpx; }.timeline-row { min-height: 123rpx; display: grid; grid-template-columns: 24rpx 1fr; gap: 15rpx; padding: 20rpx 0; border-top: 1rpx solid #e7edef; }.timeline-row:first-child { border-top: 0; }.timeline-dot { width: 13rpx; height: 13rpx; margin-top: 9rpx; background: #f45b0b; border: 3rpx solid #fff; border-radius: 50%; box-shadow: 0 0 0 3rpx #f45b0b; }.timeline-row strong,.timeline-row text,.timeline-row small { display: block; }.timeline-row strong { color: #214957; font-size: 20rpx; }.timeline-row text { margin-top: 7rpx; color: #5e7580; font-size: 19rpx; line-height: 1.55; }.timeline-row small { margin-top: 8rpx; color: #97a5aa; font-size: 15rpx; }.retry { width: 210rpx; min-height: 70rpx; margin: 20rpx auto 0; font-size: 21rpx; }
