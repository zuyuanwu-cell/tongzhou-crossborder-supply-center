.messages-page { padding-top: 20rpx; }
.message-head { min-height: 146rpx; padding-bottom: 28rpx; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 1rpx solid #dce4ee; }
.message-title { margin-top: 8rpx; color: #173d7a; font-size: 45rpx; font-weight: 900; }.message-sub { margin-top: 9rpx; color: #718096; font-size: 22rpx; }.read-all { padding: 17rpx 20rpx; color: #2451a4; background: #e8f1fa; border-radius: 12rpx; font-size: 21rpx; font-weight: 700; }
.message-legend { margin: 24rpx 0 18rpx; display: flex; gap: 28rpx; color: #718096; font-size: 19rpx; }.message-legend view { display: flex; align-items: center; gap: 8rpx; }.legend-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }.legend-dot--orange { background: #f45b0b; }.legend-dot--violet { background: #8171a6; }.legend-dot--green { background: #18734c; }
.message-card { position: relative; margin-bottom: 16rpx; padding: 25rpx 22rpx; display: grid; grid-template-columns: 72rpx 1fr 24rpx; align-items: center; gap: 18rpx; }.message-card--unread { background: #fffaf5; border-color: #f1d7c4; }
.message-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #f45b0b; border-radius: 20rpx; font-size: 27rpx; font-weight: 900; }.message-icon--violet { background: #8171a6; }.message-icon--green { background: #18734c; }
.message-body { min-width: 0; }.message-meta { display: flex; align-items: center; justify-content: space-between; color: #8b98a8; font-size: 18rpx; }.message-name { margin-top: 9rpx; color: #173d7a; font-size: 26rpx; font-weight: 800; }.message-copy { margin-top: 7rpx; color: #63738b; font-size: 21rpx; line-height: 1.5; }.message-arrow { color: #9aa8b9; font-size: 38rpx; }.unread-dot { position: absolute; left: 13rpx; top: 50%; width: 10rpx; height: 10rpx; margin-top: -5rpx; background: #f45b0b; border-radius: 50%; }.message-loading { height: 72rpx; }.retry-button { width: 220rpx; margin-top: 24rpx; }
