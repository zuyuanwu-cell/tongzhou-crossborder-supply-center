@import "../../styles/admin.wxss";
.button-small { width: 210rpx; margin: 22rpx auto 0; min-height: 70rpx; font-size: 21rpx; }
.admin-org-list .admin-link-row { border-top: 1rpx solid #e7edef; }.admin-org-list .admin-link-row:first-child { border-top: 0; }
.admin-business-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.admin-business-entry { min-height: 138rpx; padding: 21rpx; display: grid; grid-template-columns: 54rpx minmax(0, 1fr) auto; align-items: center; gap: 13rpx; }
.admin-business-entry:last-child:nth-child(odd) { grid-column: 1 / -1; }
.admin-business-entry__icon { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg, #116f63, #174c65); border-radius: 15rpx; font-size: 21rpx; font-weight: 900; }
.admin-business-entry__copy { min-width: 0; }
.admin-business-entry__copy strong,.admin-business-entry__copy text { display: block; }
.admin-business-entry__copy strong { color: #173d4d; font-size: 22rpx; line-height: 1.35; }
.admin-business-entry__copy text { margin-top: 7rpx; color: #7a8c94; font-size: 17rpx; line-height: 1.45; }
.admin-business-entry .admin-link-arrow { font-size: 28rpx; }
