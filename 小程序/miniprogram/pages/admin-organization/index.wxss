@import "../../styles/admin.wxss";
.organization-detail-page { padding-top: 20rpx; padding-bottom: 52rpx; }.org-detail-hero { min-height: 160rpx; padding: 26rpx; display: grid; grid-template-columns: 78rpx minmax(0,1fr) auto; align-items: center; gap: 18rpx; color: #fff; background: linear-gradient(145deg,#0a2b3b,#115b62); border-radius: 22rpx; }.org-detail-symbol { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; color: #116f63; background: #fff; border-radius: 20rpx; font-size: 29rpx; font-weight: 900; }.org-detail-hero view:nth-child(2) { min-width: 0; }.org-detail-hero view:nth-child(2) text,.org-detail-hero view:nth-child(2) strong,.org-detail-hero view:nth-child(2) small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.org-detail-hero view:nth-child(2) text { color: #8fceca; font-size: 17rpx; }.org-detail-hero view:nth-child(2) strong { margin-top: 7rpx; font-size: 29rpx; }.org-detail-hero view:nth-child(2) small { margin-top: 7rpx; color: #a8c7c9; font-size: 16rpx; }
.org-detail-metrics { margin-top: 17rpx; display: grid; grid-template-columns: repeat(3,1fr); overflow: hidden; background: #fff; border: 1rpx solid #d8e4e6; border-radius: 18rpx; }.org-detail-metrics view { min-height: 105rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-left: 1rpx solid #e5edef; }.org-detail-metrics view:first-child { border-left: 0; }.org-detail-metrics strong { color: #116f63; font: 900 31rpx/1 "DIN Alternate",monospace; }.org-detail-metrics text { margin-top: 9rpx; color: #748890; font-size: 16rpx; }
.readonly-note { margin-top: 18rpx; padding: 20rpx; display: flex; gap: 14rpx; background: #e5f3f0; border: 1rpx solid #c7e3de; border-radius: 16rpx; }.readonly-note > text { flex: 0 0 auto; height: 39rpx; padding: 0 12rpx; display: flex; align-items: center; color: #fff; background: #116f63; border-radius: 999rpx; font-size: 16rpx; font-weight: 800; }.readonly-note view { color: #4f6e72; font-size: 18rpx; line-height: 1.55; }
.member-list { overflow: hidden; padding: 0 22rpx; }.member-row { min-height: 119rpx; display: grid; grid-template-columns: 58rpx minmax(0,1fr) auto; align-items: center; gap: 15rpx; border-top: 1rpx solid #e7edef; }.member-row:first-child { border-top: 0; }.member-avatar { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #116f63; border-radius: 17rpx; font-size: 22rpx; font-weight: 900; }.member-avatar.is-invite { color: #935a15; background: #fff0d4; }.member-row > view:nth-child(2) { min-width: 0; }.member-row strong,.member-row view text,.member-row small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.member-row strong { color: #224958; font-size: 21rpx; }.member-row view text { margin-top: 6rpx; color: #73868e; font-size: 17rpx; }.member-row small { margin-top: 7rpx; color: #96a3a8; font-size: 15rpx; }.member-status { color: #7d8d94; font-size: 16rpx; }.member-status.is-active { color: #18704e; }.retry { width: 210rpx; min-height: 70rpx; margin: 20rpx auto 0; font-size: 21rpx; }
