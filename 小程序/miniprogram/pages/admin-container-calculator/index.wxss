@import "../../styles/admin.wxss";
.calculator-page { padding-top: 0; padding-bottom: 60rpx; }
.calculator-hero { margin: 0 -28rpx 22rpx; padding: 32rpx 34rpx 38rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; color: #fff; background: radial-gradient(circle at 92% 0,rgba(110,224,204,.24),transparent 270rpx),linear-gradient(145deg,#071d2d,#145866); }.calculator-hero text,.calculator-hero strong,.calculator-hero small { display: block; }.calculator-hero text { color: #79ddca; font-size: 16rpx; font-weight: 900; letter-spacing: 2rpx; }.calculator-hero strong { margin-top: 9rpx; font-size: 39rpx; }.calculator-hero small { margin-top: 9rpx; color: #b4cdd0; font-size: 18rpx; }.calculator-hero__badge { padding: 9rpx 13rpx; color: #0c584f; background: #dbf7ed; border-radius: 999rpx; font-size: 16rpx; font-weight: 900; white-space: nowrap; }
.calculator-section { margin-bottom: 16rpx; padding: 22rpx; }.calculator-section__head { margin-bottom: 17rpx; }.calculator-section__head > view { display: flex; align-items: center; gap: 10rpx; }.calculator-section__head > view text { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #0f7167; border-radius: 10rpx; font-size: 15rpx; font-weight: 900; }.calculator-section__head strong { color: #173e4d; font-size: 24rpx; }.calculator-section__head small { display: block; margin-top: 7rpx; color: #7c8d95; font-size: 17rpx; }
.calculator-picker { min-height: 82rpx; padding: 14rpx 17rpx; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; background: #f3f7f7; border: 1rpx solid #dce8e7; border-radius: 14rpx; }.calculator-picker + .calculator-picker { margin-top: 12rpx; }.calculator-picker > view { flex: 1; min-width: 0; }.calculator-picker text,.calculator-picker strong { display: block; }.calculator-picker > view text { color: #809198; font-size: 16rpx; }.calculator-picker strong { margin-top: 5rpx; color: #234957; font-size: 20rpx; line-height: 1.45; }.calculator-picker > text { color: #0f7167; font-size: 18rpx; font-weight: 900; }
.cargo-editor { margin-top: 15rpx; padding: 17rpx; background: #f7f9f9; border: 1rpx solid #dce7e7; border-radius: 15rpx; }.cargo-editor:first-of-type { margin-top: 0; }.cargo-editor__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 13rpx; }.cargo-editor__head strong { color: #24505d; font-size: 20rpx; }.cargo-editor__head text { color: #bf3b25; font-size: 17rpx; }.cargo-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10rpx; }.cargo-grid--wide { grid-template-columns: .82fr 1.18fr; margin-bottom: 10rpx; }.cargo-grid label { min-width: 0; }.cargo-grid label text { display: block; margin-bottom: 6rpx; color: #71848d; font-size: 15rpx; }.cargo-grid input { box-sizing: border-box; width: 100%; height: 66rpx; padding: 0 12rpx; color: #173e4d; background: #fff; border: 1rpx solid #d8e4e4; border-radius: 10rpx; font-size: 19rpx; }.add-cargo-button { margin-top: 16rpx; color: #0f7167; background: #eef7f5; border: 1rpx dashed #83b9b2; border-radius: 13rpx; font-size: 19rpx; font-weight: 800; }
.calculate-button { height: 92rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: linear-gradient(135deg,#f45b0b,#ef7a28); border: 0; border-radius: 17rpx; box-shadow: 0 12rpx 25rpx rgba(244,91,11,.2); font-size: 25rpx; font-weight: 900; }.calculate-button[disabled] { color: #dce7e5; background: #8aa19e; box-shadow: none; }.preview-notice { margin: 13rpx 4rpx 25rpx; display: flex; align-items: flex-start; gap: 10rpx; font-size: 16rpx; line-height: 1.55; }.preview-notice strong { flex: 0 0 auto; color: #0f7167; }.preview-notice text { color: #7a8e96; }
.result-title { margin: 25rpx 0 14rpx; }.result-title text,.result-title strong { display: block; }.result-title text { color: #f45b0b; font-size: 15rpx; font-weight: 900; letter-spacing: 2rpx; }.result-title strong { margin-top: 5rpx; color: #173e4d; font-size: 28rpx; }.strategy-scroll { width: calc(100% + 56rpx); margin-left: -28rpx; white-space: nowrap; }.strategy-row { display: inline-flex; gap: 12rpx; padding: 0 28rpx 8rpx; }.strategy-card { width: 230rpx; padding: 18rpx; color: #315561; background: #fff; border: 2rpx solid #dce6e7; border-radius: 15rpx; }.strategy-card strong,.strategy-card text,.strategy-card small { display: block; }.strategy-card strong { font-size: 21rpx; }.strategy-card text { margin-top: 7rpx; color: #0f7167; font-size: 18rpx; font-weight: 900; }.strategy-card small { margin-top: 6rpx; color: #7a8d94; font-size: 15rpx; }.strategy-card.is-active { color: #fff; background: #0d6f65; border-color: #0d6f65; }.strategy-card.is-active text,.strategy-card.is-active small { color: #c7eee8; }
.scene-card { margin-top: 12rpx; padding: 20rpx; overflow: hidden; }.scene-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; }.scene-head view:first-child text,.scene-head view:first-child strong { display: block; }.scene-head view:first-child text { color: #f45b0b; font-size: 14rpx; font-weight: 900; letter-spacing: 2rpx; }.scene-head view:first-child strong { margin-top: 5rpx; color: #173e4e; font-size: 22rpx; }.scene-tabs { display: flex; padding: 4rpx; background: #e9f0f1; border-radius: 10rpx; }.scene-tabs text { padding: 8rpx 11rpx; color: #647982; border-radius: 8rpx; font-size: 16rpx; }.scene-tabs text.is-active { color: #fff; background: #116f63; }.loading-scene { width: 100%; height: 480rpx; margin-top: 16rpx; border-radius: 14rpx; background: #071d2d; }.scene-note { margin-top: 12rpx; color: #789099; font-size: 16rpx; text-align: center; }.scene-legend { width: calc(100% + 40rpx); margin: 14rpx -20rpx 0; white-space: nowrap; }.scene-legend__row { display: inline-flex; gap: 10rpx; padding: 0 20rpx; }.scene-legend__row > view { min-width: 140rpx; padding: 10rpx 12rpx; display: flex; align-items: center; gap: 9rpx; background: #f3f7f7; border-radius: 11rpx; }.scene-legend__row > view > text { width: 20rpx; height: 42rpx; border-radius: 6rpx; }.scene-legend__row strong,.scene-legend__row small { display: block; }.scene-legend__row strong { color: #234957; font-size: 16rpx; }.scene-legend__row small { margin-top: 3rpx; color: #7a8c94; font-size: 14rpx; }
.result-metrics { margin-top: 14rpx; display: grid; grid-template-columns: repeat(2,1fr); gap: 11rpx; }.result-metrics > view { min-height: 98rpx; padding: 17rpx; background: #fff; border: 1rpx solid #dbe6e7; border-radius: 14rpx; }.result-metrics text,.result-metrics strong { display: block; }.result-metrics text { color: #758990; font-size: 16rpx; }.result-metrics strong { margin-top: 9rpx; color: #143f4e; font-size: 25rpx; font-weight: 900; }.warning-card { margin-top: 14rpx; padding: 20rpx; }.warning-card > strong { color: #173e4d; font-size: 22rpx; }.warning-card view text,.warning-card__safe { display: block; margin-top: 10rpx; color: #ad4e20; font-size: 18rpx; line-height: 1.65; }.warning-card__safe { color: #497268; }
