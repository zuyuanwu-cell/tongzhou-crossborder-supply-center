.admin-page { padding-top: 0; color: #173047; background: #f2f6f7; }
.admin-hero { position: relative; overflow: hidden; margin: 0 -28rpx; padding: 42rpx 34rpx 38rpx; color: #fff; background: radial-gradient(circle at 92% 0, rgba(87,220,193,.22), transparent 280rpx), linear-gradient(145deg, #071d2d, #103d50 62%, #145866); }
.admin-hero::after { content: ""; position: absolute; inset: 0; opacity: .11; background-image: linear-gradient(rgba(255,255,255,.12) 1rpx, transparent 1rpx), linear-gradient(90deg,rgba(255,255,255,.12) 1rpx,transparent 1rpx); background-size: 50rpx 50rpx; }
.admin-hero__top,.admin-hero__copy { position: relative; z-index: 1; }.admin-hero__top { display: flex; align-items: center; justify-content: space-between; }
.admin-brand { display: flex; align-items: center; gap: 16rpx; }.admin-brand__mark { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; color: #0f6f64; background: #fff; border-radius: 17rpx; font-size: 29rpx; font-weight: 900; }
.admin-brand strong,.admin-brand text { display: block; }.admin-brand strong { font-size: 26rpx; }.admin-brand text { margin-top: 4rpx; color: #98bdc1; font-size: 15rpx; letter-spacing: 2rpx; }
.admin-secure { padding: 10rpx 15rpx; color: #90e7d6; background: rgba(85,213,188,.1); border: 1rpx solid rgba(125,225,207,.22); border-radius: 999rpx; font-size: 17rpx; font-weight: 700; }
.admin-hero__copy { margin-top: 46rpx; }.admin-hero__eyebrow { color: #75d7c5; font-size: 18rpx; font-weight: 800; letter-spacing: 3rpx; }.admin-hero__title { margin-top: 12rpx; font-size: 43rpx; font-weight: 900; letter-spacing: -1rpx; }.admin-hero__subtitle { margin-top: 12rpx; color: #abc8ca; font-size: 21rpx; line-height: 1.65; }
.admin-section-head { margin: 34rpx 0 18rpx; display: flex; align-items: flex-end; justify-content: space-between; }.admin-section-head view text,.admin-section-head view strong { display: block; }.admin-section-head view text { color: #0f7a6a; font-size: 17rpx; font-weight: 800; letter-spacing: 2rpx; }.admin-section-head view strong { margin-top: 7rpx; color: #163c4d; font-size: 30rpx; }.admin-section-head > text { color: #587283; font-size: 19rpx; }
.admin-metrics { margin-top: -8rpx; position: relative; z-index: 2; display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; }
.admin-metric { position: relative; overflow: hidden; min-height: 154rpx; padding: 22rpx; background: #fff; border: 1rpx solid #d8e4e6; border-radius: 19rpx; box-shadow: 0 10rpx 28rpx rgba(8,54,65,.07); }.admin-metric::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 5rpx; background: #167b70; }.admin-metric--orange::after { background: #f45b0b; }.admin-metric--red::after { background: #b42318; }.admin-metric--blue::after { background: #2451a4; }
.admin-metric text,.admin-metric strong,.admin-metric small { display: block; }.admin-metric text { color: #647986; font-size: 20rpx; }.admin-metric strong { margin-top: 13rpx; color: #123a4b; font: 900 43rpx/1 "DIN Alternate", monospace; }.admin-metric small { margin-top: 11rpx; color: #8b9aa3; font-size: 16rpx; }
.admin-card { background: #fff; border: 1rpx solid #d8e4e6; border-radius: 20rpx; box-shadow: 0 10rpx 28rpx rgba(8,54,65,.055); }
.admin-task-list,.admin-approval-list,.admin-org-list { overflow: hidden; }
.admin-task-row { min-height: 142rpx; padding: 22rpx; display: grid; grid-template-columns: 10rpx minmax(0,1fr) auto; gap: 15rpx; align-items: center; border-top: 1rpx solid #e7edef; }.admin-task-row:first-child { border-top: 0; }.admin-task-row__bar { width: 9rpx; height: 70rpx; border-radius: 999rpx; background: #18786b; }.admin-task-row.is-urgent .admin-task-row__bar { background: #f45b0b; }.admin-task-row.is-overdue .admin-task-row__bar { background: #b42318; }
.admin-task-row__main { min-width: 0; }.admin-task-row__main strong,.admin-task-row__main text,.admin-task-row__main small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.admin-task-row__main strong { color: #173d4d; font-size: 23rpx; }.admin-task-row__main text { margin-top: 8rpx; color: #667b87; font-size: 18rpx; }.admin-task-row__main small { margin-top: 8rpx; color: #94a1a8; font-size: 16rpx; }
.admin-task-row__side { text-align: right; }.admin-task-row__side text,.admin-task-row__side small { display: block; }.admin-task-row__side text { color: #b42318; font-size: 17rpx; font-weight: 800; }.admin-task-row__side small { margin-top: 10rpx; color: #84939c; font-size: 16rpx; }
.admin-status { min-width: 92rpx; padding: 8rpx 12rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 999rpx; font-size: 17rpx; font-weight: 800; }.admin-status--green { color: #176849; background: #e4f4eb; }.admin-status--amber { color: #8c5a10; background: #fff1d4; }.admin-status--blue { color: #2451a4; background: #e8effb; }.admin-status--violet { color: #69568b; background: #f0eafa; }.admin-status--red { color: #a32b21; background: #fdeae8; }.admin-status--gray { color: #687987; background: #edf1f3; }
.admin-empty,.admin-error { padding: 52rpx 28rpx; color: #71848d; text-align: center; font-size: 21rpx; line-height: 1.6; }.admin-empty strong,.admin-error strong { display: block; margin-bottom: 10rpx; color: #244858; font-size: 27rpx; }.admin-error strong { color: #a2382e; }
.admin-link-row { min-height: 118rpx; padding: 20rpx 22rpx; display: flex; align-items: center; gap: 17rpx; }.admin-link-icon { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; color: #fff; background: #137467; border-radius: 17rpx; font-size: 23rpx; font-weight: 900; }.admin-link-copy { flex: 1; }.admin-link-copy strong,.admin-link-copy text { display: block; }.admin-link-copy strong { color: #183e4e; font-size: 24rpx; }.admin-link-copy text { margin-top: 7rpx; color: #768992; font-size: 18rpx; }.admin-link-arrow { color: #94a5ab; font-size: 34rpx; }
.admin-search { height: 84rpx; margin-top: 22rpx; padding: 0 20rpx; display: flex; align-items: center; gap: 12rpx; background: #fff; border: 1rpx solid #d8e4e6; border-radius: 17rpx; }.admin-search text { color: #18786b; font-size: 28rpx; }.admin-search input { flex: 1; min-width: 0; font-size: 23rpx; }
.admin-filter-scroll { width: calc(100% + 56rpx); margin: 19rpx -28rpx 22rpx; white-space: nowrap; }.admin-filter-row { display: inline-flex; gap: 11rpx; padding: 0 28rpx; }.admin-filter-chip { height: 59rpx; padding: 0 21rpx; display: inline-flex; align-items: center; color: #607682; background: #e5edef; border-radius: 999rpx; font-size: 20rpx; }.admin-filter-chip.is-active { color: #fff; background: #116f63; box-shadow: inset 0 -4rpx #70dec9; }
.admin-action-row { display: grid; grid-template-columns: 1fr 1.4fr; gap: 14rpx; margin-top: 18rpx; }.admin-action { min-height: 78rpx; border-radius: 14rpx; font-size: 22rpx; font-weight: 800; }.admin-action--reject { color: #aa3429; background: #fff; border: 1rpx solid #e7bdb8; }.admin-action--approve { color: #fff; background: #116f63; box-shadow: 0 9rpx 20rpx rgba(17,111,99,.18); }
.admin-loading { padding: 42rpx 20rpx; color: #6f838c; text-align: center; font-size: 21rpx; }
