/*
 * Hermes V2 layout fixes and dark-theme completion (imported before readability).
 * Dark-theme completion is for pages that were designed light and later wrapped by
 * hermes-v2-business.wxss. Without this, values such as order numbers, process
 * step names and timeline actors render dark blue on the dark glass cards.
 * Task-detail rules are generated from pages/task-detail/index.wxss: keep them
 * in sync when that file gains new light-theme colors.
 */

/* Fixed-height buttons: app.wxss sets line-height 1.2, which pins their text to the top edge. */
.profile-page .switch-button,
.profile-page .logout-button,
.admin-action,
.exception-submit { display: flex; align-items: center; justify-content: center; }

/* Login: the main action spans the card instead of the 184px default button width. */
.login-page .login-button { width: 100%; }

/* Task list: filter chips must not shrink and wrap inside the horizontal scroller. */
.tasks-page .type-filter,
.tasks-page .filter-chip { flex-shrink: 0; white-space: nowrap; }

/* Warehouse operation: the scan button had no style and fell back to the 184px default button. */
.operation-page .product-picker-row { align-items: stretch; }
.operation-page .scan-product { flex: 0 0 132rpx; width: auto; height: 82rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; color: #8feaff; background: rgba(92, 225, 255, .1); border: 1rpx solid rgba(92, 225, 255, .28); border-radius: 13rpx; font-size: 23rpx; font-weight: 700; line-height: 1; }
.operation-page .scan-product::after { border: 0; }
.operation-page .add-line { width: auto; margin: 0; padding: 0; font-size: 23rpx; line-height: 1; }
.operation-page .step-line > view { color: rgba(226, 235, 250, .7); }
.operation-page .step-line .is-active { color: #fff; }
.operation-page .step-line small { font-size: 21rpx; }

/* Floating glass tab bar is 123rpx tall at 35rpx from the bottom: keep docked bars and the last card clear of it. */
.assistant-page .chat-composer { bottom: calc(176rpx + env(safe-area-inset-bottom)); }
.inventory-page .safe-banner { background: rgba(255, 255, 255, .06); border-color: rgba(92, 225, 255, .22); color: #eef2ff; }
.inventory-page .safe-banner__title { color: #f3f6ff; }
.inventory-page .safe-banner__copy { color: rgba(214, 222, 255, .72); }

