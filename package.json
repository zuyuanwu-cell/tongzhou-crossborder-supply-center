{
  "name": "tongzhou-supply-chain-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:strict": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "api": "node server/server.js",
    "dev:all": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:movement-comparison": "node scripts/movement-comparison-test.mjs",
    "test:stockup-workflow": "node scripts/stockup-workflow-test.mjs",
    "test:wms-stockup-push": "node scripts/wms-stockup-push-test.mjs",
    "test:miaoshou": "node scripts/miaoshou-automation-test.mjs",
    "test:miaoshou-listing": "node scripts/miaoshou-listing-test.mjs",
    "test:miaoshou-listing-platform": "node scripts/miaoshou-listing-platform-test.mjs",
    "test:tongzhou-canvas-ai": "node scripts/tongzhou-canvas-ai-test.mjs",
    "test:miaoshou-performance": "node scripts/miaoshou-performance-test.mjs",
    "test:miaoshou-order-alias": "node scripts/miaoshou-order-alias-test.mjs",
    "test:miaoshou-order-alias-jobs": "node scripts/miaoshou-order-alias-jobs-test.mjs",
    "test:after-sales": "node scripts/after-sales-test.mjs",
    "test:agent": "node scripts/agent-index-test.mjs",
    "test:access-control": "node scripts/access-control-test.mjs",
    "test:performance-analytics": "node scripts/performance-analytics-test.mjs",
    "test:dashboard-summary": "node scripts/dashboard-summary-test.mjs",
    "test:order-cache-policy": "node scripts/order-cache-policy-test.mjs",
    "test:production-timeline": "node scripts/production-timeline-test.mjs",
    "test:production-materials": "node scripts/production-materials-test.mjs",
    "test:outsourcing-cache-policy": "node scripts/outsourcing-cache-policy-test.mjs",
    "test:movement-explainability": "node scripts/movement-explainability-test.mjs",
    "test:shop-directory": "node scripts/shop-directory-test.mjs",
    "test:exchange-rate-sync": "node scripts/exchange-rate-sync-test.mjs",
    "test:sync-scheduler": "node scripts/sync-scheduler-test.mjs",
    "check:local-performance": "node scripts/local-performance-check.mjs",
    "check:agent-coverage": "node scripts/check-agent-coverage.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.1",
    "typescript": "^5.7.2",
    "undici": "^5.28.4",
    "vite": "^4.5.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
