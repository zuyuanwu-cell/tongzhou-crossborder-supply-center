JIANYUN_API_KEY=
JIANYUN_API_HOST=https://api.jiandaoyun.com
# 简道云“同舟国内库存入库”私有插件专用令牌；建议使用 48 字节以上随机值。
JIANYUN_DOMESTIC_INVENTORY_PLUGIN_TOKEN=
JIANYUN_DOMESTIC_INVENTORY_OUTBOUND_PLUGIN_TOKEN=
INTERNAL_ACCESS_CODE=change-me-to-a-strong-internal-code
AUTH_SESSION_SECRET=
NODE_ENV=development
ALLOW_INSECURE_INTERNAL_ACCESS_CODE=false
API_PORT=8787
BACKGROUND_JOBS_ENABLED=true
CACHE_DIR=.cache
SKIP_ENV_FILE=false
# System backup files must stay outside CACHE_DIR and the public dist directory.
SYSTEM_BACKUP_DIR=.system-backup
SYSTEM_BACKUP_MAX_BYTES=4294967296
SYSTEM_BACKUP_QUIESCE_TIMEOUT_MS=7200000
# Keep disabled until the separately supervised restore agent has been verified.
ALLOW_SYSTEM_IMPORT=0
SYSTEM_BACKUP_PM2_APP=tongzhou-supply-api
SYSTEM_RESTORE_POLL_MS=3000
USER_ACCOUNT_STATUS_FIELD=
SYNC_SCHEDULER_HEARTBEAT_MS=15000
PRODUCTION_SYNC_INTERVAL_MS=300000
WAREHOUSE_INVENTORY_SYNC_INTERVAL_MS=900000
WAREHOUSE_ORDER_SYNC_INTERVAL_MS=900000
WAREHOUSE_ORDER_INCREMENTAL_DAYS=7
WAREHOUSE_STOCKUP_SYNC_INTERVAL_MS=900000
OZON_ORDER_SYNC_INTERVAL_MS=180000
OZON_INTEGRATION_DB_PATH=.cache/ozon-integration.sqlite
# 上线初期保持 false；完成单店真实测试后再启用自动调用 Ozon 发运接口。
OZON_AUTO_SHIP_ENABLED=false
# 生产环境必填，至少 16 位；用于 AES-256-GCM 加密 Ozon Api-Key。
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=
PRODUCT_SYNC_INTERVAL_MS=3600000
ASSET_SYNC_INTERVAL_MS=3600000
WAREHOUSE_INFO_SYNC_INTERVAL_MS=7200000
QUALIFICATION_SYNC_INTERVAL_MS=86400000
PERFORMANCE_MATERIALIZATION_INTERVAL_MS=1800000
ORDER_SYNC_TIMEOUT_MS=45000
ORDER_SYNC_CHUNK_DAYS=7
ORDER_SYNC_JOB_POLL_MS=5000
WAREHOUSE_TEST_TIMEOUT_MS=20000
WMS_REQUEST_TIMEOUT_MS=25000
WMS_ORDER_MAX_PAGES=200
INVENTORY_SNAPSHOT_TIMEZONE=Asia/Shanghai
MIAOSHOU_PERFORMANCE_TIMEZONE=Asia/Shanghai
MOVEMENT_HISTORY_TIMEZONE=Asia/Shanghai
MOVEMENT_HISTORY_DB_PATH=.cache/movement-history.sqlite
STOCKUP_COLLABORATION_DB_PATH=.cache/stockup-collaboration.sqlite
DOMESTIC_INVENTORY_DB_PATH=.cache/domestic-inventory.sqlite
PERFORMANCE_ANALYTICS_DB_PATH=.cache/performance-analytics.sqlite
PERFORMANCE_FX_AUTO_SYNC=true
PERFORMANCE_FX_SYNC_INTERVAL_MS=86400000
PERFORMANCE_FX_BACKFILL_DAYS=120
PERFORMANCE_FX_ENDPOINT=https://api.frankfurter.dev/v2/rates
PERFORMANCE_FX_CURRENCIES=
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=
MIAOSHOU_API_BASE_URL=https://openapi-erp.91miaoshou.com
MIAOSHOU_REQUEST_TIMEOUT_MS=25000
MIAOSHOU_TASK_DB_PATH=.cache/miaoshou-tasks.sqlite
JIANYUN_FILE_DOWNLOAD_TEMPLATE=
AI_CREDENTIAL_ENCRYPTION_KEY=

# Hermes 业务智能体。先保持关闭，完成镜像 digest、自有模型和影子巡检验证后分阶段开启。
HERMES_AGENT_ENABLED=false
HERMES_PATROL_ENABLED=false
HERMES_BASE_URL=http://hermes:8642
# Hermes Runs API Bearer key；至少 16 位，仅服务端保存。
HERMES_API_KEY=
# 独立伙伴轻量档案的 Runs API Key；必须与 HERMES_API_KEY 不同，至少 16 位。
HERMES_PARTNER_API_KEY=
# 默认使用同一 Hermes 私网监听器下的独立档案前缀。
HERMES_PARTNER_BASE_URL=http://hermes:8642/p/tongzhou-partner-progress
# Node 与 tongzhou-business 插件之间的 HMAC 密钥；建议至少 32 字节随机值。
HERMES_BRIDGE_SECRET=
# 协同服务到伙伴轻量档案接口的独立 HMAC 密钥；可留空复用 HERMES_BRIDGE_SECRET。
HERMES_PARTNER_BRIDGE_SECRET=
# Hermes 通过同舟后端代理调用 DeepSeek 官方 API，不需要 Nous OAuth；DeepSeek Key 在工作台由管理员配置。
HERMES_MODEL_PROVIDER=custom:tongzhou
HERMES_MODEL=deepseek-v4-pro
# Hermes 容器到同舟模型代理的独立 Bearer 密钥；至少 32 字节，不是 DeepSeek API Key。
HERMES_MODEL_PROXY_KEY=
# 伙伴轻量档案到模型代理的另一把独立密钥；至少 32 字节，且不得与上一项相同。
# 同舟后端据此强制 DeepSeek 低温度、JSON 模式、输出上限并禁用工具字段。
HERMES_PARTNER_MODEL_PROXY_KEY=
# 仅统计 tongzhou_* 业务工具；平台内部的 tool_describe 等调用不计入。允许范围 12-64。
HERMES_MAX_TOOL_CALLS=32
HERMES_DIGEST_TEAM_ID=
HERMES_INTEGRATION_DB_PATH=.cache/hermes-integration.sqlite
# 仅供 Hermes 容器使用；生产应指向 Docker 私网内的同舟 API 服务名。
TONGZHOU_BRIDGE_BASE_URL=http://tongzhou-api:8787

# 独立外部协同服务。生产环境必须使用独立 PostgreSQL 账号与数据库。
COLLABORATION_API_PORT=8790
COLLABORATION_DATABASE_URL=postgres://tongzhou_portal:local-portal-only@127.0.0.1:64321/tongzhou_collaboration
COLLABORATION_INTEGRATION_DATABASE_URL=postgres://tongzhou_integration:local-integration-only@127.0.0.1:64321/tongzhou_collaboration
COLLABORATION_PUBLIC_ORIGIN=http://localhost:5174
COLLABORATION_COOKIE_SECURE=false
COLLABORATION_SECRET_KEY=
COLLABORATION_INTERNAL_TOKEN=
COLLABORATION_STORAGE_DRIVER=local
COLLABORATION_STORAGE_DIR=.cache/collaboration-objects
COLLABORATION_CLAMSCAN_PATH=clamscan
COLLABORATION_DEV_TRUST_UPLOADS=true
COLLABORATION_S3_ENDPOINT=
COLLABORATION_S3_REGION=auto
COLLABORATION_S3_BUCKET=
COLLABORATION_S3_ACCESS_KEY_ID=
COLLABORATION_S3_SECRET_ACCESS_KEY=
COLLABORATION_WECOM_WEBHOOK=
COLLABORATION_SMTP_URL=
COLLABORATION_OEM_ENABLED=false
COLLABORATION_COMMAND_POLL_MS=10000
COLLABORATION_AUTO_MIGRATE=false
COLLABORATION_API_BASE_URL=http://127.0.0.1:8790
COLLABORATION_BRIDGE_DB_PATH=.cache/collaboration-bridge.sqlite
COLLABORATION_BRIDGE_POLL_MS=10000
COLLABORATION_BRIDGE_TIMEOUT_MS=15000

# 伙伴手机快捷汇报。数据库配置存在时优先于这些环境默认值。
COLLABORATION_PARTNER_AI_ENABLED=false
COLLABORATION_PARTNER_AI_TEXT_ENABLED=true
COLLABORATION_PARTNER_AI_VOICE_ENABLED=false
# 仅填写 PostgreSQL organizations.id，逗号分隔；也可在 Hermes 工作台“伙伴汇报”中配置。
COLLABORATION_PARTNER_AI_ORGANIZATION_IDS=
COLLABORATION_PARTNER_AI_USER_DAILY_LIMIT=30
COLLABORATION_PARTNER_AI_ORG_DAILY_LIMIT=120
# 协同服务访问同舟 Node 私网地址；生产应使用 Docker 私网服务名。
COLLABORATION_PARTNER_AI_BRIDGE_URL=http://tongzhou-api:8787
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh
