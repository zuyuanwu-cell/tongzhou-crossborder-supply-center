FROM node:20-bookworm-slim

ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates clamav \
    && rm -rf /var/lib/apt/lists/* /var/lib/clamav/* \
    && mkdir -p /var/lib/tongzhou-collaboration/objects \
    && chown -R node:node /var/lib/tongzhou-collaboration

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit

COPY collaboration ./collaboration

USER node
EXPOSE 8790

CMD ["node", "collaboration/api/server.js"]
